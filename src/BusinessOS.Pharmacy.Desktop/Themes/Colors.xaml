<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BrandPrimaryColor">#0B82F6</Color>
    <Color x:Key="BrandPrimaryDarkColor">#0B5FC6</Color>
    <Color x:Key="BrandPrimarySoftColor">#DBECFF</Color>
    <Color x:Key="SuccessColor">#059669</Color>
    <Color x:Key="SuccessSoftColor">#ECFDF5</Color>
    <Color x:Key="WarningColor">#D97706</Color>
    <Color x:Key="WarningSoftColor">#FFFBEB</Color>
    <Color x:Key="DangerColor">#DC2626</Color>
    <Color x:Key="DangerSoftColor">#FEF2F2</Color>
    <Color x:Key="InfoColor">#0B82F6</Color>
    <Color x:Key="InfoSoftColor">#EFF6FF</Color>
    <Color x:Key="AppBackgroundColor">#F5F8FC</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SidebarColor">#FFFFFF</Color>
    <Color x:Key="SurfaceMutedColor">#F3F7FB</Color>
    <Color x:Key="TextPrimaryColor">#0F172A</Color>
    <Color x:Key="TextSecondaryColor">#475569</Color>
    <Color x:Key="TextMutedColor">#64748B</Color>
    <Color x:Key="BorderColor">#E2E8F0</Color>
    <Color x:Key="BorderStrongColor">#CBD5E1</Color>
    <Color x:Key="HoverColor">#F1F5F9</Color>
    <Color x:Key="SelectedColor">#DCEEFF</Color>

    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{StaticResource BrandPrimaryColor}" />
    <SolidColorBrush x:Key="BrandPrimaryDarkBrush" Color="{StaticResource BrandPrimaryDarkColor}" />
    <SolidColorBrush x:Key="BrandPrimarySoftBrush" Color="{StaticResource BrandPrimarySoftColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoftColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoftColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
    <SolidColorBrush x:Key="InfoSoftBrush" Color="{StaticResource InfoSoftColor}" />
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="{StaticResource SurfaceMutedColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="SelectedBrush" Color="{StaticResource SelectedColor}" />

    <!-- Extended accent palette (dashboard KPI / quick actions / badges) -->
    <Color x:Key="PurpleColor">#7C3AED</Color>
    <Color x:Key="PurpleSoftColor">#F3ECFE</Color>
    <Color x:Key="PinkColor">#DB2777</Color>
    <Color x:Key="PinkSoftColor">#FCE7F3</Color>
    <Color x:Key="TealColor">#0D9488</Color>
    <Color x:Key="TealSoftColor">#E6FFFA</Color>
    <Color x:Key="IndigoColor">#4F46E5</Color>
    <Color x:Key="IndigoSoftColor">#EEF2FF</Color>

    <SolidColorBrush x:Key="PurpleBrush" Color="{StaticResource PurpleColor}" />
    <SolidColorBrush x:Key="PurpleSoftBrush" Color="{StaticResource PurpleSoftColor}" />
    <SolidColorBrush x:Key="PinkBrush" Color="{StaticResource PinkColor}" />
    <SolidColorBrush x:Key="PinkSoftBrush" Color="{StaticResource PinkSoftColor}" />
    <SolidColorBrush x:Key="TealBrush" Color="{StaticResource TealColor}" />
    <SolidColorBrush x:Key="TealSoftBrush" Color="{StaticResource TealSoftColor}" />
    <SolidColorBrush x:Key="IndigoBrush" Color="{StaticResource IndigoColor}" />
    <SolidColorBrush x:Key="IndigoSoftBrush" Color="{StaticResource IndigoSoftColor}" />

    <!-- Chrome & surface extras (overridden by the Glass theme) -->
    <SolidColorBrush x:Key="SurfaceStrongBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TopBarBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="GlassHighlightBrush" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="GlassBorderSoftBrush" Color="#D9E5F1" />

    <!-- Sidebar interaction states -->
    <SolidColorBrush x:Key="SidebarItemHoverBrush" Color="#F1F7FF" />
    <SolidColorBrush x:Key="SidebarItemPressedBrush" Color="#E5F1FF" />
    <SolidColorBrush x:Key="SidebarItemSelectedBrush" Color="#DDEEFF" />
    <SolidColorBrush x:Key="SidebarItemSelectedBorderBrush" Color="#BFDBFE" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="#0B5FC6" />

    <!-- POS accent (teal in Classic, brand blue in Glass) -->
    <Color x:Key="PosPrimaryColor">#0F766E</Color>
    <Color x:Key="PosPrimaryDarkColor">#115E59</Color>
    <Color x:Key="PosPrimarySoftColor">#ECFDF5</Color>
    <SolidColorBrush x:Key="PosPrimaryBrush" Color="{StaticResource PosPrimaryColor}" />
    <SolidColorBrush x:Key="PosPrimaryDarkBrush" Color="{StaticResource PosPrimaryDarkColor}" />
    <SolidColorBrush x:Key="PosPrimarySoftBrush" Color="{StaticResource PosPrimarySoftColor}" />

    <!-- Soft badge borders -->
    <Color x:Key="SuccessBorderSoftColor">#A7F3D0</Color>
    <Color x:Key="WarningBorderSoftColor">#FDE68A</Color>
    <Color x:Key="DangerBorderSoftColor">#FECACA</Color>
    <SolidColorBrush x:Key="SuccessBorderSoftBrush" Color="{StaticResource SuccessBorderSoftColor}" />
    <SolidColorBrush x:Key="WarningBorderSoftBrush" Color="{StaticResource WarningBorderSoftColor}" />
    <SolidColorBrush x:Key="DangerBorderSoftBrush" Color="{StaticResource DangerBorderSoftColor}" />

    <!-- Corner radii -->
    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="PanelCornerRadius">14</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="InputCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="SidebarItemCornerRadius">8</CornerRadius>
</ResourceDictionary>