<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="SurfaceCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <Style x:Key="CompactCard" TargetType="Border" BasedOn="{StaticResource SurfaceCard}">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <Style x:Key="MutedCard" TargetType="Border" BasedOn="{StaticResource SurfaceCard}">
        <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
    </Style>

    <Style x:Key="BadgeBase" TargetType="Border">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="SuccessBadge" TargetType="Border" BasedOn="{StaticResource BadgeBase}">
        <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
        <Setter Property="BorderBrush" Value="#A7F3D0" />
    </Style>

    <Style x:Key="WarningBadge" TargetType="Border" BasedOn="{StaticResource BadgeBase}">
        <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
        <Setter Property="BorderBrush" Value="#FDE68A" />
    </Style>

    <Style x:Key="DangerBadge" TargetType="Border" BasedOn="{StaticResource BadgeBase}">
        <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
        <Setter Property="BorderBrush" Value="#FECACA" />
    </Style>

    <Style x:Key="NeutralBadge" TargetType="Border" BasedOn="{StaticResource BadgeBase}">
        <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
</ResourceDictionary>