<UserControl x:Class="BusinessOS.Pharmacy.Desktop.Backup.BackupRestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="BackupPanel" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FCFFFFFF" Offset="0" />
                        <GradientStop Color="#F5FFFFFF" Offset=".58" />
                        <GradientStop Color="#EAF8FAFC" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#D9FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.10" RenderingBias="Performance" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BackupMetricCard" TargetType="Border">
            <Setter Property="Background" Value="#FAFCFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="13,11" />
        </Style>

        <Style x:Key="BackupTableHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="FontSize" Value="11.4" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Height" Value="42" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <Style x:Key="BackupTableCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="FontSize" Value="11.9" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style x:Key="BackupTableRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="43" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E8EEF4" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1"><Setter Property="Background" Value="#FBFCFE" /></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F3FAF8" /></Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E9FBF7" />
                    <Setter Property="Foreground" Value="#115E59" />
                    <Setter Property="BorderBrush" Value="#99E7D9" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BackupTable" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="AlternationCount" Value="2" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="CellStyle" Value="{StaticResource BackupTableCell}" />
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource BackupTableHeader}" />
            <Setter Property="RowStyle" Value="{StaticResource BackupTableRow}" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource PageBackgroundBrush}">
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="DATA PROTECTION" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrandPrimaryBrush}" />
                    <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,0" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Height="38" Padding="14,7" Margin="0,0,8,0" />
                    <Button Content="Create backup" Command="{Binding CreateBackupCommand}" Style="{StaticResource PrimaryButton}" Height="38" Padding="15,7" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.6*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="0.8*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="14" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="11" Background="#FEF3C7">
                            <TextBlock Text="!" Foreground="#92400E" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Restore safety" Foreground="#92400E" FontSize="12.5" FontWeight="Bold" />
                            <TextBlock Text="{Binding WarningText}" Foreground="#B45309" FontSize="10.7" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource BackupMetricCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Available backups" Foreground="#64748B" FontSize="10.6" />
                            <TextBlock Text="{Binding Backups.Count}" Foreground="#0B5FC6" FontSize="22" FontWeight="Bold" Margin="0,3,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#DCEEFF" CornerRadius="10" Padding="9,5" VerticalAlignment="Center">
                            <TextBlock Text="LOCAL" Foreground="#0B5FC6" FontSize="9" FontWeight="Bold" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource BackupPanel}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="4,2,4,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Backup archive" Foreground="#0F172A" FontSize="14" FontWeight="Bold" />
                            <TextBlock Text="Verified restore points stored for this pharmacy installation." Foreground="#64748B" FontSize="10.6" Margin="0,3,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#ECFDF5" CornerRadius="9" Padding="9,4" VerticalAlignment="Center">
                            <TextBlock Text="Verified local copies" Foreground="#047857" FontSize="9.5" FontWeight="Bold" />
                        </Border>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Backups}"
                              SelectedItem="{Binding SelectedBackup}"
                              Style="{StaticResource BackupTable}"
                              MinHeight="260">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt}" Width="165" />
                            <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="105" />
                            <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="1.6*" MinWidth="220" />
                            <DataGridTextColumn Header="Size (bytes)" Binding="{Binding Length, StringFormat=N0}" Width="115" />
                            <DataGridTextColumn Header="Latest migration" Binding="{Binding LatestMigration}" Width="1.6*" MinWidth="220" />
                            <DataGridCheckBoxColumn Header="Verified" Binding="{Binding IsVerified}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource BackupPanel}" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="0.8*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Restore selected backup" Foreground="#0F172A" FontSize="14" FontWeight="Bold" />
                        <TextBlock Text="Type RESTORE to unlock the destructive restore action." Foreground="#64748B" FontSize="10.7" Margin="0,3,0,10" />
                        <TextBox Text="{Binding RestoreConfirmation, UpdateSourceTrigger=PropertyChanged}" Width="240" Height="38" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#64748B" FontSize="10.8" TextWrapping="Wrap" Margin="0,9,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Selected file" Foreground="#64748B" FontSize="10.3" />
                                <TextBlock Text="{Binding SelectedBackup.FileName, TargetNullValue='No backup selected'}" Foreground="#0F172A" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Verify selected" Command="{Binding VerifyCommand}" Style="{StaticResource SecondaryButton}" Height="38" Padding="13,7" Margin="0,0,8,0" />
                            <Button Content="Restore selected" Command="{Binding RestoreCommand}" Style="{StaticResource DangerButton}" Height="38" Padding="13,7" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,26,0"
                Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="10,6"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <ProgressBar Width="62" Height="5" IsIndeterminate="True" Foreground="{DynamicResource BrandPrimaryBrush}" />
                <TextBlock Text="Working…" Foreground="#64748B" FontSize="10.5" FontWeight="SemiBold" Margin="8,0,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>