<UserControl x:Class="BusinessOS.Pharmacy.Desktop.Authentication.PasswordChangeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="SecurityPanel" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FCFFFFFF" Offset="0" />
                        <GradientStop Color="#F5FFFFFF" Offset=".58" />
                        <GradientStop Color="#EAF8FAFC" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#D9FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.10" RenderingBias="Performance" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecurityFieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource PageBackgroundBrush}">
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="SECURITY" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrandPrimaryBrush}" />
                <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,0" />
                <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="0.75*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource SecurityPanel}" MaxWidth="640" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="38" Height="38" CornerRadius="12" Background="#DCEEFF">
                                <TextBlock Text="••" Foreground="#0B5FC6" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Update local offline credential" Foreground="#0F172A" FontSize="14" FontWeight="Bold" />
                                <TextBlock Text="This changes the secure offline sign-in credential stored for this workstation." Foreground="#64748B" FontSize="10.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding CurrentPasswordLabel}" Style="{StaticResource SecurityFieldLabel}" />
                        <PasswordBox x:Name="CurrentPasswordInput"
                                     MinHeight="40"
                                     Padding="10,8"
                                     FontSize="13"
                                     PasswordChanged="OnCurrentPasswordChanged" />

                        <TextBlock Text="{Binding NewPasswordLabel}" Style="{StaticResource SecurityFieldLabel}" Margin="0,14,0,5" />
                        <PasswordBox x:Name="NewPasswordInput"
                                     MinHeight="40"
                                     Padding="10,8"
                                     FontSize="13"
                                     PasswordChanged="OnNewPasswordChanged" />

                        <TextBlock Text="{Binding ConfirmPasswordLabel}" Style="{StaticResource SecurityFieldLabel}" Margin="0,14,0,5" />
                        <PasswordBox x:Name="ConfirmPasswordInput"
                                     MinHeight="40"
                                     Padding="10,8"
                                     FontSize="13"
                                     PasswordChanged="OnConfirmPasswordChanged" />

                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="11" Padding="11" Margin="0,14,0,0">
                            <TextBlock Text="{Binding RequirementsText}" Foreground="#64748B" FontSize="10.6" TextWrapping="Wrap" />
                        </Border>

                        <Button Content="{Binding ChangePasswordButtonText}"
                                Command="{Binding ChangePasswordCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Height="40"
                                Margin="0,16,0,0"
                                Padding="18,8"
                                HorizontalAlignment="Left" />

                        <Border CornerRadius="10" Padding="10,8" Margin="0,13,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#ECFDF5" />
                                    <Setter Property="BorderBrush" Value="#D1FAE5" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                            <Setter Property="Background" Value="#FEF2F2" />
                                            <Setter Property="BorderBrush" Value="#FECACA" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="10.8" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#047857" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                <Setter Property="Foreground" Value="#B91C1C" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                            <ProgressBar Width="72" Height="5" IsIndeterminate="True" Foreground="{DynamicResource BrandPrimaryBrush}" Background="#E2E8F0" VerticalAlignment="Center" />
                            <TextBlock Text="Updating…" Foreground="#64748B" FontSize="10.4" FontWeight="SemiBold" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource SecurityPanel}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Password safety" Foreground="#0F172A" FontSize="14" FontWeight="Bold" />
                        <TextBlock Text="A few safeguards are enforced before the password can be updated." Foreground="#64748B" FontSize="10.6" TextWrapping="Wrap" Margin="0,3,0,14" />

                        <Border Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1" CornerRadius="11" Padding="11" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Current password verification" Foreground="#1D4ED8" FontSize="10.8" FontWeight="Bold" />
                                <TextBlock Text="The existing credential must be verified before a new local password is stored." Foreground="#475569" FontSize="10.2" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="#ECFDF5" BorderBrush="#D1FAE5" BorderThickness="1" CornerRadius="11" Padding="11" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Offline credential protection" Foreground="#047857" FontSize="10.8" FontWeight="Bold" />
                                <TextBlock Text="Darmaltoon stores a derived secure verifier rather than the plain password." Foreground="#475569" FontSize="10.2" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="11" Padding="11">
                            <StackPanel>
                                <TextBlock Text="Online account" Foreground="#92400E" FontSize="10.8" FontWeight="Bold" />
                                <TextBlock Text="The cloud account password remains managed through Darmaltoon online services." Foreground="#475569" FontSize="10.2" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>