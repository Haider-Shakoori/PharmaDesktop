<UserControl x:Class="BusinessOS.Pharmacy.Desktop.Authentication.PasswordChangeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BusinessOS.Pharmacy.Desktop.Controls">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0"
                             Eyebrow="Security"
                             Title="{Binding Title}"
                             Description="{Binding Subtitle}"/>

        <Border Grid.Row="1"
                Style="{StaticResource SurfaceCard}"
                MaxWidth="560"
                Padding="24"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="{Binding CurrentPasswordLabel}" FontWeight="SemiBold" />
                <PasswordBox x:Name="CurrentPasswordInput"
                             MinHeight="42"
                             Padding="10,8"
                             FontSize="14"
                             Margin="0,6,0,0"
                             PasswordChanged="OnCurrentPasswordChanged" />

                <TextBlock Text="{Binding NewPasswordLabel}" FontWeight="SemiBold" Margin="0,16,0,0" />
                <PasswordBox x:Name="NewPasswordInput"
                             MinHeight="42"
                             Padding="10,8"
                             FontSize="14"
                             Margin="0,6,0,0"
                             PasswordChanged="OnNewPasswordChanged" />

                <TextBlock Text="{Binding ConfirmPasswordLabel}" FontWeight="SemiBold" Margin="0,16,0,0" />
                <PasswordBox x:Name="ConfirmPasswordInput"
                             MinHeight="42"
                             Padding="10,8"
                             FontSize="14"
                             Margin="0,6,0,0"
                             PasswordChanged="OnConfirmPasswordChanged" />

                <TextBlock Text="{Binding RequirementsText}"
                           Style="{StaticResource MutedText}"
                           Margin="0,12,0,0"
                           TextWrapping="Wrap" />

                <Button Content="{Binding ChangePasswordButtonText}"
                        Command="{Binding ChangePasswordCommand}"
                        Style="{StaticResource PrimaryButton}"
                        MinHeight="42"
                        Margin="0,18,0,0"
                        HorizontalAlignment="Left"
                        Padding="22,8" />

                <TextBlock Text="{Binding StatusMessage}"
                           Margin="0,14,0,0"
                           TextWrapping="Wrap"
                           FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
