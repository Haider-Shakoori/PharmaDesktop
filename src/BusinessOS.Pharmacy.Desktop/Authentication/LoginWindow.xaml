<Window x:Class="BusinessOS.Pharmacy.Desktop.Authentication.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in — BusinessOS Pharmacy"
        Width="560" Height="570"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="40">
        <Border Style="{StaticResource SurfaceCard}" Padding="30">
            <StackPanel>
                <TextBlock Text="BusinessOS Pharmacy" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="BusinessOS.af" Style="{StaticResource MutedText}" Margin="0,4,0,26" />

                <TextBlock Text="Pharmacy Staff Sign In" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Your license identifies the pharmacy. Sign in with your tenant-level employee account."
                           Style="{StaticResource MutedText}" Margin="0,6,0,20" TextWrapping="Wrap" />

                <TextBlock Text="Email" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         MinHeight="42" Padding="10,8" FontSize="14" />

                <TextBlock Text="Password" FontWeight="SemiBold" Margin="0,14,0,6" />
                <PasswordBox x:Name="PasswordInput"
                             MinHeight="42" Padding="10,8" FontSize="14" />

                <CheckBox Content="Allow secure offline sign-in on this PC"
                          IsChecked="{Binding AllowOfflineSignIn}"
                          Margin="0,14,0,0" />

                <Button Content="Sign In"
                        Click="OnSignInClick"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,18,0,0"
                        MinHeight="42"
                        IsDefault="True" />

                <TextBlock Text="{Binding StatusMessage}"
                           TextWrapping="Wrap"
                           Margin="0,14,0,0"
                           Foreground="{DynamicResource TextMutedBrush}" />

                <TextBlock Margin="0,18,0,0"
                           Style="{StaticResource MutedText}"
                           TextWrapping="Wrap"
                           Text="Offline sign-in stores no plaintext password. A PBKDF2 verifier and the signed user session are protected by Windows DPAPI and remain bounded by the license offline period." />
            </StackPanel>
        </Border>
    </Grid>
</Window>
