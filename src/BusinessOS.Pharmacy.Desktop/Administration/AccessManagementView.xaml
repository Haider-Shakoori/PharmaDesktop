<UserControl x:Class="BusinessOS.Pharmacy.Desktop.Administration.AccessManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BusinessOS.Pharmacy.Desktop.Controls">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0"
                             Eyebrow="Access control"
                             Title="{Binding Title}"
                             Description="{Binding Subtitle}">
            <controls:PageHeader.Actions>
                <Button Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource PrimaryButton}"/>
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <Grid Grid.Row="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsUsersMode}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="0.9*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SurfaceCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right"
                                Content="+ New user"
                                Command="{Binding NewUserCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="12,7"/>
                        <StackPanel>
                            <TextBlock Text="Pharmacy users" Style="{StaticResource SectionTitleText}"/>
                            <TextBlock Text="Click a row to edit the account and its role assignments."
                                       Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Users}"
                              SelectedItem="{Binding SelectedUser}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.3*"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="1.7*"/>
                            <DataGridTextColumn Header="Roles" Binding="{Binding Roles.Count}" Width="75"/>
                            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="75"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource SurfaceCard}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="User details" Style="{StaticResource SectionTitleText}"/>
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}"
                                   Margin="0,3,0,14" TextWrapping="Wrap"/>

                        <TextBlock Text="Name" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10"/>

                        <TextBlock Text="Email" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding UserEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10"/>

                        <TextBlock Text="Password" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding UserPassword, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,4"/>
                        <TextBlock Text="Leave blank when editing to keep the current password."
                                   Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,10"/>

                        <CheckBox Content="Active account"
                                  IsChecked="{Binding UserIsActive}"
                                  Margin="0,0,0,12"/>

                        <TextBlock Text="Assigned roles" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="10" Background="{DynamicResource SurfaceStrongBrush}">
                            <ItemsControl ItemsSource="{Binding UserRoles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected}"
                                                  Margin="0,3">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Code, Mode=OneWay, StringFormat='  ({0})'}"
                                                           Style="{StaticResource MutedText}"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <Button Content="{Binding SaveUserLabel}"
                                Command="{Binding SaveUserCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,14,0,0"
                                MinHeight="40"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRolesMode}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1.15*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SurfaceCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right"
                                Content="+ New role"
                                Command="{Binding NewRoleCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="12,7"/>
                        <StackPanel>
                            <TextBlock Text="Roles" Style="{StaticResource SectionTitleText}"/>
                            <TextBlock Text="Select a role to review or change its permissions."
                                       Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Roles}"
                              SelectedItem="{Binding SelectedRole}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Role" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="150"/>
                            <DataGridTextColumn Header="Users" Binding="{Binding UsersCount}" Width="70"/>
                            <DataGridCheckBoxColumn Header="System" Binding="{Binding IsSystem}" Width="75"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource SurfaceCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Role details" Style="{StaticResource SectionTitleText}"/>
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}"
                                   Margin="0,3,0,12" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Role name" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding RoleName, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Code" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding RoleCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Background="{DynamicResource SurfaceStrongBrush}"
                            Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding RolePermissions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected}" Margin="0,4">
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold">
                                                    <Run Text="{Binding Name, Mode=OneWay}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding Code, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Description, Mode=OneWay}"
                                                           Style="{StaticResource MutedText}"
                                                           FontSize="11"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <StackPanel Grid.Row="3">
                        <TextBlock Text="The Owner role always keeps all permissions."
                                   Style="{StaticResource MutedText}"
                                   Margin="0,10,0,8"/>
                        <Button Content="{Binding SaveRoleLabel}"
                                Command="{Binding SaveRoleCommand}"
                                Style="{StaticResource PrimaryButton}"
                                MinHeight="40"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
