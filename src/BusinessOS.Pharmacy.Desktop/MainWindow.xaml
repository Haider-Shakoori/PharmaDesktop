<Window x:Class="BusinessOS.Pharmacy.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:customers="clr-namespace:BusinessOS.Pharmacy.Desktop.Customers"
        xmlns:backup="clr-namespace:BusinessOS.Pharmacy.Desktop.Backup"
        xmlns:dashboard="clr-namespace:BusinessOS.Pharmacy.Desktop.Dashboard"
        xmlns:closing="clr-namespace:BusinessOS.Pharmacy.Desktop.DailyClosing"
        xmlns:medicines="clr-namespace:BusinessOS.Pharmacy.Desktop.Medicines"
        xmlns:inventory="clr-namespace:BusinessOS.Pharmacy.Desktop.Inventory"
        xmlns:expenses="clr-namespace:BusinessOS.Pharmacy.Desktop.Expenses"
        xmlns:purchasing="clr-namespace:BusinessOS.Pharmacy.Desktop.Purchasing"
        xmlns:pos="clr-namespace:BusinessOS.Pharmacy.Desktop.Pos"
        xmlns:returns="clr-namespace:BusinessOS.Pharmacy.Desktop.Returns"
        xmlns:reports="clr-namespace:BusinessOS.Pharmacy.Desktop.Reports"
        xmlns:networking="clr-namespace:BusinessOS.Pharmacy.Desktop.Networking"
        xmlns:updates="clr-namespace:BusinessOS.Pharmacy.Desktop.Updates"
        Title="Darmaltoon"
        Width="1500" Height="880"
        MinWidth="1180" MinHeight="720"
        Background="{DynamicResource AppBackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="F2" Command="{Binding NavigateCommand}" CommandParameter="pos" />
        <KeyBinding Key="F3" Command="{Binding NavigateCommand}" CommandParameter="purchases" />
        <KeyBinding Key="F4" Command="{Binding NavigateCommand}" CommandParameter="closing" />
        <KeyBinding Key="F5" Command="{Binding NavigateCommand}" CommandParameter="backup" />
        <KeyBinding Key="F6" Command="{Binding NavigateCommand}" CommandParameter="sync" />
        <KeyBinding Key="F7" Command="{Binding NavigateCommand}" CommandParameter="medicines" />
        <KeyBinding Key="F8" Command="{Binding NavigateCommand}" CommandParameter="inventory" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding GlobalSearchCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <DataTemplate DataType="{x:Type dashboard:DashboardViewModel}">
            <dashboard:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type pos:PosViewModel}">
            <pos:PosView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type returns:ReturnsViewModel}">
            <returns:ReturnsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type expenses:ExpensesViewModel}">
            <expenses:ExpensesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type closing:DailyClosingViewModel}">
            <closing:DailyClosingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type reports:ReportsViewModel}">
            <reports:ReportsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type backup:BackupRestoreViewModel}">
            <backup:BackupRestoreView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type networking:NetworkSettingsViewModel}">
            <networking:NetworkSettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type updates:UpdateViewModel}">
            <updates:UpdateView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type customers:CustomersViewModel}">
            <customers:CustomersView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type medicines:MedicinesViewModel}">
            <medicines:MedicinesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type inventory:InventoryViewModel}">
            <inventory:InventoryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type purchasing:PurchasingViewModel}">
            <purchasing:PurchasingView/>
        </DataTemplate>
    </Window.Resources>

    <Grid FlowDirection="{Binding LayoutDirection}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="14,18">
                <Grid DockPanel.Dock="Top" Margin="2,0,2,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="42"
                            CornerRadius="21"
                            Background="#0B6FF4"
                            VerticalAlignment="Top">
                        <TextBlock Text="✚"
                                   Foreground="White"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="{Binding ApplicationName}" Foreground="#0F172A" FontSize="17" FontWeight="Bold" />
                        <TextBlock Text="{Binding ProductName}" Foreground="#2563EB" FontSize="12" FontWeight="SemiBold" Margin="0,1,0,0" />
                        <TextBlock Text="Manage Today  •  Healthier Tomorrow" Foreground="#64748B" FontSize="9" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>

                <StackPanel DockPanel.Dock="Bottom" Margin="4,14,4,0">
                    <TextBlock Text="BusinessOS Pharmacy" Foreground="#0F172A" FontSize="10" FontWeight="SemiBold" />
                    <TextBlock Text="v1.0.0  |  Built for Afghanistan 🇦🇫" Foreground="#64748B" FontSize="9" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding ParentBrand}" Foreground="#2563EB" FontSize="9" Margin="0,2,0,0" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding NavigationItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SidebarNavigationButton}"
                                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding Key}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Glyph}" Foreground="#3B6FA8" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="#1E293B" FontSize="12.5" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="68" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="26,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="440"
                            Height="38"
                            Background="#F8FAFC"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="42" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="⌕"
                                       Foreground="#64748B"
                                       FontSize="18"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <Grid Grid.Column="1">
                                <TextBlock Text="Search medicines, customers, suppliers..."
                                           Foreground="#94A3B8"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding GlobalSearchText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox Text="{Binding GlobalSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="2,0"
                                         VerticalContentAlignment="Center"
                                         FontSize="11" />
                            </Grid>
                            <Button Grid.Column="2"
                                    Content="Go"
                                    Command="{Binding GlobalSearchCommand}"
                                    Margin="3"
                                    Padding="5,2"
                                    FontSize="10" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#F8FAFC"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="9,5"
                                Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="{Binding Dashboard.PharmacyName}"
                                           FontWeight="SemiBold"
                                           FontSize="10" />
                                <TextBlock Text="Afghanistan"
                                           Foreground="#64748B"
                                           FontSize="9" />
                            </StackPanel>
                        </Border>
                        <Button Command="{Binding NavigateCommand}"
                                CommandParameter="inventory"
                                Margin="0,0,8,0"
                                Padding="8,5"
                                ToolTip="Inventory alerts">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔔" Margin="0,0,4,0" />
                                <TextBlock Text="{Binding Dashboard.Alerts.Count}" FontSize="10" />
                            </StackPanel>
                        </Button>
                        <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UserDisplayName}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding UserRoleText}" Style="{StaticResource MutedText}" HorizontalAlignment="Right" />
                        </StackPanel>
                        <Border Background="#ECFDF5" CornerRadius="16" Padding="9,5" Margin="0,0,7,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="#16A34A" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding OnlineText}" Foreground="#047857" FontSize="10" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Background="#ECFDF5" CornerRadius="16" Padding="9,5" Margin="0,0,7,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◆" Foreground="#16A34A" FontSize="10" Margin="0,0,5,0" />
                                <TextBlock Text="{Binding LicenseText}" Foreground="#047857" FontSize="10" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource AppBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="9,5"
                                Margin="0,0,10,0">
                            <TextBlock Text="{Binding LanStatusText}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold" />
                        </Border>
                        <ComboBox Width="120" ItemsSource="{Binding Languages}"
                                  SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName" Margin="0,0,10,0" />
                        <Button Content="Sign Out" Command="{Binding LogoutCommand}" Padding="10,6" />
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
        </Grid>
    </Grid>
</Window>
