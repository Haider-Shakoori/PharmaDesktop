<Window x:Class="BusinessOS.Pharmacy.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BusinessOS Pharmacy"
        Width="1280" Height="760"
        MinWidth="980" MinHeight="620"
        Background="{DynamicResource AppBackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid FlowDirection="{Binding LayoutDirection}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
            <DockPanel Margin="18,20">
                <StackPanel DockPanel.Dock="Top" Margin="4,0,4,22">
                    <TextBlock Text="{Binding ApplicationName}" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ParentBrand}" Foreground="#94A3B8" FontSize="11" Margin="0,4,0,0" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding NavigationItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource SidebarNavigationButton}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Glyph}" Foreground="#93C5FD" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="#E2E8F0" FontSize="13" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="68" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="26,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding PageTitle}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UserDisplayName}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding UserRoleText}" Style="{StaticResource MutedText}" HorizontalAlignment="Right" />
                        </StackPanel>
                        <Border Background="#ECFDF5" CornerRadius="16" Padding="10,5" Margin="0,0,12,0">
                            <TextBlock Text="{Binding OnlineText}" Foreground="#047857" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                        <ComboBox Width="120" ItemsSource="{Binding Languages}"
                                  SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName" Margin="0,0,10,0" />
                        <Button Content="Sign Out" Command="{Binding LogoutCommand}" Padding="10,6" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="26">
                    <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="{Binding LastVerifiedText}" Style="{StaticResource MutedText}" Margin="0,5,0,20" />

                    <UniformGrid Columns="3" Margin="0,0,0,20">
                        <Border Style="{StaticResource SurfaceCard}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Signed-in User" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="{Binding UserDisplayName}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SurfaceCard}" Margin="5,0">
                            <StackPanel>
                                <TextBlock Text="Roles" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="{Binding UserRoleText}" Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SurfaceCard}" Margin="10,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Permissions" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="{Binding PermissionCount, StringFormat={}{0} granted}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Style="{StaticResource SurfaceCard}">
                        <StackPanel>
                            <TextBlock Text="Role-based workspace" Style="{StaticResource SectionTitleText}" />
                            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="Navigation is derived from the signed tenant role and permission snapshot. Operational application services use the same permission authorizer and remain fail-closed even when UI controls are hidden." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
