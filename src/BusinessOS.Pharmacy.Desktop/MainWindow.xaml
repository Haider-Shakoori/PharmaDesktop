<Window x:Class="BusinessOS.Pharmacy.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:customers="clr-namespace:BusinessOS.Pharmacy.Desktop.Customers"
        xmlns:backup="clr-namespace:BusinessOS.Pharmacy.Desktop.Backup"
        xmlns:dashboard="clr-namespace:BusinessOS.Pharmacy.Desktop.Dashboard"
        xmlns:closing="clr-namespace:BusinessOS.Pharmacy.Desktop.DailyClosing"
        xmlns:medicines="clr-namespace:BusinessOS.Pharmacy.Desktop.Medicines"
        xmlns:inventory="clr-namespace:BusinessOS.Pharmacy.Desktop.Inventory"
        xmlns:expenses="clr-namespace:BusinessOS.Pharmacy.Desktop.Expenses"
        xmlns:purchasing="clr-namespace:BusinessOS.Pharmacy.Desktop.Purchasing"
        xmlns:pos="clr-namespace:BusinessOS.Pharmacy.Desktop.Pos"
        xmlns:returns="clr-namespace:BusinessOS.Pharmacy.Desktop.Returns"
        xmlns:reports="clr-namespace:BusinessOS.Pharmacy.Desktop.Reports"
        xmlns:networking="clr-namespace:BusinessOS.Pharmacy.Desktop.Networking"
        xmlns:updates="clr-namespace:BusinessOS.Pharmacy.Desktop.Updates"
        Title="Darmaltoon"
        Width="1500" Height="900"
        MinWidth="1180" MinHeight="720"
        Background="{DynamicResource AppBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Window.InputBindings>
        <KeyBinding Key="F2" Command="{Binding NavigateCommand}" CommandParameter="pos" />
        <KeyBinding Key="F3" Command="{Binding NavigateCommand}" CommandParameter="purchases" />
        <KeyBinding Key="F4" Command="{Binding NavigateCommand}" CommandParameter="closing" />
        <KeyBinding Key="F5" Command="{Binding NavigateCommand}" CommandParameter="backup" />
        <KeyBinding Key="F6" Command="{Binding NavigateCommand}" CommandParameter="sync" />
        <KeyBinding Key="F7" Command="{Binding NavigateCommand}" CommandParameter="medicines" />
        <KeyBinding Key="F8" Command="{Binding NavigateCommand}" CommandParameter="inventory" />
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding GlobalSearchCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding GlobalSearchCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <CollectionViewSource x:Key="GroupedNavigation" Source="{Binding NavigationItems}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <DataTemplate DataType="{x:Type dashboard:DashboardViewModel}">
            <dashboard:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type pos:PosViewModel}">
            <pos:PosView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type returns:ReturnsViewModel}">
            <returns:ReturnsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type expenses:ExpensesViewModel}">
            <expenses:ExpensesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type closing:DailyClosingViewModel}">
            <closing:DailyClosingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type reports:ReportsViewModel}">
            <reports:ReportsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type backup:BackupRestoreViewModel}">
            <backup:BackupRestoreView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type networking:NetworkSettingsViewModel}">
            <networking:NetworkSettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type updates:UpdateViewModel}">
            <updates:UpdateView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type customers:CustomersViewModel}">
            <customers:CustomersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type medicines:MedicinesViewModel}">
            <medicines:MedicinesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type inventory:InventoryViewModel}">
            <inventory:InventoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type purchasing:PurchasingViewModel}">
            <purchasing:PurchasingView />
        </DataTemplate>
    </Window.Resources>

    <Grid FlowDirection="{Binding LayoutDirection}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding SidebarWidth}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="12,14,12,12">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="38" Height="38"
                                CornerRadius="10"
                                Background="{DynamicResource BrandPrimaryBrush}">
                            <Path Data="{StaticResource IconMedicines}"
                                  Width="21" Height="21"
                                  Stretch="Uniform"
                                  Stroke="White"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Fill="Transparent"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SidebarCollapsed}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{Binding ProductName}" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ParentBrand}" Style="{StaticResource CaptionText}" />
                        </StackPanel>
                    </Grid>

                    <Button Command="{Binding ToggleSidebarCommand}"
                            Style="{StaticResource GhostButton}"
                            Padding="8,6"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Right"
                            ToolTip="Collapse or expand navigation">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPanel}"
                                  Width="16" Height="16"
                                  Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.7"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Fill="Transparent" />
                            <TextBlock Text="Collapse" Margin="7,0,0,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SidebarCollapsed}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border DockPanel.Dock="Bottom"
                        Background="{DynamicResource SurfaceMutedBrush}"
                        CornerRadius="10"
                        Padding="10"
                        Margin="0,10,0,0">
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SidebarCollapsed}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Darmaltoon Desktop" FontWeight="SemiBold" FontSize="11.5" />
                        <TextBlock Text="Professional pharmacy operations" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Source={StaticResource GroupedNavigation}}">
                        <ItemsControl.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource NavigationGroupHeader}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.SidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ItemsControl.GroupStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SidebarNavigationButton}"
                                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding Key}"
                                        ToolTip="{Binding Label}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Path Style="{StaticResource NavigationIconPath}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Label}"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.SidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            MinWidth="240"
                            MaxWidth="390"
                            Height="38"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AppBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="9"
                            Margin="0,0,18,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path Data="{StaticResource IconSearch}"
                                  Width="17" Height="17"
                                  Stroke="{DynamicResource TextMutedBrush}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Fill="Transparent"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                            <Grid Grid.Column="1">
                                <TextBlock Text="Search medicines, customers, suppliers…"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding GlobalSearchText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox Text="{Binding GlobalSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SearchTextBox}"
                                         VerticalContentAlignment="Center"
                                         ToolTip="Ctrl+F" />
                            </Grid>
                            <Button Grid.Column="2"
                                    Command="{Binding GlobalSearchCommand}"
                                    Style="{StaticResource GhostButton}"
                                    Padding="8,5"
                                    Margin="2"
                                    ToolTip="Search">
                                <TextBlock Text="Ctrl+F" Style="{StaticResource CaptionText}" />
                            </Button>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource SuccessBadge}" Margin="0,0,7,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconWifi}"
                                      Width="14" Height="14"
                                      Stroke="{DynamicResource SuccessBrush}"
                                      StrokeThickness="1.8"
                                      Fill="Transparent"
                                      Stretch="Uniform"
                                      Margin="0,0,6,0" />
                                <TextBlock Text="{Binding OnlineText}" Foreground="{DynamicResource SuccessBrush}" FontSize="10.5" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SuccessBadge}" Margin="0,0,7,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconBadgeCheck}"
                                      Width="14" Height="14"
                                      Stroke="{DynamicResource SuccessBrush}"
                                      StrokeThickness="1.8"
                                      Fill="Transparent"
                                      Stretch="Uniform"
                                      Margin="0,0,6,0" />
                                <TextBlock Text="{Binding LicenseText}" Foreground="{DynamicResource SuccessBrush}" FontSize="10.5" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource NeutralBadge}" Margin="0,0,7,0">
                            <TextBlock Text="{Binding LanStatusText}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       MaxWidth="130"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>

                        <ComboBox Width="112"
                                  ItemsSource="{Binding Languages}"
                                  SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"
                                  Margin="0,0,7,0"
                                  ToolTip="Language" />

                        <Button Command="{Binding NavigateCommand}"
                                CommandParameter="inventory"
                                Style="{StaticResource IconButton}"
                                Margin="0,0,7,0"
                                ToolTip="Inventory alerts">
                            <Grid>
                                <Path Data="{StaticResource IconBell}"
                                      Width="17" Height="17"
                                      Stroke="{DynamicResource TextSecondaryBrush}"
                                      StrokeThickness="1.8"
                                      Fill="Transparent"
                                      Stretch="Uniform" />
                                <Border Background="{DynamicResource DangerBrush}"
                                        CornerRadius="7"
                                        MinWidth="14"
                                        Height="14"
                                        Padding="3,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="12,-5,-7,0">
                                    <TextBlock Text="{Binding Dashboard.Alerts.Count}"
                                               Foreground="White"
                                               FontSize="8"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Button>

                        <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UserDisplayName}"
                                       FontWeight="SemiBold"
                                       FontSize="11.5"
                                       HorizontalAlignment="Right"
                                       MaxWidth="120"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding UserRoleText}"
                                       Style="{StaticResource CaptionText}"
                                       HorizontalAlignment="Right"
                                       MaxWidth="120"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Button Command="{Binding LogoutCommand}"
                                Style="{StaticResource IconButton}"
                                ToolTip="Sign out">
                            <Path Data="{StaticResource IconLogout}"
                                  Width="17" Height="17"
                                  Stroke="{DynamicResource TextSecondaryBrush}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Fill="Transparent"
                                  Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentPage}"
                            Background="{DynamicResource AppBackgroundBrush}" />
        </Grid>
    </Grid>
</Window>