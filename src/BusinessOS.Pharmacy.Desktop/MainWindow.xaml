<Window x:Class="BusinessOS.Pharmacy.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BusinessOS Pharmacy"
        Width="1100"
        Height="700"
        MinWidth="960"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="32">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="{Binding ApplicationName}"
                       FontSize="34"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Native Windows foundation"
                       FontSize="18"
                       Margin="0,8,0,24"
                       HorizontalAlignment="Center" />
            <Border Padding="20" CornerRadius="10" BorderThickness="1">
                <TextBlock Text="{Binding StatusText}"
                           FontSize="14"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </Grid>
</Window>
