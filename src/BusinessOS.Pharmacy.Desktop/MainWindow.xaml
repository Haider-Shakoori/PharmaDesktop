<Window x:Class="BusinessOS.Pharmacy.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Darmaltoon;component/Assets/Darmaltoon.ico"
        xmlns:customers="clr-namespace:BusinessOS.Pharmacy.Desktop.Customers"
        xmlns:backup="clr-namespace:BusinessOS.Pharmacy.Desktop.Backup"
        xmlns:dashboard="clr-namespace:BusinessOS.Pharmacy.Desktop.Dashboard"
        xmlns:closing="clr-namespace:BusinessOS.Pharmacy.Desktop.DailyClosing"
        xmlns:medicines="clr-namespace:BusinessOS.Pharmacy.Desktop.Medicines"
        xmlns:inventory="clr-namespace:BusinessOS.Pharmacy.Desktop.Inventory"
        xmlns:expenses="clr-namespace:BusinessOS.Pharmacy.Desktop.Expenses"
        xmlns:purchasing="clr-namespace:BusinessOS.Pharmacy.Desktop.Purchasing"
        xmlns:pos="clr-namespace:BusinessOS.Pharmacy.Desktop.Pos"
        xmlns:returns="clr-namespace:BusinessOS.Pharmacy.Desktop.Returns"
        xmlns:reports="clr-namespace:BusinessOS.Pharmacy.Desktop.Reports"
        xmlns:networking="clr-namespace:BusinessOS.Pharmacy.Desktop.Networking"
        xmlns:updates="clr-namespace:BusinessOS.Pharmacy.Desktop.Updates"
        xmlns:auth="clr-namespace:BusinessOS.Pharmacy.Desktop.Authentication"
        xmlns:barcode="clr-namespace:BusinessOS.Pharmacy.Desktop.Barcode"
        xmlns:localization="clr-namespace:BusinessOS.Pharmacy.Desktop.Localization"
        Title="BusinessOS Pharmacy - Darmaltoon Pharmacy"
        Width="1600" Height="920"
        MinWidth="1180" MinHeight="720"
        Background="{DynamicResource AppBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Window.InputBindings>
        <KeyBinding Key="F1" Command="{Binding NavigateCommand}" CommandParameter="dashboard" />
        <KeyBinding Key="F2" Command="{Binding NavigateCommand}" CommandParameter="pos" />
        <KeyBinding Key="F3" Command="{Binding NavigateCommand}" CommandParameter="purchases" />
        <KeyBinding Key="F4" Command="{Binding NavigateCommand}" CommandParameter="closing" />
        <KeyBinding Key="F5" Command="{Binding NavigateCommand}" CommandParameter="backup" />
        <KeyBinding Key="F6" Command="{Binding NavigateCommand}" CommandParameter="sync" />
        <KeyBinding Key="F7" Command="{Binding NavigateCommand}" CommandParameter="medicines" />
        <KeyBinding Key="F8" Command="{Binding NavigateCommand}" CommandParameter="inventory" />
        <KeyBinding Key="F9" Command="{Binding NavigateCommand}" CommandParameter="batches" />
        <KeyBinding Key="F10" Command="{Binding NavigateCommand}" CommandParameter="reports" />
        <KeyBinding Key="F11" Command="{Binding NavigateCommand}" CommandParameter="customers" />
        <KeyBinding Key="F12" Command="{Binding NavigateCommand}" CommandParameter="expenses" />
        <KeyBinding Key="D1" Modifiers="Alt" Command="{Binding NavigateCommand}" CommandParameter="suppliers" />
        <KeyBinding Key="D2" Modifiers="Alt" Command="{Binding NavigateCommand}" CommandParameter="returns" />
        <KeyBinding Key="D3" Modifiers="Alt" Command="{Binding NavigateCommand}" CommandParameter="updates" />
        <KeyBinding Key="D4" Modifiers="Alt" Command="{Binding NavigateCommand}" CommandParameter="network" />
        <KeyBinding Key="D5" Modifiers="Alt" Command="{Binding NavigateCommand}" CommandParameter="settings" />
        <KeyBinding Key="D6" Modifiers="Alt" Command="{Binding NavigateCommand}" CommandParameter="password" />
        <KeyBinding Key="D7" Modifiers="Alt" Command="{Binding NavigateCommand}" CommandParameter="barcode" />
        <KeyBinding Key="F11" Command="{Binding ToggleFullScreenCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <Style x:Key="SidebarNavIconPath"
               TargetType="Path"
               BasedOn="{StaticResource NavigationIconPath}">
            <Setter Property="Width" Value="21" />
            <Setter Property="Height" Value="21" />
            <Setter Property="Stroke" Value="#496B91" />
            <Setter Property="StrokeThickness" Value="2" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Key}" Value="dashboard"><Setter Property="Stroke" Value="#0B82F6" /></DataTrigger>
                <DataTrigger Binding="{Binding Key}" Value="pos"><Setter Property="Stroke" Value="#169B62" /></DataTrigger>
                <DataTrigger Binding="{Binding Key}" Value="medicines"><Setter Property="Stroke" Value="#8752C7" /></DataTrigger>
                <DataTrigger Binding="{Binding Key}" Value="inventory"><Setter Property="Stroke" Value="#ED9619" /></DataTrigger>
                <DataTrigger Binding="{Binding Key}" Value="batches"><Setter Property="Stroke" Value="#E65779" /></DataTrigger>
                <DataTrigger Binding="{Binding Key}" Value="purchases"><Setter Property="Stroke" Value="#159FC1" /></DataTrigger>
                <DataTrigger Binding="{Binding Key}" Value="suppliers"><Setter Property="Stroke" Value="#6366B2" /></DataTrigger>
                <DataTrigger Binding="{Binding Key}" Value="customers"><Setter Property="Stroke" Value="#159D98" /></DataTrigger>
                <DataTrigger Binding="{Binding Key}" Value="expenses"><Setter Property="Stroke" Value="#DB5864" /></DataTrigger>
                <DataTrigger Binding="{Binding Key}" Value="closing"><Setter Property="Stroke" Value="#E78A27" /></DataTrigger>
                <DataTrigger Binding="{Binding Key}" Value="reports"><Setter Property="Stroke" Value="#237CC3" /></DataTrigger>
                <DataTrigger Binding="{Binding Key}" Value="returns"><Setter Property="Stroke" Value="#169FB8" /></DataTrigger>
                <DataTrigger Binding="{Binding Key}" Value="users"><Setter Property="Stroke" Value="#387BC4" /></DataTrigger>
                <DataTrigger Binding="{Binding Key}" Value="roles"><Setter Property="Stroke" Value="#8752C7" /></DataTrigger>
                <DataTrigger Binding="{Binding Key}" Value="backup"><Setter Property="Stroke" Value="#6564B5" /></DataTrigger>
                <DataTrigger Binding="{Binding Key}" Value="sync"><Setter Property="Stroke" Value="#159D98" /></DataTrigger>
                <DataTrigger Binding="{Binding Key}" Value="updates"><Setter Property="Stroke" Value="#159D98" /></DataTrigger>
                <DataTrigger Binding="{Binding Key}" Value="network"><Setter Property="Stroke" Value="#2297B7" /></DataTrigger>
                <DataTrigger Binding="{Binding Key}" Value="settings"><Setter Property="Stroke" Value="#60758D" /></DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Stroke" Value="#0B82F6" />
                    <Setter Property="StrokeThickness" Value="2.1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <CollectionViewSource x:Key="GroupedNavigation" Source="{Binding NavigationItems}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <DataTemplate DataType="{x:Type dashboard:DashboardViewModel}">
            <dashboard:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type pos:PosViewModel}">
            <pos:PosView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type returns:ReturnsViewModel}">
            <returns:ReturnsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type expenses:ExpensesViewModel}">
            <expenses:ExpensesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type closing:DailyClosingViewModel}">
            <closing:DailyClosingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type reports:ReportsViewModel}">
            <reports:ReportsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type backup:BackupRestoreViewModel}">
            <backup:BackupRestoreView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type networking:NetworkSettingsViewModel}">
            <networking:NetworkSettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type updates:UpdateViewModel}">
            <updates:UpdateView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type auth:PasswordChangeViewModel}">
            <auth:PasswordChangeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type barcode:BarcodePrintViewModel}">
            <barcode:BarcodePrintView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type customers:CustomersViewModel}">
            <customers:CustomersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type medicines:MedicinesViewModel}">
            <medicines:MedicinesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type inventory:InventoryViewModel}">
            <inventory:InventoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type purchasing:PurchasingViewModel}">
            <purchasing:PurchasingView />
        </DataTemplate>
    </Window.Resources>

    <Grid FlowDirection="{Binding LayoutDirection}" Background="{DynamicResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition>
                <ColumnDefinition.Style>
                    <Style TargetType="ColumnDefinition">
                        <Setter Property="Width" Value="296" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SidebarCollapsed}" Value="True">
                                <Setter Property="Width" Value="{Binding SidebarWidth}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ColumnDefinition.Style>
            </ColumnDefinition>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                BorderBrush="#D9E5F1"
                BorderThickness="0,0,1,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FBFDFF" Offset="0" />
                    <GradientStop Color="#F3F7FC" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel Margin="12,12,12,8">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="58" Height="58"
                                CornerRadius="16"
                                Background="{DynamicResource BrandPrimaryBrush}">
                            <Path Data="{StaticResource IconPharmacyCross}"
                                  Width="34" Height="34"
                                  Stretch="Uniform"
                                  Fill="White"
                                  StrokeThickness="0"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,-2,0,0" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SidebarCollapsed}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="BusinessOS" FontSize="22" FontWeight="Bold" Foreground="#102A56" />
                            <TextBlock Text="Pharmacy" FontSize="22" FontWeight="Bold"
                                       Foreground="{DynamicResource BrandPrimaryBrush}" Margin="0,-3,0,0" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Manage Today  ·  Healthier Tomorrow"
                               Margin="5,7,0,0"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#60758D"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SidebarCollapsed}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Button Command="{Binding ToggleSidebarCommand}"
                            Style="{StaticResource GhostButton}"
                            Padding="3,0"
                            MinHeight="20" Height="20"
                            Margin="0,0,0,0"
                            HorizontalAlignment="Right"
                            ToolTip="Collapse or expand navigation">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPanel}"
                                  Width="16" Height="16"
                                  Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.7"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Fill="Transparent" />
                            <TextBlock Text="Collapse" Margin="7,0,0,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SidebarCollapsed}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border DockPanel.Dock="Bottom"
                        Background="Transparent"
                        Padding="8,8,6,4"
                        Margin="0,8,0,0">
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SidebarCollapsed}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="BusinessOS Pharmacy" FontWeight="SemiBold" FontSize="12" Foreground="#1E3A5F" />
                        <TextBlock Text="v1.0.0  |  Built for Afghanistan" FontSize="10.5" Foreground="#64748B" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding NavigationItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SidebarNavigationButton}"
                                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding Key}"
                                        ToolTip="{Binding Tooltip}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="30"
                                                Height="30"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                            <Path Style="{StaticResource SidebarNavIconPath}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Border>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Label}"
                                                   Margin="4,0,0,0"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#314763" />
                                                    <Setter Property="FontWeight" Value="Normal" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Foreground" Value="#0B5FC6" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DataContext.SidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition>
                    <RowDefinition.Style>
                        <Style TargetType="RowDefinition">
                            <Setter Property="Height" Value="76" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPosMode}" Value="True">
                                    <Setter Property="Height" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </RowDefinition.Style>
                </RowDefinition>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,18,0">
                    <Border
                            MinWidth="180"
                            MaxWidth="640"
                            Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                            Height="44"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AppBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Margin="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path Data="{StaticResource IconSearch}"
                                  Width="18" Height="18"
                                  Stroke="{DynamicResource TextMutedBrush}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Fill="Transparent"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                            <Grid Grid.Column="1">
                                <TextBlock Text="Search medicines, customers, invoices…"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding GlobalSearchText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox x:Name="GlobalSearchBox"
                                         Text="{Binding GlobalSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SearchTextBox}"
                                         VerticalContentAlignment="Center"
                                         ToolTip="Ctrl+S or Ctrl+F" />
                            </Grid>
                            <Button Grid.Column="2"
                                    Command="{Binding GlobalSearchCommand}"
                                    Style="{StaticResource GhostButton}"
                                    Padding="8,5"
                                    Margin="2"
                                    ToolTip="Search">
                                <TextBlock Text="Ctrl+S" Style="{StaticResource CaptionText}" FontSize="11.5" />
                            </Button>
                        </Grid>
                    </Border>
                    </Grid>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#F8FBFF"
                                BorderBrush="#D9E5F1"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="10,5"
                                MinWidth="160"
                                Margin="0,0,8,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="8" Background="#E7F2FF">
                                    <Path Data="{StaticResource IconStore}" Width="15" Height="15"
                                          Stroke="{DynamicResource BrandPrimaryBrush}" StrokeThickness="1.8"
                                          Fill="Transparent" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Dashboard.PharmacyName}" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="#102A56" MaxWidth="132" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Dashboard.PharmacyCode}" FontSize="10" Foreground="#64748B"
                                               MaxWidth="132" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Width="152" Height="38"
                                Background="#F8FBFF"
                                BorderBrush="#D9E5F1"
                                BorderThickness="1"
                                CornerRadius="9"
                                Margin="0,0,8,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Data="{StaticResource IconGlobe}" Width="17" Height="17"
                                      Stroke="#24466F" StrokeThickness="1.7" Fill="Transparent"
                                      Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding Languages}"
                                          SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                          FontSize="12"
                                          BorderThickness="0"
                                          Background="Transparent"
                                          Padding="0"
                                          ToolTip="Language">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <localization:LanguageFlag LanguageCode="{Binding Code}"
                                                                           Margin="0,0,8,0"
                                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Button Command="{Binding NavigateCommand}"
                                CommandParameter="inventory"
                                Style="{StaticResource IconButton}"
                                Width="38" Height="38" MinHeight="38"
                                Margin="0,0,8,0"
                                ToolTip="Inventory alerts">
                            <Grid>
                                <Path Data="{StaticResource IconBell}" Width="19" Height="19"
                                      Stroke="#24466F" StrokeThickness="1.8" Fill="Transparent" Stretch="Uniform" />
                                <Border Background="{DynamicResource DangerBrush}" CornerRadius="7"
                                        MinWidth="14" Height="14" Padding="3,0"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12,-5,-7,0">
                                    <TextBlock Text="{Binding Dashboard.Alerts.Count}" Foreground="White"
                                               FontSize="8.5" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Button>

                        <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                            <StackPanel.ToolTip>
                                <StackPanel>
                                    <TextBlock Text="{Binding OnlineText, StringFormat='Connection: {0}'}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Dashboard.SyncStatusText}" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding LanStatusText, StringFormat='Server: {0}'}" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding Dashboard.LicenseValidityText}" Margin="0,3,0,0" />
                                </StackPanel>
                            </StackPanel.ToolTip>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding OnlineText}" Foreground="#0F5132" FontSize="12.5" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="{Binding Dashboard.SyncStatusText}" FontSize="10" Foreground="#64748B"
                                       MaxWidth="116" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconBadgeCheck}" Width="15" Height="15"
                                      Stroke="#16A34A" StrokeThickness="1.8" Fill="Transparent"
                                      Stretch="Uniform" Margin="0,0,5,0" />
                                <TextBlock Text="{Binding LicenseText}" Foreground="#15803D" FontSize="12.5" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="{Binding Dashboard.LicenseValidityText}" FontSize="10" Foreground="#64748B"
                                       MaxWidth="170" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Grid Width="38" Height="38" Margin="0,0,8,0">
                            <Border CornerRadius="19" Background="#DCEEFF">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasProfileImage}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Path Data="{StaticResource IconUsers}" Width="19" Height="19"
                                      Stroke="#2563A8" StrokeThickness="1.8" Fill="Transparent"
                                      Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Ellipse Width="38" Height="38">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding ProfileImageSource}" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasProfileImage}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </Grid>
                        <StackPanel Margin="0,0,6,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UserDisplayName}" FontWeight="SemiBold" FontSize="12.5"
                                       MaxWidth="110" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding UserRoleText}" FontSize="10" Foreground="#64748B"
                                       MaxWidth="110" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Command="{Binding LogoutCommand}" Style="{StaticResource IconButton}" ToolTip="Sign out"
                                Width="34" Height="34" MinHeight="34" Padding="8">
                            <Path Data="{StaticResource IconLogout}" Width="16" Height="16"
                                  Stroke="#64748B" StrokeThickness="1.8" Fill="Transparent" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentPage}"
                            Background="{DynamicResource AppBackgroundBrush}" />
        </Grid>

        <ItemsControl Grid.ColumnSpan="2"
                      ItemsSource="{Binding Notifications}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Margin="0,0,22,18"
                      Panel.ZIndex="99">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="380" Margin="0,8,0,0" Padding="14,11" CornerRadius="10" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#EFF6FF" />
                                <Setter Property="BorderBrush" Value="#BFDBFE" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="Success">
                                        <Setter Property="Background" Value="#ECFDF5" />
                                        <Setter Property="BorderBrush" Value="#A7F3D0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Warning">
                                        <Setter Property="Background" Value="#FFFBEB" />
                                        <Setter Property="BorderBrush" Value="#FDE68A" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Error">
                                        <Setter Property="Background" Value="#FEF2F2" />
                                        <Setter Property="BorderBrush" Value="#FECACA" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="12.5">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#1D4ED8" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="Success">
                                                    <Setter Property="Foreground" Value="#15803D" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Warning">
                                                    <Setter Property="Foreground" Value="#B45309" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Error">
                                                    <Setter Property="Foreground" Value="#B91C1C" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Message}"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0"
                                           FontSize="12"
                                           Foreground="#334155" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Style="{StaticResource GhostButton}"
                                    Width="26" Height="26" MinHeight="26"
                                    Padding="4"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Top"
                                    Command="{Binding DismissCommand}"
                                    ToolTip="Dismiss">
                                <Path Data="M4,4 L12,12 M12,4 L4,12"
                                      Width="10" Height="10"
                                      Stroke="#64748B"
                                      StrokeThickness="1.8"
                                      Fill="Transparent"
                                      Stretch="Uniform" />
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>