<Window x:Class="BusinessOS.Pharmacy.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:customers="clr-namespace:BusinessOS.Pharmacy.Desktop.Customers"
        xmlns:dashboard="clr-namespace:BusinessOS.Pharmacy.Desktop.Dashboard"
        xmlns:medicines="clr-namespace:BusinessOS.Pharmacy.Desktop.Medicines"
        xmlns:inventory="clr-namespace:BusinessOS.Pharmacy.Desktop.Inventory"
        xmlns:purchasing="clr-namespace:BusinessOS.Pharmacy.Desktop.Purchasing"
        xmlns:pos="clr-namespace:BusinessOS.Pharmacy.Desktop.Pos"
        xmlns:returns="clr-namespace:BusinessOS.Pharmacy.Desktop.Returns"
        Title="Darmaltoon"
        Width="1360" Height="820"
        MinWidth="1080" MinHeight="680"
        Background="{DynamicResource AppBackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type dashboard:DashboardViewModel}">
            <dashboard:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type pos:PosViewModel}">
            <pos:PosView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type returns:ReturnsViewModel}">
            <returns:ReturnsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type customers:CustomersViewModel}">
            <customers:CustomersView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type medicines:MedicinesViewModel}">
            <medicines:MedicinesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type inventory:InventoryViewModel}">
            <inventory:InventoryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type purchasing:PurchasingViewModel}">
            <purchasing:PurchasingView/>
        </DataTemplate>
    </Window.Resources>

    <Grid FlowDirection="{Binding LayoutDirection}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
            <DockPanel Margin="18,20">
                <StackPanel DockPanel.Dock="Top" Margin="4,0,4,22">
                    <TextBlock Text="{Binding ApplicationName}" Foreground="White" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="darmaltoon.com" Foreground="#93C5FD" FontSize="11" Margin="0,3,0,0" />
                    <TextBlock Text="{Binding ParentBrand}" Foreground="#94A3B8" FontSize="10" Margin="0,2,0,0" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding NavigationItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource SidebarNavigationButton}"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding Key}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Glyph}" Foreground="#93C5FD" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="#E2E8F0" FontSize="13" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="68" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="26,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding PageTitle}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UserDisplayName}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding UserRoleText}" Style="{StaticResource MutedText}" HorizontalAlignment="Right" />
                        </StackPanel>
                        <Border Background="#ECFDF5" CornerRadius="16" Padding="10,5" Margin="0,0,12,0">
                            <TextBlock Text="{Binding OnlineText}" Foreground="#047857" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                        <ComboBox Width="120" ItemsSource="{Binding Languages}"
                                  SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName" Margin="0,0,10,0" />
                        <Button Content="Sign Out" Command="{Binding LogoutCommand}" Padding="10,6" />
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
        </Grid>
    </Grid>
</Window>
