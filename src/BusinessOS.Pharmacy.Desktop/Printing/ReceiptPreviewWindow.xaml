<Window x:Class="BusinessOS.Pharmacy.Desktop.Printing.ReceiptPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Darmaltoon;component/Assets/Darmaltoon.ico"
        Title="Receipt Preview · Darmaltoon"
        Width="920"
        Height="780"
        MinWidth="760"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="#F3F6FA">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#DDE6F0"
                BorderThickness="0,0,0,1"
                Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Receipt preview"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#0B1F44" />
                    <TextBlock Text="{Binding SaleNumberText}"
                               FontSize="11"
                               Foreground="#64748B"
                               Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Printer"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               Foreground="#52677F"
                               Margin="0,0,0,4" />
                    <ComboBox x:Name="PrinterCombo"
                              ItemsSource="{Binding PrinterNames}"
                              SelectedItem="{Binding SelectedPrinter}"
                              MinHeight="36" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="18">
            <Border Background="#DDE4ED"
                    CornerRadius="12"
                    Padding="18">
                <Border Background="White"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        CornerRadius="4"
                        HorizontalAlignment="Center"
                        Width="430"
                        Padding="16">
                    <FlowDocumentScrollViewer x:Name="PreviewViewer"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              IsToolBarVisible="False"
                                              Zoom="100"
                                              Background="White" />
                </Border>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#DDE6F0"
                BorderThickness="0,1,0,0"
                Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Review the receipt, choose a printer, then print. PDF printers may still ask for a save location."
                           FontSize="10"
                           Foreground="#64748B"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,16,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Cancel"
                            Click="OnCancelClick"
                            Style="{StaticResource SecondaryButton}"
                            MinWidth="90"
                            Margin="0,0,8,0" />
                    <Button Content="Print receipt"
                            Click="OnPrintClick"
                            Style="{StaticResource PrimaryButton}"
                            MinWidth="140" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
