<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Darmaltoon</AssemblyName>
    <AssemblyTitle>Darmaltoon</AssemblyTitle>
    <Product>Darmaltoon</Product>
    <Company>BusinessOS.af</Company>
    <Authors>WeSoft Technologies</Authors>
    <Description>Darmaltoon Pharmacy Management for Windows</Description>
    <Copyright>Copyright © BusinessOS.af</Copyright>
    <RootNamespace>BusinessOS.Pharmacy.Desktop</RootNamespace>
    <ApplicationIcon>Assets\Darmaltoon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\BusinessOS.Pharmacy.Application\BusinessOS.Pharmacy.Application.csproj" />
    <ProjectReference Include="..\BusinessOS.Pharmacy.Infrastructure\BusinessOS.Pharmacy.Infrastructure.csproj" />
    <ProjectReference Include="..\BusinessOS.Pharmacy.Persistence\BusinessOS.Pharmacy.Persistence.csproj" />
    <ProjectReference Include="..\BusinessOS.Pharmacy.LocalClient\BusinessOS.Pharmacy.LocalClient.csproj" />
    <ProjectReference Include="..\BusinessOS.Pharmacy.Licensing\BusinessOS.Pharmacy.Licensing.csproj" />
    <ProjectReference Include="..\BusinessOS.Pharmacy.Sync\BusinessOS.Pharmacy.Sync.csproj" />
    <ProjectReference Include="..\BusinessOS.Pharmacy.Printing\BusinessOS.Pharmacy.Printing.csproj" />
    <ProjectReference Include="..\BusinessOS.Pharmacy.Updater\BusinessOS.Pharmacy.Updater.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\Darmaltoon.ico" />
    <Resource Include="Assets\Glass\*.png" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <Target Name="CopyUpdateAgentRuntime" AfterTargets="Build">
    <ItemGroup>
      <UpdateAgentRuntime Include="$(MSBuildProjectDirectory)/../BusinessOS.Pharmacy.Updater/bin/$(Configuration)/net10.0/BusinessOS.Pharmacy.Updater*" />
    </ItemGroup>
    <Copy SourceFiles="@(UpdateAgentRuntime)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
