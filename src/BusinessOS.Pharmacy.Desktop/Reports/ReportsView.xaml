<UserControl x:Class="BusinessOS.Pharmacy.Desktop.Reports.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ComboBox ItemsSource="{Binding ExportTypes}" SelectedItem="{Binding SelectedExportType}" Width="120" Margin="0,0,8,0"/>
                    <Button Content="{Binding ExportLabel}" Command="{Binding ExportCommand}" Padding="12,6"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="From" Style="{StaticResource MutedText}"/>
                    <TextBox Text="{Binding FromText}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="To" Style="{StaticResource MutedText}"/>
                    <TextBox Text="{Binding ToText}"/>
                </StackPanel>
                <Button Grid.Column="2" Content="{Binding LoadLabel}" Command="{Binding LoadCommand}" Padding="14,7" VerticalAlignment="Bottom"/>
            </Grid>

            <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding SummaryTitle}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <UniformGrid Columns="5">
                        <StackPanel Margin="4"><TextBlock Text="Sales" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Summary.Sales, StringFormat=AFN {0:N4}}" FontWeight="SemiBold"/></StackPanel>
                        <StackPanel Margin="4"><TextBlock Text="Returns" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Summary.Returns, StringFormat=AFN {0:N4}}" FontWeight="SemiBold"/></StackPanel>
                        <StackPanel Margin="4"><TextBlock Text="Net sales" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Summary.NetSales, StringFormat=AFN {0:N4}}" FontWeight="SemiBold"/></StackPanel>
                        <StackPanel Margin="4"><TextBlock Text="Gross profit" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Summary.GrossProfit, StringFormat=AFN {0:N4}}" FontWeight="SemiBold"/></StackPanel>
                        <StackPanel Margin="4"><TextBlock Text="Collections" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Summary.Collections, StringFormat=AFN {0:N4}}" FontWeight="SemiBold"/></StackPanel>
                        <StackPanel Margin="4"><TextBlock Text="Purchases" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Summary.Purchases, StringFormat=AFN {0:N4}}" FontWeight="SemiBold"/></StackPanel>
                        <StackPanel Margin="4"><TextBlock Text="Receivables" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Summary.Receivables, StringFormat=AFN {0:N4}}" FontWeight="SemiBold"/></StackPanel>
                        <StackPanel Margin="4"><TextBlock Text="Payables" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Summary.Payables, StringFormat=AFN {0:N4}}" FontWeight="SemiBold"/></StackPanel>
                        <StackPanel Margin="4"><TextBlock Text="Stock value" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Summary.StockValue, StringFormat=AFN {0:N4}}" FontWeight="SemiBold"/></StackPanel>
                        <StackPanel Margin="4"><TextBlock Text="Discounts" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Summary.Discounts, StringFormat=AFN {0:N4}}" FontWeight="SemiBold"/></StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <TabControl Grid.Row="3" Margin="0,18,0,0" MinHeight="260">
                <TabItem Header="Sales">
                    <DataGrid ItemsSource="{Binding Sales}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Sale" Binding="{Binding SaleNumber}" Width="*"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding BusinessDate}" Width="110"/>
                            <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*"/>
                            <DataGridTextColumn Header="Location" Binding="{Binding StockLocationName}" Width="*"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding GrandTotal, StringFormat=N4}" Width="100"/>
                            <DataGridTextColumn Header="Paid" Binding="{Binding PaidTotal, StringFormat=N4}" Width="100"/>
                            <DataGridTextColumn Header="Due" Binding="{Binding DueTotal, StringFormat=N4}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Returns">
                    <DataGrid ItemsSource="{Binding Returns}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Return" Binding="{Binding ReturnNumber}" Width="*"/>
                            <DataGridTextColumn Header="Sale" Binding="{Binding SaleNumber}" Width="*"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding BusinessDate}" Width="110"/>
                            <DataGridTextColumn Header="Refund" Binding="{Binding RefundTotal, StringFormat=N4}" Width="110"/>
                            <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Purchases">
                    <DataGrid ItemsSource="{Binding Purchases}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNumber}" Width="*"/>
                            <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="*"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding InvoiceDate}" Width="110"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding GrandTotal, StringFormat=N4}" Width="100"/>
                            <DataGridTextColumn Header="Paid" Binding="{Binding PaidTotal, StringFormat=N4}" Width="100"/>
                            <DataGridTextColumn Header="Balance" Binding="{Binding BalanceDue, StringFormat=N4}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Movements">
                    <DataGrid ItemsSource="{Binding Movements}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Occurred" Binding="{Binding OccurredAt}" Width="160"/>
                            <DataGridTextColumn Header="Medicine" Binding="{Binding MedicineName}" Width="*"/>
                            <DataGridTextColumn Header="Batch" Binding="{Binding BatchNumber}" Width="100"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding MovementType}" Width="120"/>
                            <DataGridTextColumn Header="Qty" Binding="{Binding QuantityDelta, StringFormat=0.####}" Width="90"/>
                            <DataGridTextColumn Header="Balance" Binding="{Binding BalanceAfter, StringFormat=0.####}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>

            <Grid Grid.Row="4" Margin="0,18,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,9,0">
                    <StackPanel>
                        <TextBlock Text="Near expiry (90 days)" FontWeight="SemiBold"/>
                        <DataGrid ItemsSource="{Binding NearExpiry}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="220" Margin="0,8,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Medicine" Binding="{Binding MedicineName}" Width="*"/>
                                <DataGridTextColumn Header="Batch" Binding="{Binding BatchNumber}" Width="100"/>
                                <DataGridTextColumn Header="Qty" Binding="{Binding AvailableQuantity, StringFormat=0.####}" Width="80"/>
                                <DataGridTextColumn Header="Expiry" Binding="{Binding ExpiresAt}" Width="110"/>
                                <DataGridTextColumn Header="Days" Binding="{Binding DaysRemaining}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="9,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Low stock" FontWeight="SemiBold"/>
                        <DataGrid ItemsSource="{Binding LowStock}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="220" Margin="0,8,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Code" Binding="{Binding MedicineCode}" Width="100"/>
                                <DataGridTextColumn Header="Medicine" Binding="{Binding BrandName}" Width="*"/>
                                <DataGridTextColumn Header="Available" Binding="{Binding AvailableStock, StringFormat=0.####}" Width="90"/>
                                <DataGridTextColumn Header="Reorder" Binding="{Binding ReorderLevel, StringFormat=0.####}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
