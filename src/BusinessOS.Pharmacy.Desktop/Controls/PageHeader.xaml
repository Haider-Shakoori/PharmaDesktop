<UserControl x:Class="BusinessOS.Pharmacy.Desktop.Controls.PageHeader"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Eyebrow, ElementName=Root}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource PageEyebrowText}">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding Title, ElementName=Root}"
                       Style="{StaticResource PageTitleText}"
                       Margin="0,2,0,0" />
            <TextBlock Text="{Binding Description, ElementName=Root}"
                       Style="{StaticResource PageSubtitleText}"
                       Margin="0,4,0,0"
                       MaxWidth="720"
                       HorizontalAlignment="Left" />
        </StackPanel>

        <ContentPresenter Grid.Column="1"
                          Content="{Binding Actions, ElementName=Root}"
                          VerticalAlignment="Center"
                          Margin="18,0,0,0" />
    </Grid>
</UserControl>