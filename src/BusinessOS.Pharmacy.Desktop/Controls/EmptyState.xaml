<UserControl x:Class="BusinessOS.Pharmacy.Desktop.Controls.EmptyState"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid MinHeight="150">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="420">
            <Border Width="46"
                    Height="46"
                    CornerRadius="14"
                    Background="{DynamicResource SelectedBrush}"
                    HorizontalAlignment="Center">
                <Path Data="{Binding Icon, ElementName=Root}"
                      Width="22"
                      Height="22"
                      Stretch="Uniform"
                      Stroke="{DynamicResource BrandPrimaryBrush}"
                      StrokeThickness="1.8"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Fill="Transparent"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="{Binding Title, ElementName=Root}"
                       FontSize="15"
                       FontWeight="SemiBold"
                       TextAlignment="Center"
                       Margin="0,12,0,0" />
            <TextBlock Text="{Binding Message, ElementName=Root}"
                       Style="{StaticResource PageSubtitleText}"
                       TextAlignment="Center"
                       Margin="0,5,0,0" />
            <ContentPresenter Content="{Binding Action, ElementName=Root}"
                              HorizontalAlignment="Center"
                              Margin="0,14,0,0" />
        </StackPanel>
    </Grid>
</UserControl>