<UserControl x:Class="BusinessOS.Pharmacy.Desktop.Purchasing.PurchasingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BusinessOS.Pharmacy.Desktop.Controls">

    <UserControl.Resources>
        <Style x:Key="PoCard" TargetType="Border" BasedOn="{StaticResource SurfaceCard}">
            <Setter Property="Padding" Value="14" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        </Style>

        <Style x:Key="PoSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="PoLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>

        <Style x:Key="PoHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="PoGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{DynamicResource SurfaceStrongBrush}" />
            <Setter Property="RowBackground" Value="{DynamicResource SurfaceStrongBrush}" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource SurfaceStrongBrush}" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="RowHeight" Value="28" />
            <Setter Property="ColumnHeaderHeight" Value="28" />
            <Setter Property="FontSize" Value="10.2" />
        </Style>

        <Style x:Key="PoPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="PoSecondaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0"
                             Eyebrow="Procurement"
                             Title="{Binding Title}"
                             Description="{Binding Subtitle}">
            <controls:PageHeader.Actions>
                <Button Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource PrimaryButton}"/>
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <TabControl Grid.Row="1">
            <TabItem Header="Suppliers">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="0.95*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SurfaceCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding SupplierSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="9,7" Margin="0,0,8,0"
                                         ToolTip="Name, code, phone or WhatsApp"/>
                                <Button Grid.Column="1" Content="Search" Command="{Binding SearchSuppliersCommand}" Padding="14,8"/>
                            </Grid>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding Suppliers}"
                                      SelectedItem="{Binding SelectedSupplier}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="90"/>
                                    <DataGridTextColumn Header="Supplier" Binding="{Binding Name}" Width="1.4*"/>
                                    <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="110"/>
                                    <DataGridTextColumn Header="City" Binding="{Binding City}" Width="90"/>
                                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="65"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource SurfaceCard}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Supplier editor" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12"/>

                                <TextBlock Text="Code"/>
                                <TextBox Text="{Binding SupplierCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>

                                <TextBlock Text="Name"/>
                                <TextBox Text="{Binding SupplierName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Contact person"/>
                                        <TextBox Text="{Binding SupplierContactPerson}" Margin="0,4,0,8"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Payment terms (days)"/>
                                        <TextBox Text="{Binding SupplierPaymentTermsDays}" Margin="0,4,0,8"/>
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Phone"/>
                                        <TextBox Text="{Binding SupplierPhone}" Margin="0,4,0,8"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="WhatsApp"/>
                                        <TextBox Text="{Binding SupplierWhatsapp}" Margin="0,4,0,8"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Email"/>
                                <TextBox Text="{Binding SupplierEmail}" Margin="0,4,0,8"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="City"/>
                                        <TextBox Text="{Binding SupplierCity}" Margin="0,4,0,8"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Province"/>
                                        <TextBox Text="{Binding SupplierProvince}" Margin="0,4,0,8"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Address"/>
                                <TextBox Text="{Binding SupplierAddress}" Margin="0,4,0,8"/>

                                <TextBlock Text="Notes"/>
                                <TextBox Text="{Binding SupplierNotes}" AcceptsReturn="True" Height="70" Margin="0,4,0,8"/>

                                <CheckBox Content="Active" IsChecked="{Binding SupplierIsActive}" Margin="0,0,0,12"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="New" Command="{Binding NewSupplierCommand}" Padding="14,8" Margin="0,0,8,0"/>
                                    <Button Content="Save supplier" Command="{Binding SaveSupplierCommand}"
                                            Style="{StaticResource PrimaryButton}" Padding="14,8"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Purchase orders">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Simplified workflow -->
                    <Border Grid.Row="0"
                            Style="{StaticResource PoCard}"
                            Background="{DynamicResource SurfaceStrongBrush}"
                            Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="38"
                                    Height="38"
                                    CornerRadius="10"
                                    Background="{DynamicResource BrandPrimarySoftBrush}"
                                    VerticalAlignment="Center">
                                <Path Data="{StaticResource IconPurchases}"
                                      Width="19"
                                      Height="19"
                                      Stroke="{DynamicResource BrandPrimaryBrush}"
                                      StrokeThickness="1.9"
                                      Fill="Transparent"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Fast purchase workflow"
                                           FontSize="13.5"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Create → approve → receive to inventory → invoice → pay. Fast actions combine safe backend steps so you do less clicking without losing the audit trail."
                                           Style="{StaticResource PoHint}"
                                           Margin="0,2,0,7" />
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="{DynamicResource BrandPrimarySoftBrush}" CornerRadius="7" Padding="8,4" Margin="0,0,6,0">
                                        <TextBlock Text="1  Create PO" Foreground="{DynamicResource BrandPrimaryDarkBrush}" FontSize="9.5" FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Text="→" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <Border Background="{DynamicResource PurpleSoftBrush}" CornerRadius="7" Padding="8,4" Margin="0,0,6,0">
                                        <TextBlock Text="2  Approve" Foreground="{DynamicResource PurpleBrush}" FontSize="9.5" FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Text="→" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <Border Background="{DynamicResource PosPrimarySoftBrush}" CornerRadius="7" Padding="8,4" Margin="0,0,6,0">
                                        <TextBlock Text="3  Receive stock" Foreground="{DynamicResource PosPrimaryBrush}" FontSize="9.5" FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Text="→" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <Border Background="{DynamicResource WarningSoftBrush}" CornerRadius="7" Padding="8,4" Margin="0,0,6,0">
                                        <TextBlock Text="4  Invoice" Foreground="{DynamicResource WarningBrush}" FontSize="9.5" FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Text="→" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <Border Background="{DynamicResource SuccessSoftBrush}" CornerRadius="7" Padding="8,4">
                                        <TextBlock Text="5  Pay supplier" Foreground="{DynamicResource SuccessBrush}" FontSize="9.5" FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Search / filter -->
                    <Border Grid.Row="1"
                            Style="{StaticResource PoCard}"
                            Margin="0,0,0,10"
                            Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding OrderSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="10,7"
                                     Margin="0,0,8,0"
                                     ToolTip="PO number or supplier" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding OrderStatuses}"
                                      SelectedItem="{Binding SelectedOrderStatus}"
                                      Margin="0,0,8,0" />
                            <Button Grid.Column="2"
                                    Content="Search"
                                    Command="{Binding SearchOrdersCommand}"
                                    Style="{StaticResource PoSecondaryButton}" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.82*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="1.45*" />
                        </Grid.ColumnDefinitions>

                        <!-- Orders list -->
                        <Border Grid.Column="0"
                                Style="{StaticResource PoCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Purchase orders"
                                                   Style="{StaticResource PoSectionTitle}" />
                                        <TextBlock Text="Select an order to continue its workflow."
                                                   Style="{StaticResource PoHint}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Background="{DynamicResource SurfaceMutedBrush}"
                                            CornerRadius="7"
                                            Padding="8,4"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Orders.Count, StringFormat={}{0} orders}"
                                                   FontSize="9.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </Grid>

                                <DataGrid Grid.Row="1"
                                          ItemsSource="{Binding Orders}"
                                          SelectedItem="{Binding SelectedOrder}"
                                          Style="{StaticResource PoGrid}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="PO"
                                                            Binding="{Binding Number}"
                                                            Width="118" />
                                        <DataGridTextColumn Header="Supplier"
                                                            Binding="{Binding SupplierName}"
                                                            Width="*" />
                                        <DataGridTemplateColumn Header="Status" Width="96">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="7"
                                                            Padding="7,2"
                                                            HorizontalAlignment="Left">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="approved">
                                                                        <Setter Property="Background" Value="{DynamicResource PosPrimarySoftBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="received">
                                                                        <Setter Property="Background" Value="{DynamicResource BrandPrimarySoftBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="partially_received">
                                                                        <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="cancelled">
                                                                        <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Status}"
                                                                   FontSize="9.2"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Total"
                                                            Binding="{Binding GrandTotal, StringFormat=N2}"
                                                            Width="78" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- Right workflow -->
                        <ScrollViewer Grid.Column="2"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <!-- Quick new PO -->
                                <Border Style="{StaticResource PoCard}"
                                        Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Quick purchase order"
                                                           Style="{StaticResource PoSectionTitle}" />
                                                <TextBlock Text="{Binding QuickCreateHint}"
                                                           Style="{StaticResource PoHint}"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Background="{DynamicResource PosPrimarySoftBrush}"
                                                    CornerRadius="8"
                                                    Padding="9,4"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding DraftSummary}"
                                                           Foreground="{DynamicResource PosPrimaryBrush}"
                                                           FontSize="9.5"
                                                           FontWeight="Bold" />
                                            </Border>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.5*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="0.8*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="0.8*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Supplier" Style="{StaticResource PoLabel}" />
                                                <ComboBox ItemsSource="{Binding SupplierReferences}"
                                                          SelectedItem="{Binding SelectedOrderSupplier}"
                                                          DisplayMemberPath="Name"
                                                          Margin="0,4,0,8" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Order date" Style="{StaticResource PoLabel}" />
                                                <TextBox Text="{Binding OrderDateText}" Margin="0,4,0,8" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="Expected (optional)" Style="{StaticResource PoLabel}" />
                                                <TextBox Text="{Binding ExpectedDateText}" Margin="0,4,0,8" />
                                            </StackPanel>
                                        </Grid>

                                        <Border Background="{DynamicResource AppBackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="10"
                                                Margin="0,1,0,8">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.6*" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="0.55*" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="0.7*" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="0.6*" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="0.6*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Medicine" Style="{StaticResource PoLabel}" />
                                                        <ComboBox ItemsSource="{Binding MedicineReferences}"
                                                                  SelectedItem="{Binding SelectedDraftMedicine}"
                                                                  DisplayMemberPath="BrandName"
                                                                  Margin="0,4,0,0" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Qty" Style="{StaticResource PoLabel}" />
                                                        <TextBox Text="{Binding DraftQuantity}" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="4">
                                                        <TextBlock Text="Unit cost" Style="{StaticResource PoLabel}" />
                                                        <TextBox Text="{Binding DraftUnitCost}" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="6">
                                                        <TextBlock Text="Discount" Style="{StaticResource PoLabel}" />
                                                        <TextBox Text="{Binding DraftDiscount}" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="8">
                                                        <TextBlock Text="Landed" Style="{StaticResource PoLabel}" />
                                                        <TextBox Text="{Binding DraftLandedCost}" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                    <Button Grid.Column="9"
                                                            Content="+ Add"
                                                            Command="{Binding AddDraftLineCommand}"
                                                            Style="{StaticResource PoSecondaryButton}"
                                                            Margin="8,19,0,0" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <DataGrid ItemsSource="{Binding DraftLines}"
                                                  Style="{StaticResource PoGrid}"
                                                  Height="128">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Medicine" Binding="{Binding MedicineLabel}" Width="*" />
                                                <DataGridTextColumn Header="Qty" Binding="{Binding OrderedQuantity, StringFormat=N2}" Width="58" />
                                                <DataGridTextColumn Header="Cost" Binding="{Binding UnitCost, StringFormat=N2}" Width="66" />
                                                <DataGridTextColumn Header="Discount" Binding="{Binding DiscountAmount, StringFormat=N2}" Width="68" />
                                                <DataGridTextColumn Header="Landed" Binding="{Binding LandedCostAllocated, StringFormat=N2}" Width="66" />
                                                <DataGridTextColumn Header="Total" Binding="{Binding LineTotal, StringFormat=N2}" Width="72" />
                                                <DataGridTemplateColumn Header="" Width="34">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="×"
                                                                    Command="{Binding DataContext.RemoveDraftLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                    CommandParameter="{Binding}"
                                                                    Background="Transparent"
                                                                    BorderBrush="Transparent"
                                                                    Foreground="{DynamicResource DangerBrush}"
                                                                    FontSize="16"
                                                                    FontWeight="Bold"
                                                                    Padding="2" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <Grid Margin="0,9,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding OrderNotes}"
                                                     ToolTip="Purchase order notes"
                                                     MinHeight="38"
                                                     Margin="0,0,8,0" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Content="Save draft"
                                                        Command="{Binding CreateOrderCommand}"
                                                        Style="{StaticResource PoSecondaryButton}"
                                                        Margin="0,0,7,0" />
                                                <Button Content="{Binding QuickCreateLabel}"
                                                        Command="{Binding QuickCreateOrderCommand}"
                                                        Style="{StaticResource PoPrimaryButton}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Selected PO -->
                                <Border Style="{StaticResource PoCard}"
                                        Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Selected purchase order"
                                                           Style="{StaticResource PoSectionTitle}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding SelectedOrderDetail.Order.Number}"
                                                               FontSize="12.5"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text=" · " Foreground="{DynamicResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding SelectedOrderDetail.Order.SupplierName}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Background="{DynamicResource BrandPrimarySoftBrush}"
                                                    CornerRadius="8"
                                                    Padding="9,4"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding SelectedOrderDetail.Order.Status}"
                                                           Foreground="{DynamicResource BrandPrimaryDarkBrush}"
                                                           FontSize="9.5"
                                                           FontWeight="Bold" />
                                            </Border>
                                        </Grid>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Background="{DynamicResource AppBackgroundBrush}" CornerRadius="8" Padding="9,6">
                                                <TextBlock Text="{Binding SelectedOrderNextStep}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding SelectedOrderDetail.Order.GrandTotal, StringFormat=AFN {0:N2}}"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource PosPrimaryBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="12,0,0,0" />
                                        </Grid>

                                        <DataGrid ItemsSource="{Binding SelectedOrderDetail.Lines}"
                                                  SelectedItem="{Binding SelectedOrderLine}"
                                                  Style="{StaticResource PoGrid}"
                                                  Height="132">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Medicine" Binding="{Binding Description}" Width="*" />
                                                <DataGridTextColumn Header="Ordered" Binding="{Binding OrderedQuantity, StringFormat=N2}" Width="66" />
                                                <DataGridTextColumn Header="Received" Binding="{Binding ReceivedQuantity, StringFormat=N2}" Width="66" />
                                                <DataGridTextColumn Header="Cost" Binding="{Binding UnitCost, StringFormat=N2}" Width="66" />
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Content="Submit"
                                                    Command="{Binding SubmitOrderCommand}"
                                                    Style="{StaticResource PoSecondaryButton}"
                                                    Margin="0,0,7,0" />
                                            <Button Content="Approve"
                                                    Command="{Binding ApproveOrderCommand}"
                                                    Style="{StaticResource PoSecondaryButton}"
                                                    Margin="0,0,7,0" />
                                            <Button Content="Cancel order"
                                                    Command="{Binding CancelOrderCommand}"
                                                    Background="Transparent"
                                                    BorderBrush="{DynamicResource DangerSoftBrush}"
                                                    Foreground="{DynamicResource DangerBrush}"
                                                    Padding="11,7"
                                                    MinHeight="36" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- One-step receiving -->
                                <Border Style="{StaticResource PoCard}"
                                        Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Receive stock"
                                                           Style="{StaticResource PoSectionTitle}" />
                                                <TextBlock Text="Select a PO line, enter batch details, then receive and post it directly to inventory."
                                                           Style="{StaticResource PoHint}"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Background="{DynamicResource PosPrimarySoftBrush}"
                                                    CornerRadius="8"
                                                    Padding="8,4">
                                                <TextBlock Text="1 click"
                                                           Foreground="{DynamicResource PosPrimaryBrush}"
                                                           FontSize="9.5"
                                                           FontWeight="Bold" />
                                            </Border>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="0.8*" />
                                                <ColumnDefinition Width="7" />
                                                <ColumnDefinition Width="0.6*" />
                                                <ColumnDefinition Width="7" />
                                                <ColumnDefinition Width="0.8*" />
                                                <ColumnDefinition Width="7" />
                                                <ColumnDefinition Width="0.8*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Receive qty" Style="{StaticResource PoLabel}" />
                                                <TextBox Text="{Binding ReceiptQuantity}" Margin="0,4,0,8" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Bonus" Style="{StaticResource PoLabel}" />
                                                <TextBox Text="{Binding ReceiptBonusQuantity}" Margin="0,4,0,8" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="Batch" Style="{StaticResource PoLabel}" />
                                                <TextBox Text="{Binding ReceiptBatchNumber}" Margin="0,4,0,8" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="6">
                                                <TextBlock Text="Expiry" Style="{StaticResource PoLabel}" />
                                                <TextBox Text="{Binding ExpiresAtText}" Margin="0,4,0,8" ToolTip="yyyy-MM-dd" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="0.8*" />
                                                <ColumnDefinition Width="7" />
                                                <ColumnDefinition Width="0.8*" />
                                                <ColumnDefinition Width="7" />
                                                <ColumnDefinition Width="1.2*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Unit cost" Style="{StaticResource PoLabel}" />
                                                <TextBox Text="{Binding ReceiptUnitCost}" Margin="0,4,0,8" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Sale price" Style="{StaticResource PoLabel}" />
                                                <TextBox Text="{Binding ReceiptSalePrice}" Margin="0,4,0,8" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="Stock location" Style="{StaticResource PoLabel}" />
                                                <ComboBox ItemsSource="{Binding StockLocations}"
                                                          SelectedItem="{Binding SelectedStockLocation}"
                                                          DisplayMemberPath="Name"
                                                          Margin="0,4,0,8" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding ReceiptNotes}"
                                                     ToolTip="Receipt notes"
                                                     Margin="0,0,8,0" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Content="Capture only"
                                                        Command="{Binding CaptureReceiptCommand}"
                                                        Style="{StaticResource PoSecondaryButton}"
                                                        Margin="0,0,7,0" />
                                                <Button Content="Receive &amp; post to inventory"
                                                        Command="{Binding ReceiveAndPostCommand}"
                                                        Style="{StaticResource PoPrimaryButton}" />
                                            </StackPanel>
                                        </Grid>

                                        <Expander Header="Advanced / previously captured receipts"
                                                  Margin="0,9,0,0">
                                            <StackPanel Margin="0,7,0,0">
                                                <DataGrid ItemsSource="{Binding SelectedOrderDetail.Receipts}"
                                                          SelectedItem="{Binding SelectedReceipt}"
                                                          Style="{StaticResource PoGrid}"
                                                          Height="105">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="GRN" Binding="{Binding ReceiptNumber}" Width="130" />
                                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="82" />
                                                        <DataGridTextColumn Header="Location" Binding="{Binding StockLocationName}" Width="*" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                                <Button Content="Post selected captured receipt"
                                                        Command="{Binding PostReceiptCommand}"
                                                        Style="{StaticResource PoSecondaryButton}"
                                                        HorizontalAlignment="Right"
                                                        Margin="0,7,0,0" />
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </Border>

                                <!-- Invoice and payment -->
                                <Border Style="{StaticResource PoCard}">
                                    <StackPanel>
                                        <TextBlock Text="Supplier invoice &amp; payment"
                                                   Style="{StaticResource PoSectionTitle}" />
                                        <TextBlock Text="Record the supplier invoice after stock is received, then record payment when due."
                                                   Style="{StaticResource PoHint}"
                                                   Margin="0,2,0,9" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.1*" />
                                                <ColumnDefinition Width="7" />
                                                <ColumnDefinition Width="0.8*" />
                                                <ColumnDefinition Width="7" />
                                                <ColumnDefinition Width="0.8*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Supplier invoice #" Style="{StaticResource PoLabel}" />
                                                <TextBox Text="{Binding SupplierInvoiceNumber}" Margin="0,4,0,8" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Invoice date" Style="{StaticResource PoLabel}" />
                                                <TextBox Text="{Binding InvoiceDateText}" Margin="0,4,0,8" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="Due date" Style="{StaticResource PoLabel}" />
                                                <TextBox Text="{Binding InvoiceDueDateText}" Margin="0,4,0,8" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="7" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox ItemsSource="{Binding SelectedOrderDetail.Receipts}"
                                                      SelectedItem="{Binding SelectedInvoiceReceipt}"
                                                      DisplayMemberPath="ReceiptNumber"
                                                      ToolTip="Goods receipt"
                                                      Margin="0,0,0,8" />
                                            <TextBox Grid.Column="2"
                                                     Text="{Binding InvoiceNotes}"
                                                     ToolTip="Invoice notes"
                                                     Margin="0,0,8,8" />
                                            <Button Grid.Column="3"
                                                    Content="Record invoice"
                                                    Command="{Binding CreateInvoiceCommand}"
                                                    Style="{StaticResource PoSecondaryButton}"
                                                    Margin="0,0,0,8" />
                                        </Grid>

                                        <DataGrid ItemsSource="{Binding SelectedOrderDetail.Invoices}"
                                                  SelectedItem="{Binding SelectedInvoice}"
                                                  Style="{StaticResource PoGrid}"
                                                  Height="105">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNumber}" Width="120" />
                                                <DataGridTextColumn Header="Supplier #" Binding="{Binding SupplierInvoiceNumber}" Width="100" />
                                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="82" />
                                                <DataGridTextColumn Header="Total" Binding="{Binding GrandTotal, StringFormat=N2}" Width="70" />
                                                <DataGridTextColumn Header="Balance" Binding="{Binding BalanceDue, StringFormat=N2}" Width="72" />
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <Border Background="{DynamicResource AppBackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="9"
                                                Margin="0,8,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="92" />
                                                    <ColumnDefinition Width="7" />
                                                    <ColumnDefinition Width="105" />
                                                    <ColumnDefinition Width="7" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="7" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding PaymentAmount}" ToolTip="Amount" />
                                                <ComboBox Grid.Column="2"
                                                          ItemsSource="{Binding PaymentMethods}"
                                                          SelectedItem="{Binding SelectedPaymentMethod}" />
                                                <TextBox Grid.Column="4"
                                                         Text="{Binding PaymentReference}"
                                                         ToolTip="Reference" />
                                                <TextBox Grid.Column="6"
                                                         Text="{Binding PaymentNotes}"
                                                         ToolTip="Payment notes" />
                                                <Button Grid.Column="7"
                                                        Content="Record payment"
                                                        Command="{Binding RecordPaymentCommand}"
                                                        Style="{StaticResource PoPrimaryButton}"
                                                        Margin="8,0,0,0" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" Margin="0,10,0,0"/>
    </Grid>
</UserControl>
