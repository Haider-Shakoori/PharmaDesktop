<UserControl x:Class="BusinessOS.Pharmacy.Desktop.Purchasing.PurchasingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BusinessOS.Pharmacy.Desktop.Controls">

    <UserControl.Resources>
        <Style x:Key="PoCard" TargetType="Border" BasedOn="{StaticResource SurfaceCard}">
            <Setter Property="Padding" Value="14" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        </Style>

        <Style x:Key="PoSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="PoLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>

        <Style x:Key="PoHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="PoGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{DynamicResource SurfaceStrongBrush}" />
            <Setter Property="RowBackground" Value="{DynamicResource SurfaceStrongBrush}" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource SurfaceStrongBrush}" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="RowHeight" Value="28" />
            <Setter Property="ColumnHeaderHeight" Value="28" />
            <Setter Property="FontSize" Value="10.2" />
        </Style>

        <Style x:Key="PoPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="PoSecondaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SupplierSummaryCard" TargetType="Border">
            <Setter Property="BorderBrush" Value="#B8FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.12" RenderingBias="Performance" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SupplierSummaryLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SupplierSummaryValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,7,0,4" />
        </Style>
        <Style x:Key="SupplierSummaryHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="SupplierSummaryBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="SupplierTableHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Height" Value="42" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid Background="{TemplateBinding Background}">
                            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <Thumb x:Name="PART_LeftHeaderGripper" Width="5" HorizontalAlignment="Left" Background="Transparent" Cursor="SizeWE" />
                            <Thumb x:Name="PART_RightHeaderGripper" Width="5" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SupplierTableCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="FontSize" Value="12.2" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
        <Style x:Key="SupplierTableRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="44" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D9E2EC" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1"><Setter Property="Background" Value="#FAFCFF" /></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F0FDFA" /></Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0F766E" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="BorderBrush" Value="#0D9488" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SupplierTable" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="AlternationCount" Value="2" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="CellStyle" Value="{StaticResource SupplierTableCell}" />
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource SupplierTableHeader}" />
            <Setter Property="RowStyle" Value="{StaticResource SupplierTableRow}" />
        </Style>
        <Style x:Key="SupplierText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SupplierMutedText" TargetType="TextBlock" BasedOn="{StaticResource SupplierText}">
            <Setter Property="Foreground" Value="#64748B" />
        </Style>
        <Style x:Key="SupplierActionButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="Foreground" Value="#2563EB" />
            <Setter Property="Background" Value="#EFF6FF" />
            <Setter Property="BorderBrush" Value="#DBEAFE" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="Background" Value="#28FFFFFF" />
                    <Setter Property="BorderBrush" Value="#66FFFFFF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SupplierModalLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0"
                             Eyebrow="Procurement"
                             Title="{Binding Title}"
                             Description="{Binding Subtitle}">
            <controls:PageHeader.Actions>
                <Button Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource PrimaryButton}"/>
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <TabControl Grid.Row="1">
            <TabControl.Style>
                <Style TargetType="TabControl">
                    <Setter Property="Effect" Value="{x:Null}" />
                    <Setter Property="IsHitTestVisible" Value="True" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEditorOpen}" Value="True">
                            <Setter Property="IsHitTestVisible" Value="False" />
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <BlurEffect Radius="7" KernelType="Gaussian" RenderingBias="Performance" />
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TabControl.Style>
            <TabItem Header="Suppliers">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource SupplierSummaryCard}">
                            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#E8FFFFFF" Offset="0" /><GradientStop Color="#BFF0FDFF" Offset=".56" /><GradientStop Color="#A8DDF9FF" Offset="1" />
                            </LinearGradientBrush></Border.Background>
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid><TextBlock Text="{Binding TotalDealValueLabel}" Style="{StaticResource SupplierSummaryLabel}"/>
                                    <Border Style="{StaticResource SupplierSummaryBadge}" Background="#78CFFAFE"><TextBlock Text="AFN" Foreground="#0E7490" FontSize="9.5" FontWeight="Bold"/></Border></Grid>
                                <TextBlock Grid.Row="1" Text="{Binding TotalDealValueText}" Style="{StaticResource SupplierSummaryValue}"/>
                                <TextBlock Grid.Row="2" Text="{Binding TotalDealValueHint}" Style="{StaticResource SupplierSummaryHint}"/>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource SupplierSummaryCard}">
                            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#EAFFFFFF" Offset="0" /><GradientStop Color="#C9F0FDF4" Offset=".54" /><GradientStop Color="#B6D1FAE5" Offset="1" />
                            </LinearGradientBrush></Border.Background>
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid><TextBlock Text="{Binding TotalPaidLabel}" Style="{StaticResource SupplierSummaryLabel}"/>
                                    <Border Style="{StaticResource SupplierSummaryBadge}" Background="#74D1FAE5"><TextBlock Text="PAID" Foreground="#047857" FontSize="9.5" FontWeight="Bold"/></Border></Grid>
                                <TextBlock Grid.Row="1" Text="{Binding TotalPaidText}" Style="{StaticResource SupplierSummaryValue}" Foreground="#047857"/>
                                <TextBlock Grid.Row="2" Text="{Binding TotalPaidHint}" Style="{StaticResource SupplierSummaryHint}"/>
                            </Grid>
                        </Border>

                        <Border Grid.Column="4" Style="{StaticResource SupplierSummaryCard}">
                            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#EAFFFFFF" Offset="0" /><GradientStop Color="#CBEFF8FF" Offset=".52" /><GradientStop Color="#BFEDE9FE" Offset="1" />
                            </LinearGradientBrush></Border.Background>
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid><TextBlock Text="{Binding OutstandingPayableLabel}" Style="{StaticResource SupplierSummaryLabel}"/>
                                    <Border Style="{StaticResource SupplierSummaryBadge}" Background="#70E9D5FF"><TextBlock Text="DUE" Foreground="#6D28D9" FontSize="9.5" FontWeight="Bold"/></Border></Grid>
                                <TextBlock Grid.Row="1" Text="{Binding OutstandingPayableText}" Style="{StaticResource SupplierSummaryValue}" Foreground="#6D28D9"/>
                                <TextBlock Grid.Row="2" Text="{Binding OutstandingPayableHint}" Style="{StaticResource SupplierSummaryHint}"/>
                            </Grid>
                        </Border>

                        <Border Grid.Column="6" Style="{StaticResource SupplierSummaryCard}">
                            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#EAFFFFFF" Offset="0" /><GradientStop Color="#E5F8FAFC" Offset=".54" /><GradientStop Color="#D0E2E8F0" Offset="1" />
                            </LinearGradientBrush></Border.Background>
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid><TextBlock Text="{Binding OpeningBalancesLabel}" Style="{StaticResource SupplierSummaryLabel}"/>
                                    <Border Style="{StaticResource SupplierSummaryBadge}" Background="#79E2E8F0"><TextBlock Text="OPEN" Foreground="#475569" FontSize="9.5" FontWeight="Bold"/></Border></Grid>
                                <TextBlock Grid.Row="1" Text="{Binding OpeningBalancesText}" Style="{StaticResource SupplierSummaryValue}" Foreground="#475569"/>
                                <TextBlock Grid.Row="2" Text="{Binding OpeningBalancesHint}" Style="{StaticResource SupplierSummaryHint}"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1" Background="White" BorderBrush="#DCE5F0" BorderThickness="1" CornerRadius="13" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid Margin="12,12,12,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.4*" /><ColumnDefinition Width="155" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Height="38" Margin="0,0,8,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Path Data="{StaticResource IconSearch}" Width="15" Height="15" Stroke="#64748B" StrokeThickness="1.7" Fill="Transparent" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding SupplierSearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Padding="0" FontSize="12" VerticalContentAlignment="Center" ToolTip="Name, code, phone or WhatsApp"/>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Height="38" Margin="0,0,8,0">
                                    <ComboBox ItemsSource="{Binding SupplierActiveFilters}" SelectedItem="{Binding SelectedSupplierActiveFilter}" Background="Transparent" BorderThickness="0" Padding="8,0" FontSize="11.2" VerticalContentAlignment="Center"/>
                                </Border>
                                <Button Grid.Column="2" Content="Search" Command="{Binding SearchSuppliersCommand}" Style="{StaticResource SecondaryButton}" Height="38" Padding="11,7" Margin="0,0,8,0"/>
                                <Button Grid.Column="3" Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Height="38" Padding="11,7" Margin="0,0,8,0"/>
                                <Button Grid.Column="4" Command="{Binding NewSupplierCommand}" Style="{StaticResource PrimaryButton}" Height="38" Padding="14,7" Background="#1677FF" BorderBrush="#1677FF" Foreground="White">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconAdd}" Width="14" Height="14" Stroke="White" StrokeThickness="2" Fill="Transparent" Stretch="Uniform" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding NewSupplierLabel}" Foreground="White" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <DataGrid Grid.Row="1" ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}" Style="{StaticResource SupplierTable}" Margin="12,0,12,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" ElementStyle="{StaticResource SupplierText}" Width="95"/>
                                    <DataGridTemplateColumn Header="Supplier" Width="1.6*" MinWidth="180">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource SupplierText}" FontWeight="SemiBold" FontSize="12.1" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ContactPerson, TargetNullValue='No contact'}" Style="{StaticResource SupplierMutedText}" FontSize="10.2" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" ElementStyle="{StaticResource SupplierText}" Width="115"/>
                                    <DataGridTextColumn Header="City" Binding="{Binding City}" ElementStyle="{StaticResource SupplierText}" Width="95"/>
                                    <DataGridTextColumn Header="Orders" Binding="{Binding PurchaseOrderCount}" ElementStyle="{StaticResource SupplierText}" Width="70"/>
                                    <DataGridTextColumn Header="Invoices" Binding="{Binding InvoiceCount}" ElementStyle="{StaticResource SupplierText}" Width="70"/>
                                    <DataGridTemplateColumn Header="Opening balance" Width="125">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                            <TextBlock Style="{StaticResource SupplierText}"><Run Text="؋ "/><Run Text="{Binding OpeningBalance, StringFormat={}{0:N2}}"/></TextBlock>
                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Status" Width="95">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                            <Border CornerRadius="10" Padding="9,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#D1FAE5"/>
                                                    <Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="False"><Setter Property="Background" Value="#E2E8F0"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True"><Setter Property="Background" Value="#28FFFFFF"/></DataTrigger></Style.Triggers>
                                                </Style></Border.Style>
                                                <TextBlock FontSize="10.2" FontWeight="SemiBold">
                                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Active"/><Setter Property="Foreground" Value="#047857"/>
                                                        <Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="False"><Setter Property="Text" Value="Inactive"/><Setter Property="Foreground" Value="#475569"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True"><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers>
                                                    </Style></TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Actions" Width="70">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                            <Button Command="{Binding DataContext.EditSupplierCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource SupplierActionButton}" ToolTip="{Binding DataContext.EditSupplierLabel, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                                <Path Data="M4,16 L4,20 L8,20 L19,9 L15,5 Z M13.8,6.2 L17.8,10.2" Width="13" Height="13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" Fill="Transparent" Stretch="Uniform"/>
                                            </Button>
                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Grid Grid.Row="2" Margin="14,10,14,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SupplierPageSummary}" Foreground="#64748B" FontSize="11.5" VerticalAlignment="Center"/>
                                    <TextBlock Text="   Rows:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                                    <ComboBox ItemsSource="{Binding SupplierPageSizeOptions}" SelectedItem="{Binding SupplierPageSize}" Width="58" Height="28" Margin="5,0,0,0" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Previous" Command="{Binding SupplierPreviousPageCommand}" Style="{StaticResource SecondaryButton}" Height="30" MinHeight="30" Padding="10,4" FontSize="11" Margin="0,0,5,0"/>
                                    <ItemsControl ItemsSource="{Binding SupplierPageNumbers}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <Button Content="{Binding}" Command="{Binding DataContext.SupplierGoToPageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Width="30" Height="30" MinHeight="30" Padding="4" Margin="0,0,5,0" FontSize="11"/>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="Next" Command="{Binding SupplierNextPageCommand}" Style="{StaticResource SecondaryButton}" Height="30" MinHeight="30" Padding="10,4" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Purchase orders">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Style="{StaticResource PoCard}"
                            Background="{DynamicResource SurfaceStrongBrush}"
                            Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="40"
                                    Height="40"
                                    CornerRadius="11"
                                    Background="{DynamicResource BrandPrimarySoftBrush}">
                                <Path Data="{StaticResource IconPurchases}"
                                      Width="20"
                                      Height="20"
                                      Stroke="{DynamicResource BrandPrimaryBrush}"
                                      StrokeThickness="1.9"
                                      Fill="Transparent"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="11,0,0,0">
                                <TextBlock Text="Simple purchase workflow"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Prepare the medicine list, enter payment (0 is allowed), then save. The PO, supplier balance and inventory are updated together."
                                           Style="{StaticResource PoHint}"
                                           Margin="0,3,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.82*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="1.55*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource PoCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Margin="0,0,0,9">
                                    <TextBlock Text="Purchase history" Style="{StaticResource PoSectionTitle}" />
                                    <TextBlock Text="Saved purchases and their supplier balances."
                                               Style="{StaticResource PoHint}"
                                               Margin="0,2,0,0" />
                                </StackPanel>

                                <Grid Grid.Row="1" Margin="0,0,0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding OrderSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="9,6"
                                             Margin="0,0,7,0"
                                             ToolTip="PO number or supplier" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding OrderStatuses}"
                                              SelectedItem="{Binding SelectedOrderStatus}"
                                              Margin="0,0,7,0" />
                                    <Button Grid.Column="2"
                                            Content="Search"
                                            Command="{Binding SearchOrdersCommand}"
                                            Style="{StaticResource PoSecondaryButton}" />
                                </Grid>

                                <DataGrid Grid.Row="2"
                                          ItemsSource="{Binding Orders}"
                                          SelectedItem="{Binding SelectedOrder}"
                                          Style="{StaticResource PoGrid}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="PO" Binding="{Binding Number}" Width="118" />
                                        <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="*" />
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="82" />
                                        <DataGridTextColumn Header="Total" Binding="{Binding GrandTotal, StringFormat=N2}" Width="80" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Column="2"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Border Style="{StaticResource PoCard}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Prepare purchase" Style="{StaticResource PoSectionTitle}" />
                                                <TextBlock Text="Add the items you are buying. Batch and expiry are entered here when the medicine requires them."
                                                           Style="{StaticResource PoHint}"
                                                           Margin="0,2,0,0"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Background="{DynamicResource PosPrimarySoftBrush}"
                                                    CornerRadius="8"
                                                    Padding="9,4">
                                                <TextBlock Text="{Binding DraftSummary}"
                                                           Foreground="{DynamicResource PosPrimaryBrush}"
                                                           FontSize="9.5"
                                                           FontWeight="Bold" />
                                            </Border>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.6*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="0.8*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Supplier" Style="{StaticResource PoLabel}" />
                                                <ComboBox ItemsSource="{Binding SupplierReferences}"
                                                          SelectedItem="{Binding SelectedOrderSupplier}"
                                                          DisplayMemberPath="Name"
                                                          Margin="0,4,0,8" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Purchase date" Style="{StaticResource PoLabel}" />
                                                <TextBox Text="{Binding OrderDateText}" Margin="0,4,0,8" />
                                            </StackPanel>
                                        </Grid>

                                        <Border Background="{DynamicResource SurfaceMutedBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="10"
                                                Margin="0,1,0,8">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.5*" />
                                                        <ColumnDefinition Width="7" />
                                                        <ColumnDefinition Width="0.45*" />
                                                        <ColumnDefinition Width="7" />
                                                        <ColumnDefinition Width="0.6*" />
                                                        <ColumnDefinition Width="7" />
                                                        <ColumnDefinition Width="0.55*" />
                                                        <ColumnDefinition Width="7" />
                                                        <ColumnDefinition Width="0.55*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Medicine" Style="{StaticResource PoLabel}" />
                                                        <ComboBox ItemsSource="{Binding MedicineReferences}"
                                                                  SelectedItem="{Binding SelectedDraftMedicine}"
                                                                  DisplayMemberPath="BrandName"
                                                                  Margin="0,4,0,8" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Qty" Style="{StaticResource PoLabel}" />
                                                        <TextBox Text="{Binding DraftQuantity}" Margin="0,4,0,8" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="4">
                                                        <TextBlock Text="Unit cost" Style="{StaticResource PoLabel}" />
                                                        <TextBox Text="{Binding DraftUnitCost}" Margin="0,4,0,8" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="6">
                                                        <TextBlock Text="Discount" Style="{StaticResource PoLabel}" />
                                                        <TextBox Text="{Binding DraftDiscount}" Margin="0,4,0,8" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="8">
                                                        <TextBlock Text="Landed cost" Style="{StaticResource PoLabel}" />
                                                        <TextBox Text="{Binding DraftLandedCost}" Margin="0,4,0,8" />
                                                    </StackPanel>
                                                </Grid>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1*" />
                                                        <ColumnDefinition Width="7" />
                                                        <ColumnDefinition Width="1*" />
                                                        <ColumnDefinition Width="7" />
                                                        <ColumnDefinition Width="1*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Batch" Style="{StaticResource PoLabel}" />
                                                        <TextBox Text="{Binding DraftBatchNumber}"
                                                                 Margin="0,4,0,0"
                                                                 ToolTip="Required only for batch-tracked medicines" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Expiry" Style="{StaticResource PoLabel}" />
                                                        <TextBox Text="{Binding DraftExpiresAtText}"
                                                                 Margin="0,4,0,0"
                                                                 ToolTip="yyyy-MM-dd; required only for expiry-tracked medicines" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="4">
                                                        <TextBlock Text="Sale price (optional)" Style="{StaticResource PoLabel}" />
                                                        <TextBox Text="{Binding DraftSalePrice}" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                    <Button Grid.Column="5"
                                                            Content="+ Add item"
                                                            Command="{Binding AddDraftLineCommand}"
                                                            Style="{StaticResource PoSecondaryButton}"
                                                            Margin="8,19,0,0" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <DataGrid ItemsSource="{Binding DraftLines}"
                                                  Style="{StaticResource PoGrid}"
                                                  Height="155">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Medicine" Binding="{Binding MedicineLabel}" Width="*" />
                                                <DataGridTextColumn Header="Qty" Binding="{Binding OrderedQuantity, StringFormat=N2}" Width="55" />
                                                <DataGridTextColumn Header="Cost" Binding="{Binding UnitCost, StringFormat=N2}" Width="62" />
                                                <DataGridTextColumn Header="Batch" Binding="{Binding BatchNumber}" Width="88" />
                                                <DataGridTextColumn Header="Expiry" Binding="{Binding ExpiresAt, StringFormat=yyyy-MM-dd}" Width="82" />
                                                <DataGridTextColumn Header="Total" Binding="{Binding LineTotal, StringFormat=N2}" Width="74" />
                                                <DataGridTemplateColumn Header="" Width="34">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="×"
                                                                    Command="{Binding DataContext.RemoveDraftLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                    CommandParameter="{Binding}"
                                                                    Background="Transparent"
                                                                    BorderBrush="Transparent"
                                                                    Foreground="{DynamicResource DangerBrush}"
                                                                    FontSize="16"
                                                                    FontWeight="Bold"
                                                                    Padding="2" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <TextBox Text="{Binding OrderNotes}"
                                                 ToolTip="Purchase notes (optional)"
                                                 MinHeight="38"
                                                 Margin="0,9,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource PoCard}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Payment" Style="{StaticResource PoSectionTitle}" />
                                                <TextBlock Text="Enter how much you are paying now. Enter 0 to save the full purchase as supplier payable."
                                                           Style="{StaticResource PoHint}"
                                                           Margin="0,2,0,0"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding DraftTotal, StringFormat=AFN {0:N2}}"
                                                       FontSize="17"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource PosPrimaryBrush}"
                                                       VerticalAlignment="Center" />
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="0.8*" />
                                                <ColumnDefinition Width="7" />
                                                <ColumnDefinition Width="0.8*" />
                                                <ColumnDefinition Width="7" />
                                                <ColumnDefinition Width="1.2*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Payment amount" Style="{StaticResource PoLabel}" />
                                                <TextBox Text="{Binding PaymentAmount}" Margin="0,4,0,8" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Method" Style="{StaticResource PoLabel}" />
                                                <ComboBox ItemsSource="{Binding PaymentMethods}"
                                                          SelectedItem="{Binding SelectedPaymentMethod}"
                                                          Margin="0,4,0,8" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="Reference (optional)" Style="{StaticResource PoLabel}" />
                                                <TextBox Text="{Binding PaymentReference}" Margin="0,4,0,8" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBox Text="{Binding PaymentNotes}"
                                                 ToolTip="Payment / purchase note"
                                                 MinHeight="38"
                                                 Margin="0,0,0,9" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Saving will immediately increase inventory in the default active stock location."
                                                       Style="{StaticResource PoHint}"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,12,0" />
                                            <Button Grid.Column="1"
                                                    Content="Save purchase &amp; update inventory"
                                                    Command="{Binding SavePurchaseCommand}"
                                                    Style="{StaticResource PoPrimaryButton}"
                                                    Padding="16,9" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource PoCard}" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Selected purchase" Style="{StaticResource PoSectionTitle}" />
                                        <TextBlock Text="{Binding SelectedOrderDetail.Order.Number}"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Margin="0,5,0,2" />
                                        <TextBlock Text="{Binding SelectedOrderDetail.Order.SupplierName}"
                                                   Style="{StaticResource PoHint}" />
                                        <DataGrid ItemsSource="{Binding SelectedOrderDetail.Lines}"
                                                  Style="{StaticResource PoGrid}"
                                                  Height="120"
                                                  Margin="0,8,0,0">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Medicine" Binding="{Binding Description}" Width="*" />
                                                <DataGridTextColumn Header="Qty" Binding="{Binding OrderedQuantity, StringFormat=N2}" Width="65" />
                                                <DataGridTextColumn Header="Cost" Binding="{Binding UnitCost, StringFormat=N2}" Width="70" />
                                                <DataGridTextColumn Header="Total" Binding="{Binding LineTotal, StringFormat=N2}" Width="75" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.RowSpan="3"
              Panel.ZIndex="70"
              Visibility="{Binding IsEditorOpen, Converter={StaticResource GlobalBoolToVisibility}}">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#70F8FAFC" Offset="0" />
                    <GradientStop Color="#60E9EFF7" Offset="0.55" />
                    <GradientStop Color="#72FFFFFF" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>

            <Border Width="930"
                    MaxWidth="930"
                    MaxHeight="740"
                    Margin="28"
                    Background="White"
                    BorderBrush="#D8E2EE"
                    BorderThickness="1"
                    CornerRadius="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity="0.18" RenderingBias="Performance" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="22,18,18,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding SupplierEditorTitle}" FontSize="19" FontWeight="SemiBold" Foreground="#0F172A"/>
                            <TextBlock Text="{Binding SupplierSubtitle}" FontSize="11.5" Foreground="#64748B" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Command="{Binding CloseSupplierEditorCommand}" Style="{StaticResource GhostButton}" Foreground="#475569" Width="32" Height="32" Padding="0" FontSize="14"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="22,12,22,18">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Supplier code" Style="{StaticResource SupplierModalLabel}"/>
                                <TextBox Text="{Binding SupplierCode, UpdateSourceTrigger=PropertyChanged}" MinHeight="38" Padding="9,6" Margin="0,0,0,12"/>
                                <TextBlock Text="Supplier name" Style="{StaticResource SupplierModalLabel}"/>
                                <TextBox Text="{Binding SupplierName, UpdateSourceTrigger=PropertyChanged}" MinHeight="38" Padding="9,6" Margin="0,0,0,12"/>
                                <TextBlock Text="Contact person" Style="{StaticResource SupplierModalLabel}"/>
                                <TextBox Text="{Binding SupplierContactPerson, UpdateSourceTrigger=PropertyChanged}" MinHeight="38" Padding="9,6" Margin="0,0,0,12"/>

                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Phone" Style="{StaticResource SupplierModalLabel}"/>
                                        <TextBox Text="{Binding SupplierPhone, UpdateSourceTrigger=PropertyChanged}" MinHeight="38" Padding="9,6"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="WhatsApp" Style="{StaticResource SupplierModalLabel}"/>
                                        <TextBox Text="{Binding SupplierWhatsapp, UpdateSourceTrigger=PropertyChanged}" MinHeight="38" Padding="9,6"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Email" Style="{StaticResource SupplierModalLabel}" Margin="0,12,0,5"/>
                                <TextBox Text="{Binding SupplierEmail, UpdateSourceTrigger=PropertyChanged}" MinHeight="38" Padding="9,6"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Opening balance (AFN)" Style="{StaticResource SupplierModalLabel}"/>
                                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Height="38" Margin="0,0,0,5" IsEnabled="{Binding CanEditSupplierOpeningBalance}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="؋" Foreground="#6D28D9" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding SupplierOpeningBalance, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Padding="0" VerticalContentAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <TextBlock Text="Opening balance is entered when the supplier is created and is kept unchanged on later edits."
                                           Foreground="#64748B" FontSize="10.2" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Payment terms (days)" Style="{StaticResource SupplierModalLabel}"/>
                                        <TextBox Text="{Binding SupplierPaymentTermsDays, UpdateSourceTrigger=PropertyChanged}" MinHeight="38" Padding="9,6"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="City" Style="{StaticResource SupplierModalLabel}"/>
                                        <TextBox Text="{Binding SupplierCity, UpdateSourceTrigger=PropertyChanged}" MinHeight="38" Padding="9,6"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Province" Style="{StaticResource SupplierModalLabel}" Margin="0,12,0,5"/>
                                <TextBox Text="{Binding SupplierProvince, UpdateSourceTrigger=PropertyChanged}" MinHeight="38" Padding="9,6" Margin="0,0,0,12"/>
                                <TextBlock Text="Address" Style="{StaticResource SupplierModalLabel}"/>
                                <TextBox Text="{Binding SupplierAddress, UpdateSourceTrigger=PropertyChanged}" MinHeight="38" Padding="9,6" Margin="0,0,0,12"/>
                                <TextBlock Text="Notes" Style="{StaticResource SupplierModalLabel}"/>
                                <TextBox Text="{Binding SupplierNotes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" Padding="9,6" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>
                                <CheckBox Content="Active supplier" IsChecked="{Binding SupplierIsActive}" Foreground="#334155" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Background="#F8FAFC" Padding="18,12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding StatusMessage}" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Cancel" Command="{Binding CloseSupplierEditorCommand}" Style="{StaticResource SecondaryButton}" Foreground="#334155" Height="36" Padding="13,6" Margin="0,0,8,0"/>
                                <Button Content="{Binding SaveSupplierLabel}" Command="{Binding SaveSupplierCommand}" Style="{StaticResource PrimaryButton}" Foreground="White" Height="36" Padding="14,6"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" Margin="0,10,0,0"/>
    </Grid>
</UserControl>
