<UserControl x:Class="BusinessOS.Pharmacy.Desktop.Purchasing.PurchasingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleText}"/>
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}"
                    Style="{StaticResource PrimaryButton}" Padding="14,8"/>
        </Grid>

        <TabControl Grid.Row="1">
            <TabItem Header="Suppliers">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="0.95*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SurfaceCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding SupplierSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="9,7" Margin="0,0,8,0"
                                         ToolTip="Name, code, phone or WhatsApp"/>
                                <Button Grid.Column="1" Content="Search" Command="{Binding SearchSuppliersCommand}" Padding="14,8"/>
                            </Grid>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding Suppliers}"
                                      SelectedItem="{Binding SelectedSupplier}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="90"/>
                                    <DataGridTextColumn Header="Supplier" Binding="{Binding Name}" Width="1.4*"/>
                                    <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="110"/>
                                    <DataGridTextColumn Header="City" Binding="{Binding City}" Width="90"/>
                                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="65"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource SurfaceCard}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Supplier editor" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                                <TextBlock Text="Code"/>
                                <TextBox Text="{Binding SupplierCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>

                                <TextBlock Text="Name"/>
                                <TextBox Text="{Binding SupplierName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Contact person"/>
                                        <TextBox Text="{Binding SupplierContactPerson}" Margin="0,4,0,8"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Payment terms (days)"/>
                                        <TextBox Text="{Binding SupplierPaymentTermsDays}" Margin="0,4,0,8"/>
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Phone"/>
                                        <TextBox Text="{Binding SupplierPhone}" Margin="0,4,0,8"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="WhatsApp"/>
                                        <TextBox Text="{Binding SupplierWhatsapp}" Margin="0,4,0,8"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Email"/>
                                <TextBox Text="{Binding SupplierEmail}" Margin="0,4,0,8"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="City"/>
                                        <TextBox Text="{Binding SupplierCity}" Margin="0,4,0,8"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Province"/>
                                        <TextBox Text="{Binding SupplierProvince}" Margin="0,4,0,8"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Address"/>
                                <TextBox Text="{Binding SupplierAddress}" Margin="0,4,0,8"/>

                                <TextBlock Text="Notes"/>
                                <TextBox Text="{Binding SupplierNotes}" AcceptsReturn="True" Height="70" Margin="0,4,0,8"/>

                                <CheckBox Content="Active" IsChecked="{Binding SupplierIsActive}" Margin="0,0,0,12"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="New" Command="{Binding NewSupplierCommand}" Padding="14,8" Margin="0,0,8,0"/>
                                    <Button Content="Save supplier" Command="{Binding SaveSupplierCommand}"
                                            Style="{StaticResource PrimaryButton}" Padding="14,8"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Purchase orders">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource SurfaceCard}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding OrderSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="9,7" Margin="0,0,8,0" ToolTip="PO number or supplier"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding OrderStatuses}"
                                      SelectedItem="{Binding SelectedOrderStatus}" Margin="0,0,8,0"/>
                            <Button Grid.Column="2" Content="Search" Command="{Binding SearchOrdersCommand}" Padding="14,8"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.8*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource SurfaceCard}">
                            <DataGrid ItemsSource="{Binding Orders}"
                                      SelectedItem="{Binding SelectedOrder}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Number" Binding="{Binding Number}" Width="150"/>
                                    <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="1.2*"/>
                                    <DataGridTextColumn Header="Date" Binding="{Binding OrderDate, StringFormat=yyyy-MM-dd}" Width="95"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="115"/>
                                    <DataGridTextColumn Header="Total" Binding="{Binding GrandTotal, StringFormat=N4}" Width="95"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="New purchase order" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.4*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Supplier"/>
                                                <ComboBox ItemsSource="{Binding SupplierReferences}"
                                                          SelectedItem="{Binding SelectedOrderSupplier}"
                                                          DisplayMemberPath="Name" Margin="0,4,0,8"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Order date"/>
                                                <TextBox Text="{Binding OrderDateText}" Margin="0,4,0,8"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="Expected date"/>
                                                <TextBox Text="{Binding ExpectedDateText}" Margin="0,4,0,8"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Medicine"/>
                                                <ComboBox ItemsSource="{Binding MedicineReferences}"
                                                          SelectedItem="{Binding SelectedDraftMedicine}"
                                                          DisplayMemberPath="BrandName" Margin="0,4,0,8"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Qty"/>
                                                <TextBox Text="{Binding DraftQuantity}" Margin="0,4,0,8"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="Unit cost"/>
                                                <TextBox Text="{Binding DraftUnitCost}" Margin="0,4,0,8"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="6">
                                                <TextBlock Text="Discount"/>
                                                <TextBox Text="{Binding DraftDiscount}" Margin="0,4,0,8"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Landed cost"/>
                                                <TextBox Text="{Binding DraftLandedCost}" Margin="0,4,0,8"/>
                                            </StackPanel>
                                            <TextBox Grid.Column="2" Text="{Binding OrderNotes}" Margin="0,20,8,8"
                                                     ToolTip="Purchase order notes"/>
                                            <Button Grid.Column="3" Content="Add line" Command="{Binding AddDraftLineCommand}"
                                                    Margin="0,20,0,8" Padding="12,7"/>
                                        </Grid>

                                        <DataGrid ItemsSource="{Binding DraftLines}" AutoGenerateColumns="False"
                                                  IsReadOnly="True" CanUserAddRows="False" Height="135">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Medicine" Binding="{Binding MedicineLabel}" Width="1.4*"/>
                                                <DataGridTextColumn Header="Qty" Binding="{Binding OrderedQuantity, StringFormat=N4}" Width="75"/>
                                                <DataGridTextColumn Header="Cost" Binding="{Binding UnitCost, StringFormat=N4}" Width="85"/>
                                                <DataGridTextColumn Header="Discount" Binding="{Binding DiscountAmount, StringFormat=N4}" Width="85"/>
                                                <DataGridTextColumn Header="Landed" Binding="{Binding LandedCostAllocated, StringFormat=N4}" Width="85"/>
                                                <DataGridTextColumn Header="Total" Binding="{Binding LineTotal, StringFormat=N4}" Width="90"/>
                                                <DataGridTemplateColumn Header="" Width="70">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="Remove"
                                                                    Command="{Binding DataContext.RemoveDraftLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Content="Create PO" Command="{Binding CreateOrderCommand}"
                                                    Style="{StaticResource PrimaryButton}" Padding="14,8" Margin="0,0,8,0"/>
                                            <Button Content="Clear lines" Command="{Binding ClearDraftLinesCommand}" Padding="14,8"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Selected order" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding SelectedOrderDetail.Order.Number}" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                        <TextBlock Text="{Binding SelectedOrderDetail.Order.SupplierName}" Style="{StaticResource MutedText}"/>
                                        <TextBlock Text="{Binding SelectedOrderDetail.Order.Status}" Margin="0,4,0,10"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Button Content="Submit" Command="{Binding SubmitOrderCommand}" Padding="12,7" Margin="0,0,8,0"/>
                                            <Button Content="Approve" Command="{Binding ApproveOrderCommand}" Padding="12,7" Margin="0,0,8,0"/>
                                            <Button Content="Cancel" Command="{Binding CancelOrderCommand}" Padding="12,7"/>
                                        </StackPanel>

                                        <DataGrid ItemsSource="{Binding SelectedOrderDetail.Lines}"
                                                  SelectedItem="{Binding SelectedOrderLine}"
                                                  AutoGenerateColumns="False" IsReadOnly="True"
                                                  CanUserAddRows="False" Height="150">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Medicine" Binding="{Binding Description}" Width="1.4*"/>
                                                <DataGridTextColumn Header="Ordered" Binding="{Binding OrderedQuantity, StringFormat=N4}" Width="80"/>
                                                <DataGridTextColumn Header="Received" Binding="{Binding ReceivedQuantity, StringFormat=N4}" Width="80"/>
                                                <DataGridTextColumn Header="Cost" Binding="{Binding UnitCost, StringFormat=N4}" Width="80"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Receive selected PO line" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Received qty"/>
                                                <TextBox Text="{Binding ReceiptQuantity}" Margin="0,4,0,8"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Bonus qty"/>
                                                <TextBox Text="{Binding ReceiptBonusQuantity}" Margin="0,4,0,8"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="Batch"/>
                                                <TextBox Text="{Binding ReceiptBatchNumber}" Margin="0,4,0,8"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Manufactured"/>
                                                <TextBox Text="{Binding ManufacturedAtText}" Margin="0,4,0,8" ToolTip="yyyy-MM-dd"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Expiry"/>
                                                <TextBox Text="{Binding ExpiresAtText}" Margin="0,4,0,8" ToolTip="yyyy-MM-dd"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="Unit cost"/>
                                                <TextBox Text="{Binding ReceiptUnitCost}" Margin="0,4,0,8"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="6">
                                                <TextBlock Text="Sale price"/>
                                                <TextBox Text="{Binding ReceiptSalePrice}" Margin="0,4,0,8"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBox Text="{Binding ReceiptNotes}" ToolTip="Receipt notes" Margin="0,0,0,8"/>
                                        <Button Content="Capture goods receipt" Command="{Binding CaptureReceiptCommand}"
                                                Style="{StaticResource PrimaryButton}" Padding="14,8" HorizontalAlignment="Left"/>

                                        <DataGrid ItemsSource="{Binding SelectedOrderDetail.Receipts}"
                                                  SelectedItem="{Binding SelectedReceipt}"
                                                  AutoGenerateColumns="False" IsReadOnly="True"
                                                  CanUserAddRows="False" Height="125" Margin="0,12,0,8">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Receipt" Binding="{Binding ReceiptNumber}" Width="170"/>
                                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                                                <DataGridTextColumn Header="Received" Binding="{Binding ReceivedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="130"/>
                                                <DataGridTextColumn Header="Location" Binding="{Binding StockLocationName}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <StackPanel Orientation="Horizontal">
                                            <ComboBox Width="230" ItemsSource="{Binding StockLocations}"
                                                      SelectedItem="{Binding SelectedStockLocation}"
                                                      DisplayMemberPath="Name" Margin="0,0,8,0"/>
                                            <Button Content="Post selected receipt to inventory"
                                                    Command="{Binding PostReceiptCommand}" Padding="14,8"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SurfaceCard}">
                                    <StackPanel>
                                        <TextBlock Text="Supplier invoice &amp; payment" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Supplier invoice #"/>
                                                <TextBox Text="{Binding SupplierInvoiceNumber}" Margin="0,4,0,8"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Invoice date"/>
                                                <TextBox Text="{Binding InvoiceDateText}" Margin="0,4,0,8"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="Due date"/>
                                                <TextBox Text="{Binding InvoiceDueDateText}" Margin="0,4,0,8"/>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Orientation="Horizontal">
                                            <ComboBox Width="250" ItemsSource="{Binding SelectedOrderDetail.Receipts}"
                                                      SelectedItem="{Binding SelectedInvoiceReceipt}"
                                                      DisplayMemberPath="ReceiptNumber" Margin="0,0,8,0"/>
                                            <TextBox Width="250" Text="{Binding InvoiceNotes}" ToolTip="Invoice notes" Margin="0,0,8,0"/>
                                            <Button Content="Record invoice" Command="{Binding CreateInvoiceCommand}" Padding="14,8"/>
                                        </StackPanel>

                                        <DataGrid ItemsSource="{Binding SelectedOrderDetail.Invoices}"
                                                  SelectedItem="{Binding SelectedInvoice}"
                                                  AutoGenerateColumns="False" IsReadOnly="True"
                                                  CanUserAddRows="False" Height="125" Margin="0,12,0,8">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNumber}" Width="170"/>
                                                <DataGridTextColumn Header="Supplier #" Binding="{Binding SupplierInvoiceNumber}" Width="120"/>
                                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="105"/>
                                                <DataGridTextColumn Header="Total" Binding="{Binding GrandTotal, StringFormat=N4}" Width="90"/>
                                                <DataGridTextColumn Header="Balance" Binding="{Binding BalanceDue, StringFormat=N4}" Width="90"/>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding PaymentAmount}" ToolTip="Amount"/>
                                            <ComboBox Grid.Column="2" ItemsSource="{Binding PaymentMethods}"
                                                      SelectedItem="{Binding SelectedPaymentMethod}"/>
                                            <TextBox Grid.Column="4" Text="{Binding PaymentReference}" ToolTip="Reference"/>
                                            <TextBox Grid.Column="6" Text="{Binding PaymentNotes}" ToolTip="Payment notes"/>
                                            <Button Grid.Column="7" Content="Record payment" Command="{Binding RecordPaymentCommand}"
                                                    Padding="14,8" Margin="8,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" Margin="0,10,0,0"/>
    </Grid>
</UserControl>
