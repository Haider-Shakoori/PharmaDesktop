<Window x:Class="BusinessOS.Pharmacy.Desktop.Pos.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Darmaltoon;component/Assets/Darmaltoon.ico"
        Title="Payment · Darmaltoon POS"
        Width="720"
        Height="760"
        MinWidth="660"
        MinHeight="650"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Background="#F1F5F9"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="PayTeal" Color="#0F766E" />
        <SolidColorBrush x:Key="PayTealSoft" Color="#ECFDF5" />
        <SolidColorBrush x:Key="PaySlate" Color="#0F172A" />
        <SolidColorBrush x:Key="PayMuted" Color="#64748B" />

        <Style x:Key="PaymentCard" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="PaymentLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{StaticResource PayMuted}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="0,0,0,1"
                Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Payment"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#0F172A" />
                    <TextBlock Text="Review the amount, choose payment method, then complete the sale."
                               FontSize="10.5"
                               Foreground="#64748B"
                               Margin="0,3,0,0" />
                </StackPanel>
                <Border Grid.Column="1"
                        Background="#ECFDF5"
                        CornerRadius="10"
                        Padding="12,7"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding CartLineCountText}"
                               Foreground="#0F766E"
                               FontSize="10.5"
                               FontWeight="Bold" />
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="18">
                <Border Style="{StaticResource PaymentCard}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Amount due"
                                       Style="{StaticResource PaymentLabel}" />
                            <TextBlock Text="{Binding EstimatedGrandTotal, StringFormat=AFN {0:N2}}"
                                       FontSize="30"
                                       FontWeight="Black"
                                       Foreground="#0F172A"
                                       Margin="0,2,0,0" />
                            <TextBlock FontSize="10"
                                       Foreground="#64748B"
                                       Margin="0,4,0,0">
                                <Run Text="Customer: " />
                                <Run Text="{Binding PaymentCustomerText}" />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Width="190"
                                    VerticalAlignment="Center">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Subtotal" Style="{StaticResource PaymentLabel}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Subtotal, StringFormat=AFN {0:N2}}"
                                           FontWeight="SemiBold" />
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Discount" Style="{StaticResource PaymentLabel}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DiscountTotal, StringFormat=AFN {0:N2}}"
                                           FontWeight="SemiBold" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Balance" Style="{StaticResource PaymentLabel}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding PaymentBalanceText}"
                                           FontWeight="Bold"
                                           Foreground="#0F766E" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource PaymentCard}" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Payment methods"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="#0F172A" />
                                <TextBlock Text="Split payment across cash, bank, mobile or credit when needed."
                                           Style="{StaticResource PaymentLabel}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="+ Split payment"
                                    Command="{Binding AddSplitPaymentCommand}"
                                    Style="{StaticResource GhostButton}"
                                    Foreground="#0F766E"
                                    FontWeight="Bold"
                                    Padding="8,5" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Payments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFC"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="10"
                                            Margin="0,0,0,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="34" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Margin="0,0,8,0">
                                                <TextBlock Text="Method" Style="{StaticResource PaymentLabel}" />
                                                <ComboBox ItemsSource="{Binding DataContext.PaymentMethods, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          SelectedItem="{Binding Method, UpdateSourceTrigger=PropertyChanged}"
                                                          Margin="0,4,0,0"
                                                          MinHeight="36" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                <TextBlock Text="Amount" Style="{StaticResource PaymentLabel}" />
                                                <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"
                                                         Margin="0,4,0,0"
                                                         MinHeight="36"
                                                         Padding="8,6"
                                                         TextAlignment="Right"
                                                         FontWeight="SemiBold" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                                <TextBlock Text="Reference" Style="{StaticResource PaymentLabel}" />
                                                <TextBox Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}"
                                                         Margin="0,4,0,0"
                                                         MinHeight="36"
                                                         Padding="8,6" />
                                            </StackPanel>

                                            <Button Grid.Column="3"
                                                    Content="×"
                                                    Command="{Binding DataContext.RemovePaymentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Width="30"
                                                    Height="30"
                                                    MinHeight="30"
                                                    Padding="0"
                                                    Margin="0,20,0,0"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    Foreground="#DC2626"
                                                    FontSize="18"
                                                    FontWeight="Bold" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Margin="0,3,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Content="Set cash to total"
                                    Command="{Binding SetCashToTotalCommand}"
                                    Style="{StaticResource GhostButton}"
                                    Foreground="#0F766E"
                                    FontWeight="Bold"
                                    Padding="6,4"
                                    HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding PaymentBalanceText}"
                                       Foreground="#475569"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="#F0FDF4"
                        BorderBrush="#BBF7D0"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="13"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="34"
                                Height="34"
                                CornerRadius="17"
                                Background="#DCFCE7"
                                VerticalAlignment="Center">
                            <TextBlock Text="✓"
                                       Foreground="#16A34A"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1"
                                    Margin="10,0,10,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Print invoice after payment"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#14532D" />
                            <TextBlock Text="Uses the default Windows printer. Leave unchecked to finish the sale without printing."
                                       FontSize="9.5"
                                       Foreground="#4D7C5A"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="2"
                                  IsChecked="{Binding PrintInvoiceAfterPayment}"
                                  VerticalAlignment="Center"
                                  ToolTip="Print invoice automatically after the sale completes" />
                    </Grid>
                </Border>

                <Border Background="#EFF6FF"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10">
                    <TextBlock FontSize="9.5"
                               Foreground="#1E40AF"
                               TextWrapping="Wrap">
                        <Run Text="Shortcuts: " FontWeight="Bold" />
                        <Run Text="Enter / Ctrl+Enter = complete payment · F5 = exact cash · Esc = cancel" />
                    </TextBlock>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,0"
                Padding="18,13">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Content="Cancel"
                        Click="OnCancelClick"
                        Style="{StaticResource SecondaryButton}"
                        MinWidth="92"
                        Margin="0,0,10,0" />

                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           Foreground="#64748B"
                           FontSize="9.5"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />

                <Button Grid.Column="2"
                        Command="{Binding CheckoutCommand}"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="205"
                        MinHeight="46"
                        HorizontalContentAlignment="Stretch">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Complete payment"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding EstimatedGrandTotal, StringFormat=AFN {0:N2}}"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
