<UserControl x:Class="BusinessOS.Pharmacy.Desktop.Pos.PosView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="900"
             Background="#F1F5F9">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PosPrimaryBrush" Color="#0F766E" />
        <SolidColorBrush x:Key="PosPrimaryDarkBrush" Color="#115E59" />
        <SolidColorBrush x:Key="PosPrimarySoftBrush" Color="#ECFDF5" />
        <SolidColorBrush x:Key="PosBorderBrush" Color="#E2E8F0" />
        <SolidColorBrush x:Key="PosMutedBrush" Color="#64748B" />
        <SolidColorBrush x:Key="PosHeadingBrush" Color="#0F172A" />

        <Style x:Key="PosCard" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource PosBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style x:Key="PosSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource PosHeadingBrush}" />
        </Style>

        <Style x:Key="PosCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{StaticResource PosMutedBrush}" />
        </Style>

        <Style x:Key="PosPrimaryButton" TargetType="Button" BasedOn="{StaticResource ProfessionalButtonBase}">
            <Setter Property="Background" Value="{StaticResource PosPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PosPrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinHeight" Value="38" />
        </Style>

        <Style x:Key="PosOutlineButton" TargetType="Button" BasedOn="{StaticResource ProfessionalButtonBase}">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="MinHeight" Value="36" />
        </Style>

        <Style x:Key="PosDangerIconButton" TargetType="Button" BasedOn="{StaticResource ProfessionalButtonBase}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="#DC2626" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
        </Style>

        <Style x:Key="PosMiniInput" TargetType="TextBox" BasedOn="{StaticResource FieldTextBox}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>

        <Style x:Key="PosGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="RowBackground" Value="White" />
            <Setter Property="AlternatingRowBackground" Value="#FBFDFF" />
            <Setter Property="HorizontalGridLinesBrush" Value="#EEF2F7" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="RowHeight" Value="28" />
            <Setter Property="ColumnHeaderHeight" Value="28" />
            <Setter Property="FontSize" Value="10.5" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Web POS parity header -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="{StaticResource PosBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40"
                            Height="40"
                            CornerRadius="10"
                            Background="#0F172A">
                        <TextBlock Text="Rx"
                                   Foreground="White"
                                   FontWeight="Black"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DataContext.Dashboard.PharmacyName, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#0F172A" />
                        <TextBlock Text="{Binding WorkspaceSubtitle}"
                                   FontSize="10.5"
                                   Foreground="#64748B"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <ComboBox Width="238"
                              ItemsSource="{Binding StockLocations}"
                              SelectedItem="{Binding SelectedLocation}"
                              DisplayMemberPath="Name"
                              ToolTip="{Binding LocationLabel}"
                              Margin="0,0,8,0" />
                    <Button Content="Refresh"
                            Command="{Binding LoadCommand}"
                            Style="{StaticResource PosOutlineButton}"
                            Margin="0,0,8,0" />
                    <Button Content="Exit POS"
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="dashboard"
                            Background="#0F172A"
                            BorderBrush="#0F172A"
                            Foreground="White"
                            FontWeight="Bold"
                            Padding="13,8"
                            MinHeight="36" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="430" />
            </Grid.ColumnDefinitions>

            <!-- Main sale workspace -->
            <Grid Grid.Column="0"
                  Background="#F8FAFC">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Scanner/search bar -->
                <Border Grid.Row="0"
                        Background="White"
                        BorderBrush="{StaticResource PosBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="14,12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid>
                                <Border Background="White"
                                        BorderBrush="#CBD5E1"
                                        BorderThickness="1"
                                        CornerRadius="11">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Path Data="{StaticResource IconSearch}"
                                              Width="16"
                                              Height="16"
                                              Stroke="#64748B"
                                              StrokeThickness="1.8"
                                              Fill="Transparent"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                        <Grid Grid.Column="1">
                                            <TextBlock Text="{Binding SearchLabel}"
                                                       Foreground="#94A3B8"
                                                       FontSize="12.5"
                                                       VerticalAlignment="Center"
                                                       IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBox x:Name="SearchBox"
                                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource SearchTextBox}"
                                                     MinHeight="44"
                                                     FontSize="13.5"
                                                     VerticalContentAlignment="Center"
                                                     BorderThickness="0"
                                                     Background="Transparent">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Enter"
                                                                Command="{Binding SearchCommand}" />
                                                </TextBox.InputBindings>
                                            </TextBox>
                                        </Grid>
                                        <Border Grid.Column="2"
                                                Background="#ECFDF5"
                                                CornerRadius="7"
                                                Padding="8,4"
                                                Margin="4"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="Scanner ready"
                                                       Foreground="#0F766E"
                                                       FontSize="9.5"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <Popup PlacementTarget="{Binding ElementName=SearchBox}"
                                       Placement="Bottom"
                                       IsOpen="{Binding IsSearchDropdownOpen, Mode=TwoWay}"
                                       StaysOpen="False"
                                       AllowsTransparency="True"
                                       DataContext="{Binding DataContext, ElementName=Root}">
                                    <Border Width="{Binding ActualWidth, ElementName=SearchBox}"
                                            MaxHeight="360"
                                            Background="White"
                                            BorderBrush="#CBD5E1"
                                            BorderThickness="1"
                                            CornerRadius="0,0,12,12"
                                            Padding="0,5,0,5">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="16"
                                                              ShadowDepth="5"
                                                              Opacity="0.16" />
                                        </Border.Effect>
                                        <StackPanel>
                                            <DockPanel Margin="12,5,12,6">
                                                <TextBlock Text="{Binding SearchResultsTitle}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="#64748B" />
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding SearchResults.Count, StringFormat={}{0} result(s)}"
                                                           FontSize="9.5"
                                                           Foreground="#94A3B8" />
                                            </DockPanel>
                                            <ScrollViewer MaxHeight="300"
                                                          VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding SearchResults}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Command="{Binding DataContext.AddSearchResultCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Background="Transparent"
                                                                    BorderBrush="#F1F5F9"
                                                                    BorderThickness="0,1,0,0"
                                                                    Padding="12,9"
                                                                    HorizontalContentAlignment="Stretch">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel>
                                                                        <TextBlock FontWeight="Bold"
                                                                                   FontSize="12"
                                                                                   Foreground="#0F172A">
                                                                            <Run Text="{Binding BrandName}" />
                                                                            <Run Text=" · " />
                                                                            <Run Text="{Binding Strength}" />
                                                                        </TextBlock>
                                                                        <TextBlock FontSize="9.8"
                                                                                   Foreground="#64748B"
                                                                                   Margin="0,3,0,0">
                                                                            <Run Text="{Binding GenericName}" />
                                                                            <Run Text=" · " />
                                                                            <Run Text="{Binding MedicineCode}" />
                                                                            <Run Text=" · Stock " />
                                                                            <Run Text="{Binding AvailableQuantity, StringFormat={}{0:0.####}}" />
                                                                        </TextBlock>
                                                                        <TextBlock Text="FEFO will split quantity across batches automatically when required."
                                                                                   FontSize="9"
                                                                                   Foreground="#4F46E5"
                                                                                   Margin="0,3,0,0">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding Batches.Count}" Value="1">
                                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="1"
                                                                                Margin="14,0,0,0"
                                                                                HorizontalAlignment="Right">
                                                                        <TextBlock Text="{Binding FefoPrice, StringFormat=AFN {0:N2}}"
                                                                                   Foreground="#0F766E"
                                                                                   FontWeight="Bold"
                                                                                   FontSize="12"
                                                                                   HorizontalAlignment="Right" />
                                                                        <TextBlock Text="per unit"
                                                                                   FontSize="9"
                                                                                   Foreground="#94A3B8"
                                                                                   HorizontalAlignment="Right" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>

                            <Button Grid.Column="1"
                                    Content="Search"
                                    Command="{Binding SearchCommand}"
                                    Style="{StaticResource PosPrimaryButton}"
                                    MinWidth="92"
                                    Margin="8,0,0,0" />
                        </Grid>

                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="10.5"
                                   Foreground="#64748B"
                                   TextWrapping="Wrap"
                                   Margin="2,7,0,0" />
                    </StackPanel>
                </Border>

                <!-- Cart -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="14">
                        <Border Style="{StaticResource PosCard}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding CartTitle}"
                                                   Style="{StaticResource PosSectionTitle}" />
                                        <TextBlock Text="{Binding CartLineCountText}"
                                                   Style="{StaticResource PosCaption}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Clear cart"
                                            Command="{Binding ClearCartCommand}"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            Foreground="#DC2626"
                                            FontSize="10.5"
                                            FontWeight="SemiBold"
                                            Padding="8,4" />
                                </Grid>

                                <Border Background="#F8FAFC"
                                        CornerRadius="10"
                                        Padding="18,40"
                                        Margin="0,2,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Cart.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel HorizontalAlignment="Center">
                                        <Border Width="46"
                                                Height="46"
                                                CornerRadius="23"
                                                Background="#ECFDF5"
                                                HorizontalAlignment="Center">
                                            <Path Data="{StaticResource IconPos}"
                                                  Width="22"
                                                  Height="22"
                                                  Stroke="#0F766E"
                                                  StrokeThickness="1.8"
                                                  Fill="Transparent"
                                                  Stretch="Uniform"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Scan or search a medicine to begin a sale."
                                                   Foreground="#64748B"
                                                   FontSize="11.5"
                                                   Margin="0,10,0,0"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <ItemsControl ItemsSource="{Binding Cart}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#EEF2F7"
                                                    BorderThickness="0,1,0,0"
                                                    Padding="0,11">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="76" />
                                                            <ColumnDefinition Width="118" />
                                                            <ColumnDefinition Width="100" />
                                                            <ColumnDefinition Width="34" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding MedicineLabel}"
                                                                       FontSize="12"
                                                                       FontWeight="Bold"
                                                                       Foreground="#0F172A"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding SecondaryLabel}"
                                                                       FontSize="9.5"
                                                                       Foreground="#64748B"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Margin="0,3,0,0" />
                                                            <Border Background="#FFF7ED"
                                                                    CornerRadius="6"
                                                                    Padding="6,2"
                                                                    Margin="0,5,0,0"
                                                                    HorizontalAlignment="Left">
                                                                <TextBlock Text="Prescription required"
                                                                           FontSize="8.8"
                                                                           Foreground="#B45309"
                                                                           FontWeight="SemiBold">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Product.PrescriptionRequired}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                            <TextBlock Text="Qty" Style="{StaticResource PosCaption}" />
                                                            <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource PosMiniInput}"
                                                                     TextAlignment="Right"
                                                                     Margin="0,4,0,0" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                                            <TextBlock Text="Price" Style="{StaticResource PosCaption}" />
                                                            <TextBlock Text="{Binding DisplayUnitPrice, StringFormat=AFN {0:N2}}"
                                                                       Background="#F8FAFC"
                                                                       Padding="7,7"
                                                                       FontSize="11"
                                                                       FontWeight="Bold"
                                                                       TextAlignment="Right"
                                                                       Margin="0,4,0,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding OverridePrice}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBox Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}"
                                                                     Background="#FFF7ED"
                                                                     BorderBrush="#FCD34D"
                                                                     TextAlignment="Right"
                                                                     Margin="0,4,0,0">
                                                                <TextBox.Style>
                                                                    <Style TargetType="TextBox" BasedOn="{StaticResource PosMiniInput}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding OverridePrice}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBox.Style>
                                                            </TextBox>
                                                            <CheckBox Content="Override"
                                                                      IsChecked="{Binding OverridePrice}"
                                                                      IsEnabled="{Binding DataContext.CanOverridePrice, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                      FontSize="8.8"
                                                                      Foreground="#B45309"
                                                                      HorizontalAlignment="Right"
                                                                      Margin="0,3,0,0" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="3" Margin="0,0,7,0">
                                                            <TextBlock Text="Discount" Style="{StaticResource PosCaption}" />
                                                            <TextBox Text="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource PosMiniInput}"
                                                                     IsEnabled="{Binding DataContext.CanDiscount, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                     TextAlignment="Right"
                                                                     Margin="0,4,0,0" />
                                                        </StackPanel>

                                                        <Button Grid.Column="4"
                                                                Content="×"
                                                                Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource PosDangerIconButton}"
                                                                VerticalAlignment="Center" />
                                                    </Grid>

                                                    <Border Background="#F8FAFC"
                                                            CornerRadius="9"
                                                            Padding="9,6"
                                                            Margin="0,8,0,0">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="FEFO batches"
                                                                           FontSize="8.8"
                                                                           Foreground="#475569"
                                                                           FontWeight="Bold" />
                                                                <TextBlock Text="{Binding FefoPlanText}"
                                                                           FontSize="9.2"
                                                                           Foreground="#64748B"
                                                                           TextWrapping="Wrap"
                                                                           Margin="0,2,0,0" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding EstimatedLineTotal, StringFormat=AFN {0:N2}}"
                                                                       FontSize="12"
                                                                       FontWeight="Bold"
                                                                       Foreground="#0F172A"
                                                                       Margin="12,0,0,0"
                                                                       VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Background="#FEF2F2"
                                        BorderBrush="#FECACA"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="9"
                                        Margin="0,8,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasShortage}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="One or more item lines exceed the remaining sellable stock."
                                               Foreground="#B91C1C"
                                               FontSize="10"
                                               FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Web POS right checkout rail -->
            <Border Grid.Column="1"
                    Background="#F1F5F9"
                    BorderBrush="{StaticResource PosBorderBrush}"
                    BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12">
                        <!-- Customer -->
                        <Border Style="{StaticResource PosCard}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding CustomerLabel}"
                                           Style="{StaticResource PosSectionTitle}" />
                                <Grid Margin="0,9,0,0">
                                    <ComboBox ItemsSource="{Binding Customers}"
                                              SelectedItem="{Binding SelectedCustomer}"
                                              DisplayMemberPath="Name" />
                                    <TextBlock Text="{Binding WalkInCustomerText}"
                                               Margin="12,0,28,0"
                                               VerticalAlignment="Center"
                                               Foreground="#475569"
                                               FontSize="11.5"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedCustomer}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <TextBlock Text="Leave blank for a walk-in cash sale."
                                           Margin="2,5,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource PosCaption}" />
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Prescription -->
                        <Border BorderBrush="#FCD34D"
                                BorderThickness="1"
                                Background="#FFFBEB"
                                CornerRadius="14"
                                Padding="14"
                                Margin="0,0,0,10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RequiresPrescription}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="Prescription details"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="#78350F" />
                                <TextBlock Text="Required because the cart contains a prescription-only medicine."
                                           FontSize="9.5"
                                           Foreground="#92400E"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0" />
                                <TextBlock Text="Prescription / Rx reference"
                                           FontSize="9.2"
                                           FontWeight="SemiBold"
                                           Foreground="#92400E"
                                           Margin="1,9,0,3" />
                                <TextBox Text="{Binding PrescriptionReference, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Prescription / Rx reference"
                                         Background="White"
                                         BorderBrush="#FCD34D" />
                                <TextBlock Text="Prescriber / doctor"
                                           FontSize="9.2"
                                           FontWeight="SemiBold"
                                           Foreground="#92400E"
                                           Margin="1,6,0,3" />
                                <TextBox Text="{Binding PrescriberName}"
                                         ToolTip="Prescriber / doctor name"
                                         Background="White"
                                         BorderBrush="#FCD34D" />
                                <TextBlock Text="Prescription date"
                                           FontSize="9.2"
                                           FontWeight="SemiBold"
                                           Foreground="#92400E"
                                           Margin="1,6,0,3" />
                                <TextBox Text="{Binding PrescriptionDateText}"
                                         ToolTip="Prescription date"
                                         Background="White"
                                         BorderBrush="#FCD34D" />
                            </StackPanel>
                        </Border>

                        <!-- Totals -->
                        <Border Style="{StaticResource PosCard}" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Subtotal" Foreground="#64748B" FontSize="11" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Subtotal, StringFormat=AFN {0:N2}}"
                                               Foreground="#0F172A"
                                               FontWeight="SemiBold" />
                                </Grid>
                                <Grid Margin="0,0,0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Discount" Foreground="#64748B" FontSize="11" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DiscountTotal, StringFormat=AFN {0:N2}}"
                                               Foreground="#0F172A"
                                               FontWeight="SemiBold" />
                                </Grid>
                                <Separator Background="#E2E8F0" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Total"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               Foreground="#0F172A" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding EstimatedGrandTotal, StringFormat=AFN {0:N2}}"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#0F766E" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Payments -->
                        <Border Style="{StaticResource PosCard}" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding PaymentTitle}"
                                               Style="{StaticResource PosSectionTitle}" />
                                    <Button Grid.Column="1"
                                            Content="+ Split"
                                            Command="{Binding AddSplitPaymentCommand}"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            Foreground="#0F766E"
                                            FontSize="10.5"
                                            FontWeight="Bold"
                                            Padding="6,2" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Payments}"
                                              Margin="0,5,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="94" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="30" />
                                                </Grid.ColumnDefinitions>
                                                <ComboBox ItemsSource="{Binding DataContext.PaymentMethods, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          SelectedItem="{Binding Method, UpdateSourceTrigger=PropertyChanged}"
                                                          MinHeight="34"
                                                          FontSize="10.5"
                                                          Padding="6,3"
                                                          Margin="0,0,6,0" />
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource PosMiniInput}"
                                                         TextAlignment="Right"
                                                         Margin="0,0,5,0" />
                                                <Button Grid.Column="2"
                                                        Content="×"
                                                        Command="{Binding DataContext.RemovePaymentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource PosDangerIconButton}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="Set cash to total"
                                            Command="{Binding SetCashToTotalCommand}"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            Foreground="#0F766E"
                                            FontSize="9.8"
                                            FontWeight="SemiBold"
                                            Padding="0" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding PaymentBalanceText}"
                                               FontSize="9.8"
                                               FontWeight="SemiBold"
                                               Foreground="#475569" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Notes -->
                        <Border Style="{StaticResource PosCard}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Sale notes"
                                           Style="{StaticResource PosSectionTitle}" />
                                <TextBox Text="{Binding SaleNotes}"
                                         AcceptsReturn="True"
                                         MinHeight="56"
                                         TextWrapping="Wrap"
                                         Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Checkout -->
                        <Button Command="{Binding CheckoutCommand}"
                                Style="{StaticResource PosPrimaryButton}"
                                MinHeight="52"
                                Margin="0,0,0,10"
                                FontSize="14"
                                HorizontalContentAlignment="Stretch">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding CheckoutLabel}"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding EstimatedGrandTotal, StringFormat=AFN {0:N2}}"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           FontSize="15"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <!-- Recent invoices -->
                        <Border Style="{StaticResource PosCard}">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding RecentSalesTitle}"
                                               Style="{StaticResource PosSectionTitle}" />
                                    <Button Grid.Column="1"
                                            Content="Refresh"
                                            Command="{Binding RefreshSalesCommand}"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            Foreground="#0F766E"
                                            FontSize="9.5"
                                            FontWeight="SemiBold"
                                            Padding="4,1" />
                                </Grid>
                                <DataGrid ItemsSource="{Binding RecentSales}"
                                          Style="{StaticResource PosGrid}"
                                          Height="128">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Invoice"
                                                            Binding="{Binding SaleNumber}"
                                                            Width="*" />
                                        <DataGridTextColumn Header="Total"
                                                            Binding="{Binding GrandTotal, StringFormat=N2}"
                                                            Width="72" />
                                        <DataGridTextColumn Header="Status"
                                                            Binding="{Binding PaymentStatus}"
                                                            Width="62" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
