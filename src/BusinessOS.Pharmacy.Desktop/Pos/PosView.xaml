<UserControl x:Class="BusinessOS.Pharmacy.Desktop.Pos.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="760">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding WorkspaceTitle}" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Refresh" Command="{Binding LoadCommand}" Padding="14,7"/>
            </Grid>

            <Grid Grid.Row="1" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{Binding LocationLabel}" Style="{StaticResource MutedText}"/>
                    <ComboBox ItemsSource="{Binding StockLocations}" SelectedItem="{Binding SelectedLocation}"
                              DisplayMemberPath="Name" MinWidth="170"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="{Binding CustomerLabel}" Style="{StaticResource MutedText}"/>
                    <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}"
                              DisplayMemberPath="Name" MinWidth="170" IsEditable="False"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="{Binding SearchLabel}" Style="{StaticResource MutedText}"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <Button Grid.Column="3" Content="Search" Command="{Binding SearchCommand}"
                        Padding="16,7" VerticalAlignment="Bottom"/>
            </Grid>

            <Grid Grid.Row="2" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="1.7*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="12" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Search results" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ListBox ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedProduct}"
                                 MinHeight="220" MaxHeight="360">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4">
                                        <TextBlock Text="{Binding BrandName}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding MedicineCode}" Style="{StaticResource MutedText}"/>
                                        <TextBlock Text="{Binding AvailableQuantity, StringFormat=Available {0:0.####}}"/>
                                        <TextBlock Text="{Binding FefoPrice, StringFormat=AFN {0:N4}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Qty" Style="{StaticResource MutedText}"/>
                                <TextBox Text="{Binding Quantity}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Discount" Style="{StaticResource MutedText}"/>
                                <TextBox Text="{Binding DiscountAmount}" IsEnabled="{Binding CanDiscount}"/>
                            </StackPanel>
                        </Grid>
                        <CheckBox Content="Override batch price" IsChecked="{Binding OverridePrice}"
                                  IsEnabled="{Binding CanOverridePrice}" Margin="0,8,0,0"/>
                        <TextBox Text="{Binding OverrideUnitPrice}" IsEnabled="{Binding OverridePrice}" Margin="0,6,0,0"/>
                        <Button Content="Add to sale" Command="{Binding AddToCartCommand}" Padding="12,7" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="12" Margin="0,0,12,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding CartTitle}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding TotalText}" FontSize="18" FontWeight="SemiBold"/>
                        </Grid>
                        <DataGrid ItemsSource="{Binding Cart}" AutoGenerateColumns="False" CanUserAddRows="False"
                                  IsReadOnly="True" MinHeight="220" MaxHeight="360" Margin="0,8,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Medicine" Binding="{Binding MedicineLabel}" Width="*"/>
                                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, StringFormat=0.####}" Width="70"/>
                                <DataGridTextColumn Header="Price" Binding="{Binding DisplayUnitPrice, StringFormat=N4}" Width="90"/>
                                <DataGridTextColumn Header="Discount" Binding="{Binding DiscountAmount, StringFormat=N4}" Width="90"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding EstimatedLineTotal, StringFormat=N4}" Width="90"/>
                                <DataGridTemplateColumn Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Remove"
                                                    Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="Prescription" FontWeight="SemiBold" Margin="0,12,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding PrescriptionReference}" Margin="0,0,6,0" ToolTip="Prescription reference"/>
                            <TextBox Grid.Column="1" Text="{Binding PrescriberName}" Margin="6,0" ToolTip="Prescriber name"/>
                            <TextBox Grid.Column="2" Text="{Binding PrescriptionDateText}" Margin="6,0,0,0" ToolTip="Prescription date"/>
                        </Grid>
                        <TextBox Text="{Binding SaleNotes}" Margin="0,8,0,0" ToolTip="Sale notes"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="{Binding PaymentTitle}" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding SelectedPaymentMethod}" Margin="0,8,0,0"/>
                        <TextBox Text="{Binding PaymentAmount}" Margin="0,6,0,0" ToolTip="Amount"/>
                        <TextBox Text="{Binding PaymentReference}" Margin="0,6,0,0" ToolTip="Reference"/>
                        <Button Content="Add payment" Command="{Binding AddPaymentCommand}" Padding="12,7" Margin="0,8,0,0"/>
                        <ListBox ItemsSource="{Binding Payments}" MinHeight="100" Margin="0,8,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="2">
                                        <Button DockPanel.Dock="Right" Content="×"
                                                Command="{Binding DataContext.RemovePaymentCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" Padding="5,1"/>
                                        <TextBlock>
                                            <Run Text="{Binding Method}"/>
                                            <Run Text="  "/>
                                            <Run Text="{Binding Amount, StringFormat=N4}"/>
                                        </TextBlock>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Content="{Binding CheckoutLabel}" Command="{Binding CheckoutCommand}"
                                Padding="14,9" Margin="0,12,0,0" FontWeight="SemiBold"/>
                        <StackPanel Margin="0,12,0,0" Visibility="{Binding LastSale, Converter={x:Static BooleanToVisibilityConverter.Instance}}">
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12" Margin="0,18,0,0">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="{Binding RecentSalesTitle}" FontWeight="SemiBold"/>
                        <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshSalesCommand}" Padding="8,3"/>
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding RecentSales}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" Margin="0,8,0,0" MaxHeight="220">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Invoice" Binding="{Binding SaleNumber}" Width="*"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding BusinessDate}" Width="110"/>
                            <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding PaymentStatus}" Width="90"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding GrandTotal, StringFormat=N4}" Width="100"/>
                            <DataGridTextColumn Header="Due" Binding="{Binding DueTotal, StringFormat=N4}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
