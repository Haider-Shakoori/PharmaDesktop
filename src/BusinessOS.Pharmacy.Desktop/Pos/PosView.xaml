<UserControl x:Class="BusinessOS.Pharmacy.Desktop.Pos.PosView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:BusinessOS.Pharmacy.Desktop.Converters"
             xmlns:sales="clr-namespace:BusinessOS.Pharmacy.Application.Abstractions.Sales;assembly=BusinessOS.Pharmacy.Application"
             MinWidth="900"
             Background="{DynamicResource SurfaceMutedBrush}">
    <UserControl.InputBindings>
        <KeyBinding Key="F1" Command="{Binding FocusSearchCommand}" />
        <KeyBinding Key="F2" Command="{Binding FocusCustomerCommand}" />
        <KeyBinding Key="F4" Command="{Binding OpenPaymentCommand}" />
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding OpenPaymentCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:CountToVisibilityConverter x:Key="CountNonZeroToVisibility" Empty="False" />
        <converters:CountToVisibilityConverter x:Key="CountZeroToVisibility" Empty="True" />

        <SolidColorBrush x:Key="PosPrimaryBrush" Color="{DynamicResource PosPrimaryColor}" />
        <SolidColorBrush x:Key="PosPrimaryDarkBrush" Color="{DynamicResource PosPrimaryDarkColor}" />
        <SolidColorBrush x:Key="PosPrimarySoftBrush" Color="{DynamicResource PosPrimarySoftColor}" />
        <SolidColorBrush x:Key="PosBorderBrush" Color="{DynamicResource BorderColor}" />
        <SolidColorBrush x:Key="PosMutedBrush" Color="{DynamicResource TextMutedColor}" />
        <SolidColorBrush x:Key="PosHeadingBrush" Color="{DynamicResource TextPrimaryColor}" />

        <Style x:Key="PosCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style x:Key="PosSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource PosHeadingBrush}" />
        </Style>

        <Style x:Key="PosCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{StaticResource PosMutedBrush}" />
        </Style>

        <Style x:Key="PosPrimaryButton" TargetType="Button" BasedOn="{StaticResource ProfessionalButtonBase}">
            <Setter Property="Background" Value="{StaticResource PosPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PosPrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinHeight" Value="38" />
        </Style>

        <Style x:Key="PosOutlineButton" TargetType="Button" BasedOn="{StaticResource ProfessionalButtonBase}">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="MinHeight" Value="36" />
        </Style>

        <Style x:Key="PosSearchButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BrandPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource BrandPrimaryBrush}" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource BrandPrimaryDarkBrush}" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource BrandPrimaryDarkBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource BrandPrimarySoftBrush}" />
                                <Setter TargetName="Border" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource BrandPrimarySoftBrush}" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource BrandPrimarySoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PosSearchResultButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceMutedBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ResultBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ResultBorder" Property="Background" Value="{DynamicResource SurfaceStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ResultBorder" Property="Background" Value="{DynamicResource BrandPrimarySoftBrush}" />
                                <Setter TargetName="ResultBorder" Property="BorderBrush" Value="{DynamicResource BrandPrimarySoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ResultBorder" Property="Background" Value="{DynamicResource BrandPrimarySoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PosDangerIconButton" TargetType="Button" BasedOn="{StaticResource ProfessionalButtonBase}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
        </Style>

        <Style x:Key="PosMiniInput" TargetType="TextBox" BasedOn="{StaticResource FieldTextBox}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>

        <Style x:Key="PosGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="RowBackground" Value="White" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource SurfaceStrongBrush}" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource SurfaceMutedBrush}" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="RowHeight" Value="28" />
            <Setter Property="ColumnHeaderHeight" Value="28" />
            <Setter Property="FontSize" Value="10.5" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Web POS parity header -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="{StaticResource PosBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40"
                            Height="40"
                            CornerRadius="10"
                            Background="{DynamicResource TextPrimaryBrush}">
                        <TextBlock Text="Rx"
                                   Foreground="White"
                                   FontWeight="Black"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DataContext.Dashboard.PharmacyName, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding WorkspaceSubtitle}"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <ComboBox Width="238"
                              ItemsSource="{Binding StockLocations}"
                              SelectedItem="{Binding SelectedLocation}"
                              DisplayMemberPath="Name"
                              ToolTip="{Binding LocationLabel}"
                              Margin="0,0,8,0" />
                    <Button Content="Refresh"
                            Command="{Binding LoadCommand}"
                            Style="{StaticResource PosOutlineButton}"
                            Margin="0,0,8,0" />
                    <Button Command="{Binding DataContext.ToggleFullScreenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Style="{StaticResource PosOutlineButton}"
                            Margin="0,0,8,0"
                            ToolTip="Toggle full screen (F11)">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M3,9 L3,3 L9,3 M15,3 L21,3 L21,9 M21,15 L21,21 L15,21 M9,21 L3,21 L3,15"
                                  Width="13" Height="13"
                                  Stroke="{DynamicResource TextSecondaryBrush}"
                                  StrokeThickness="1.8"
                                  Fill="Transparent"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Margin="0,0,6,0" />
                            <TextBlock Text="Full screen" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="dashboard"
                            Style="{StaticResource ProfessionalButtonBase}"
                            Background="{DynamicResource TextPrimaryBrush}"
                            BorderBrush="{DynamicResource TextPrimaryBrush}"
                            Padding="13,8"
                            MinHeight="36">
                        <TextBlock Text="Exit POS"
                                   Foreground="White"
                                   FontWeight="Bold" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="430" />
            </Grid.ColumnDefinitions>

            <!-- Main sale workspace -->
            <Grid Grid.Column="0"
                  Background="{DynamicResource AppBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Scanner/search bar -->
                <Border Grid.Row="0"
                        Background="White"
                        BorderBrush="{StaticResource PosBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="14,12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid>
                                <Border Background="White"
                                        BorderBrush="{DynamicResource BorderStrongBrush}"
                                        BorderThickness="1"
                                        CornerRadius="11">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Path Data="{StaticResource IconSearch}"
                                              Width="16"
                                              Height="16"
                                              Stroke="{DynamicResource BrandPrimaryBrush}"
                                              StrokeThickness="1.8"
                                              Fill="Transparent"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                        <Grid Grid.Column="1">
                                            <TextBlock Text="{Binding SearchLabel}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       FontSize="12.5"
                                                       VerticalAlignment="Center"
                                                       IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBox x:Name="SearchBox"
                                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource SearchTextBox}"
                                                     MinHeight="44"
                                                     FontSize="13.5"
                                                     VerticalContentAlignment="Center"
                                                     BorderThickness="0"
                                                     Background="Transparent">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Enter"
                                                                Command="{Binding SearchCommand}" />
                                                </TextBox.InputBindings>
                                            </TextBox>
                                        </Grid>
                                        <Border Grid.Column="2"
                                                Background="{DynamicResource PosPrimarySoftBrush}"
                                                CornerRadius="7"
                                                Padding="8,4"
                                                Margin="4"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="Scanner ready"
                                                       Foreground="{DynamicResource PosPrimaryBrush}"
                                                       FontSize="9.5"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <Popup PlacementTarget="{Binding ElementName=SearchBox}"
                                       Placement="Bottom"
                                       IsOpen="{Binding IsSearchDropdownOpen, Mode=TwoWay}"
                                       StaysOpen="False"
                                       AllowsTransparency="True"
                                       DataContext="{Binding DataContext, ElementName=Root}">
                                    <Border Width="{Binding ActualWidth, ElementName=SearchBox}"
                                            MaxHeight="360"
                                            Background="White"
                                            BorderBrush="{DynamicResource BorderStrongBrush}"
                                            BorderThickness="1"
                                            CornerRadius="0,0,12,12"
                                            Padding="0,5,0,5">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="16"
                                                              ShadowDepth="5"
                                                              Opacity="0.16" />
                                        </Border.Effect>
                                        <StackPanel>
                                            <DockPanel Margin="12,5,12,6">
                                                <TextBlock Text="{Binding SearchResultsTitle}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding SearchResults.Count, StringFormat={}{0} result(s)}"
                                                           FontSize="9.5"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                            </DockPanel>
                                            <ScrollViewer MaxHeight="300"
                                                          VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding SearchResults}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Command="{Binding DataContext.AddSearchResultCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource PosSearchResultButton}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel>
                                                                        <TextBlock FontWeight="Bold"
                                                                                   FontSize="12"
                                                                                   Foreground="{DynamicResource TextPrimaryBrush}">
                                                                            <Run Text="{Binding BrandName}" />
                                                                            <Run Text=" · " />
                                                                            <Run Text="{Binding Strength}" />
                                                                        </TextBlock>
                                                                        <TextBlock FontSize="9.8"
                                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                                   Margin="0,3,0,0">
                                                                            <Run Text="{Binding GenericName}" />
                                                                            <Run Text=" · " />
                                                                            <Run Text="{Binding MedicineCode}" />
                                                                            <Run Text=" · Stock " />
                                                                            <Run Text="{Binding AvailableQuantity, StringFormat={}{0:0.####}}" />
                                                                        </TextBlock>
                                                                        <TextBlock Text="FEFO will split quantity across batches automatically when required."
                                                                                   FontSize="9"
                                                                                   Foreground="{DynamicResource IndigoBrush}"
                                                                                   Margin="0,3,0,0">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding Batches.Count}" Value="1">
                                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="1"
                                                                                Margin="14,0,0,0"
                                                                                HorizontalAlignment="Right">
                                                                        <TextBlock Text="{Binding FefoPrice, StringFormat=AFN {0:N2}}"
                                                                                   Foreground="{DynamicResource BrandPrimaryBrush}"
                                                                                   FontWeight="Bold"
                                                                                   FontSize="12"
                                                                                   HorizontalAlignment="Right" />
                                                                        <TextBlock Text="per unit"
                                                                                   FontSize="9"
                                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                                   HorizontalAlignment="Right" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>

                            <Button Grid.Column="1"
                                    Command="{Binding SearchCommand}"
                                    Style="{StaticResource PosSearchButton}"
                                    MinWidth="104"
                                    Margin="8,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconSearch}"
                                          Width="13"
                                          Height="13"
                                          Stroke="White"
                                          StrokeThickness="2"
                                          Fill="Transparent"
                                          Stretch="Uniform"
                                          Margin="0,0,7,0"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="Search"
                                               Foreground="White"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid Margin="2,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding StatusMessage}"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Border Background="{DynamicResource BrandPrimarySoftBrush}" BorderBrush="{DynamicResource BrandPrimarySoftBrush}" BorderThickness="1" CornerRadius="7" Padding="7,3" Margin="5,0,0,0">
                                    <TextBlock FontSize="9.2" Foreground="{DynamicResource BrandPrimaryDarkBrush}">
                                        <Run Text="F1" FontWeight="Bold" /><Run Text="  Search" FontWeight="SemiBold" />
                                    </TextBlock>
                                </Border>
                                <Border Background="{DynamicResource PurpleSoftBrush}" BorderBrush="{DynamicResource PurpleSoftBrush}" BorderThickness="1" CornerRadius="7" Padding="7,3" Margin="5,0,0,0">
                                    <TextBlock FontSize="9.2" Foreground="{DynamicResource PurpleBrush}">
                                        <Run Text="F2" FontWeight="Bold" /><Run Text="  Customer" FontWeight="SemiBold" />
                                    </TextBlock>
                                </Border>
                                <Border Background="{DynamicResource PosPrimarySoftBrush}" BorderBrush="{DynamicResource PosPrimarySoftBrush}" BorderThickness="1" CornerRadius="7" Padding="7,3" Margin="5,0,0,0">
                                    <TextBlock FontSize="9.2" Foreground="{DynamicResource PosPrimaryBrush}">
                                        <Run Text="F4" FontWeight="Bold" /><Run Text="  Pay" FontWeight="SemiBold" />
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Top selling medicines: quick add strip -->
                <Border Grid.Row="1"
                        Background="White"
                        BorderBrush="{StaticResource PosBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="14,10"
                        Visibility="{Binding IsTopSellersVisible, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding TopSellersTitle}"
                                           Style="{StaticResource PosSectionTitle}" />
                                <TextBlock Text="{Binding TopSellersHint}"
                                           Style="{StaticResource PosCaption}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Command="{Binding RefreshTopSellersCommand}"
                                    Content="↻"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource PosPrimaryBrush}"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    VerticalAlignment="Center"
                                    Padding="6,2"
                                    ToolTip="Refresh" />
                        </Grid>

                        <TextBlock Text="{Binding TopSellersQuickAddHint}"
                                   Style="{StaticResource PosCaption}"
                                   Margin="0,8,0,0"
                                   Visibility="{Binding TopSellers.Count, Converter={StaticResource CountNonZeroToVisibility}}" />

                        <TextBlock Text="{Binding TopSellersEmptyText}"
                                   Style="{StaticResource PosCaption}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,8,0,0"
                                   Visibility="{Binding TopSellers.Count, Converter={StaticResource CountZeroToVisibility}}" />

                        <ItemsControl ItemsSource="{Binding TopSellers}"
                                      Margin="0,8,0,0"
                                      Visibility="{Binding TopSellers.Count, Converter={StaticResource CountNonZeroToVisibility}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type sales:PosTopProductItem}">
                                    <Button Command="{Binding DataContext.QuickAddTopSellerCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Background="{DynamicResource SurfaceMutedBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            Padding="10,6"
                                            Margin="0,0,8,8"
                                            Cursor="Hand"
                                            ToolTip="{Binding LastUnitPrice, StringFormat='Last price AFN {0:N2}'}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding BrandName}"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <StackPanel Orientation="Horizontal"
                                                        Margin="0,2,0,0">
                                                <TextBlock Text="{Binding QuantitySold, StringFormat='{}{0:0.##}'}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource PosPrimaryBrush}" />
                                                <TextBlock Text="{Binding SaleUnit}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           Margin="3,0,0,0" />
                                                <TextBlock Text="{Binding LastUnitPrice, StringFormat=' · AFN {0:N2}'}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Cart -->
                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="14">
                        <Border Style="{StaticResource PosCard}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding CartTitle}"
                                                   Style="{StaticResource PosSectionTitle}" />
                                        <TextBlock Text="{Binding CartLineCountText}"
                                                   Style="{StaticResource PosCaption}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Clear cart"
                                            Command="{Binding ClearCartCommand}"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            Foreground="{DynamicResource DangerBrush}"
                                            FontSize="10.5"
                                            FontWeight="SemiBold"
                                            Padding="8,4" />
                                </Grid>

                                <Border Background="{DynamicResource AppBackgroundBrush}"
                                        CornerRadius="10"
                                        Padding="18,40"
                                        Margin="0,2,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Cart.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel HorizontalAlignment="Center">
                                        <Border Width="46"
                                                Height="46"
                                                CornerRadius="23"
                                                Background="{DynamicResource PosPrimarySoftBrush}"
                                                HorizontalAlignment="Center">
                                            <Path Data="{StaticResource IconPos}"
                                                  Width="22"
                                                  Height="22"
                                                  Stroke="{DynamicResource PosPrimaryBrush}"
                                                  StrokeThickness="1.8"
                                                  Fill="Transparent"
                                                  Stretch="Uniform"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Scan or search a medicine to begin a sale."
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="11.5"
                                                   Margin="0,10,0,0"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <ItemsControl ItemsSource="{Binding Cart}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource SurfaceMutedBrush}"
                                                    BorderThickness="0,1,0,0"
                                                    Padding="0,11">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="76" />
                                                            <ColumnDefinition Width="118" />
                                                            <ColumnDefinition Width="100" />
                                                            <ColumnDefinition Width="34" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding MedicineLabel}"
                                                                       FontSize="12"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding SecondaryLabel}"
                                                                       FontSize="9.5"
                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Margin="0,3,0,0" />
                                                            <Border Background="{DynamicResource WarningSoftBrush}"
                                                                    CornerRadius="6"
                                                                    Padding="6,2"
                                                                    Margin="0,5,0,0"
                                                                    HorizontalAlignment="Left">
                                                                <TextBlock Text="Prescription required"
                                                                           FontSize="8.8"
                                                                           Foreground="{DynamicResource WarningBrush}"
                                                                           FontWeight="SemiBold">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Product.PrescriptionRequired}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                            <TextBlock Text="Qty" Style="{StaticResource PosCaption}" />
                                                            <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource PosMiniInput}"
                                                                     TextAlignment="Right"
                                                                     Margin="0,4,0,0" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                                            <TextBlock Text="Price" Style="{StaticResource PosCaption}" />
                                                            <TextBlock Text="{Binding DisplayUnitPrice, StringFormat=AFN {0:N2}}"
                                                                       Background="{DynamicResource AppBackgroundBrush}"
                                                                       Padding="7,7"
                                                                       FontSize="11"
                                                                       FontWeight="Bold"
                                                                       TextAlignment="Right"
                                                                       Margin="0,4,0,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding OverridePrice}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBox Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}"
                                                                     Background="{DynamicResource WarningSoftBrush}"
                                                                     BorderBrush="#FCD34D"
                                                                     TextAlignment="Right"
                                                                     Margin="0,4,0,0">
                                                                <TextBox.Style>
                                                                    <Style TargetType="TextBox" BasedOn="{StaticResource PosMiniInput}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding OverridePrice}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBox.Style>
                                                            </TextBox>
                                                            <CheckBox Content="Override"
                                                                      IsChecked="{Binding OverridePrice}"
                                                                      IsEnabled="{Binding DataContext.CanOverridePrice, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                      FontSize="8.8"
                                                                      Foreground="{DynamicResource WarningBrush}"
                                                                      HorizontalAlignment="Right"
                                                                      Margin="0,3,0,0" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="3" Margin="0,0,7,0">
                                                            <TextBlock Text="Discount" Style="{StaticResource PosCaption}" />
                                                            <TextBox Text="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource PosMiniInput}"
                                                                     IsEnabled="{Binding DataContext.CanDiscount, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                     TextAlignment="Right"
                                                                     Margin="0,4,0,0" />
                                                        </StackPanel>

                                                        <Button Grid.Column="4"
                                                                Content="×"
                                                                Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource PosDangerIconButton}"
                                                                VerticalAlignment="Center" />
                                                    </Grid>

                                                    <Border Background="{DynamicResource AppBackgroundBrush}"
                                                            CornerRadius="9"
                                                            Padding="9,6"
                                                            Margin="0,8,0,0">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="FEFO batches"
                                                                           FontSize="8.8"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                           FontWeight="Bold" />
                                                                <TextBlock Text="{Binding FefoPlanText}"
                                                                           FontSize="9.2"
                                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                                           TextWrapping="Wrap"
                                                                           Margin="0,2,0,0" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding EstimatedLineTotal, StringFormat=AFN {0:N2}}"
                                                                       FontSize="12"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       Margin="12,0,0,0"
                                                                       VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Background="{DynamicResource DangerSoftBrush}"
                                        BorderBrush="{DynamicResource DangerSoftBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="9"
                                        Margin="0,8,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasShortage}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="One or more item lines exceed the remaining sellable stock."
                                               Foreground="{DynamicResource DangerBrush}"
                                               FontSize="10"
                                               FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Web POS right checkout rail -->
            <Border Grid.Column="1"
                    Background="{DynamicResource SurfaceMutedBrush}"
                    BorderBrush="{StaticResource PosBorderBrush}"
                    BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12">
                        <!-- Customer -->
                        <Border Style="{StaticResource PosCard}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding CustomerLabel}"
                                           Style="{StaticResource PosSectionTitle}" />
                                <Grid Margin="0,9,0,0">
                                    <ComboBox x:Name="CustomerCombo"
                                              ItemsSource="{Binding Customers}"
                                              SelectedItem="{Binding SelectedCustomer}"
                                              DisplayMemberPath="Name" />
                                    <TextBlock Text="{Binding WalkInCustomerText}"
                                               Margin="12,0,28,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11.5"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedCustomer}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <TextBlock Text="Leave blank for a walk-in cash sale."
                                           Margin="2,5,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource PosCaption}" />
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Prescription -->
                        <Border BorderBrush="#FCD34D"
                                BorderThickness="1"
                                Background="{DynamicResource WarningSoftBrush}"
                                CornerRadius="14"
                                Padding="14"
                                Margin="0,0,0,10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RequiresPrescription}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="Prescription details"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="#78350F" />
                                <TextBlock Text="Required because the cart contains a prescription-only medicine."
                                           FontSize="9.5"
                                           Foreground="{DynamicResource WarningBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0" />
                                <TextBlock Text="Prescription / Rx reference"
                                           FontSize="9.2"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource WarningBrush}"
                                           Margin="1,9,0,3" />
                                <TextBox Text="{Binding PrescriptionReference, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Prescription / Rx reference"
                                         Background="White"
                                         BorderBrush="#FCD34D" />
                                <TextBlock Text="Prescriber / doctor"
                                           FontSize="9.2"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource WarningBrush}"
                                           Margin="1,6,0,3" />
                                <TextBox Text="{Binding PrescriberName}"
                                         ToolTip="Prescriber / doctor name"
                                         Background="White"
                                         BorderBrush="#FCD34D" />
                                <TextBlock Text="Prescription date"
                                           FontSize="9.2"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource WarningBrush}"
                                           Margin="1,6,0,3" />
                                <TextBox Text="{Binding PrescriptionDateText}"
                                         ToolTip="Prescription date"
                                         Background="White"
                                         BorderBrush="#FCD34D" />
                            </StackPanel>
                        </Border>

                        <!-- Totals -->
                        <Border Style="{StaticResource PosCard}" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Subtotal" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Subtotal, StringFormat=AFN {0:N2}}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontWeight="SemiBold" />
                                </Grid>
                                <Grid Margin="0,0,0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Discount" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DiscountTotal, StringFormat=AFN {0:N2}}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontWeight="SemiBold" />
                                </Grid>
                                <Separator Background="{DynamicResource BorderBrush}" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Total"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding EstimatedGrandTotal, StringFormat=AFN {0:N2}}"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PosPrimaryBrush}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Payment launcher -->
                        <Border Style="{StaticResource PosCard}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Payment"
                                               Style="{StaticResource PosSectionTitle}" />
                                    <TextBlock Text="Open the payment window to choose cash, bank, mobile, credit or split payment."
                                               Style="{StaticResource PosCaption}"
                                               TextWrapping="Wrap"
                                               Margin="0,3,12,0" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Border Background="{DynamicResource PosPrimarySoftBrush}"
                                                CornerRadius="6"
                                                Padding="7,3">
                                            <TextBlock Text="{Binding PaymentBalanceText}"
                                                       Foreground="{DynamicResource PosPrimaryBrush}"
                                                       FontSize="9.5"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                        <TextBlock Text="F4 / Ctrl+Enter"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="9"
                                                   Margin="8,4,0,0" />
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Command="{Binding OpenPaymentCommand}"
                                        Style="{StaticResource PosOutlineButton}"
                                        MinWidth="92"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Pay"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource PosPrimaryBrush}" />
                                        <TextBlock Text="  →"
                                                   Foreground="{DynamicResource PosPrimaryBrush}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Notes -->
                        <Border Style="{StaticResource PosCard}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Sale notes"
                                           Style="{StaticResource PosSectionTitle}" />
                                <TextBox Text="{Binding SaleNotes}"
                                         AcceptsReturn="True"
                                         MinHeight="56"
                                         TextWrapping="Wrap"
                                         Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Checkout -->
                        <Button Command="{Binding OpenPaymentCommand}"
                                Style="{StaticResource PosPrimaryButton}"
                                MinHeight="52"
                                Margin="0,0,0,10"
                                FontSize="14"
                                HorizontalContentAlignment="Stretch">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Pay"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="F4"
                                               Foreground="{DynamicResource PosPrimarySoftBrush}"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Margin="0,0,10,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding EstimatedGrandTotal, StringFormat=AFN {0:N2}}"
                                               Foreground="White"
                                               FontWeight="Bold"
                                               FontSize="15"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Recent invoices -->
                        <Border Style="{StaticResource PosCard}">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding RecentSalesTitle}"
                                               Style="{StaticResource PosSectionTitle}" />
                                    <Button Grid.Column="1"
                                            Content="Refresh"
                                            Command="{Binding RefreshSalesCommand}"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            Foreground="{DynamicResource PosPrimaryBrush}"
                                            FontSize="9.5"
                                            FontWeight="SemiBold"
                                            Padding="4,1" />
                                </Grid>
                                <DataGrid ItemsSource="{Binding RecentSales}"
                                          Style="{StaticResource PosGrid}"
                                          Height="128">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Invoice"
                                                            Binding="{Binding SaleNumber}"
                                                            Width="*" />
                                        <DataGridTextColumn Header="Total"
                                                            Binding="{Binding GrandTotal, StringFormat=N2}"
                                                            Width="72" />
                                        <DataGridTextColumn Header="Status"
                                                            Binding="{Binding PaymentStatus}"
                                                            Width="62" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
