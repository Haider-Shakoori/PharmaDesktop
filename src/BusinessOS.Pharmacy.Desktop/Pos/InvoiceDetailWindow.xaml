<Window x:Class="BusinessOS.Pharmacy.Desktop.Pos.InvoiceDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Invoice"
        Width="920"
        Height="680"
        MinWidth="760"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                <TextBlock Text="{Binding Sale.GrandTotal, StringFormat=AFN {0:N2}}"
                           FontSize="24" FontWeight="Bold" HorizontalAlignment="Right"/>
                <TextBlock Text="{Binding Sale.PaymentStatus}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Right"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{Binding Sale.SaleNumber}" FontSize="26" FontWeight="Bold"/>
                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}">
                    <Run Text="{Binding Sale.BusinessDate}"/>
                    <Run Text=" · "/>
                    <Run Text="{Binding CashierName}"/>
                    <Run Text=" · "/>
                    <Run Text="{Binding Sale.StockLocationName}"/>
                </TextBlock>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource SurfaceCard}" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Customer" Style="{StaticResource MutedText}"/>
                    <TextBlock Text="{Binding Sale.CustomerName, TargetNullValue=Walk-in customer}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Subtotal" Style="{StaticResource MutedText}"/>
                    <TextBlock Text="{Binding Subtotal, StringFormat=AFN {0:N2}}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Discount" Style="{StaticResource MutedText}"/>
                    <TextBlock Text="{Binding DiscountTotal, StringFormat=AFN {0:N2}}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="Paid / Due" Style="{StaticResource MutedText}"/>
                    <TextBlock FontWeight="SemiBold">
                        <Run Text="{Binding Sale.PaidTotal, StringFormat={}{0:N2}}"/>
                        <Run Text=" / "/>
                        <Run Text="{Binding Sale.DueTotal, StringFormat={}{0:N2}}"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource SurfaceCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Invoice items" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10"/>
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Lines}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Medicine" Binding="{Binding Description}" Width="2*"/>
                        <DataGridTextColumn Header="Unit" Binding="{Binding SaleUnit}" Width="90"/>
                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, StringFormat=0.####}" Width="90"/>
                        <DataGridTextColumn Header="Unit price" Binding="{Binding UnitPrice, StringFormat=N2}" Width="110"/>
                        <DataGridTextColumn Header="Discount" Binding="{Binding DiscountAmount, StringFormat=N2}" Width="100"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding LineTotal, StringFormat=N2}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource SurfaceCard}" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="Payments" Style="{StaticResource SectionTitleText}" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding Payments}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Amount, StringFormat=AFN {0:N2}}" FontWeight="SemiBold"/>
                                <TextBlock>
                                    <Run Text="{Binding Method}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding PaymentNumber}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding Reference, TargetNullValue='No reference'}"/>
                                </TextBlock>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,16,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Click="OnCloseClick"
                    Style="{StaticResource SecondaryButton}" Padding="16,8"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="Print invoice" Click="OnPrintClick"
                        Style="{StaticResource PrimaryButton}" Padding="16,8" Margin="0,0,8,0"/>
                <Button x:Name="ReturnButton" Content="Return medicine / actions" Click="OnReturnClick"
                        Style="{StaticResource SecondaryButton}" Padding="16,8"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
