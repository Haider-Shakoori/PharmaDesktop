<UserControl x:Class="BusinessOS.Pharmacy.Desktop.DailyClosing.DailyClosingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">
    <UserControl.Resources>
        <Style x:Key="ClosingSummaryCard" TargetType="Border">
            <Setter Property="BorderBrush" Value="#D9FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16"
                                      ShadowDepth="3"
                                      Opacity="0.10"
                                      RenderingBias="Performance" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ClosingSummaryLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="ClosingSummaryValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,7,0,4" />
        </Style>

        <Style x:Key="ClosingSummaryHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="ClosingSummaryBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style x:Key="ClosingPanel" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DCE5F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="ClosingSectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="ClosingSectionHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="ClosingLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="FontSize" Value="11.3" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <Style x:Key="SnapshotLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="FontSize" Value="11.2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SnapshotValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="FontSize" Value="11.8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ClosingTableHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Height" Value="42" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="ClosingTableCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#115E59" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ClosingTableRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="43" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E8EEF4" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#FBFCFE" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F3FAF8" />
                    <Setter Property="BorderBrush" Value="#D7EEE9" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E9FBF7" />
                    <Setter Property="Foreground" Value="#115E59" />
                    <Setter Property="BorderBrush" Value="#99E7D9" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ClosingTable" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="AlternationCount" Value="2" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="CellStyle" Value="{StaticResource ClosingTableCell}" />
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource ClosingTableHeader}" />
            <Setter Property="RowStyle" Value="{StaticResource ClosingTableRow}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource PageBackgroundBrush}">
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Eyebrow}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrandPrimaryBrush}" />
                    <TextBlock Text="{Binding Title}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,3,0,0" />
                    <TextBlock Text="{Binding Subtitle}"
                               FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0"
                               MaxWidth="830"
                               HorizontalAlignment="Left" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Refresh"
                        Command="{Binding LoadCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Height="38"
                        Padding="14,7"
                        VerticalAlignment="Center" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource ClosingSummaryCard}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FAFFFFFF" Offset="0" />
                            <GradientStop Color="#F0FFFFFF" Offset=".56" />
                            <GradientStop Color="#E2F8FAFC" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="Gross sales" Style="{StaticResource ClosingSummaryLabel}" />
                            <Border Style="{StaticResource ClosingSummaryBadge}" Background="#78CFFAFE">
                                <TextBlock Text="AFN" Foreground="#0E7490" FontSize="9.5" FontWeight="Bold" />
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1"
                                   Text="{Binding Workspace.Snapshot.GrossSales, StringFormat=؋ {0:N2}, TargetNullValue='؋ 0.00'}"
                                   Style="{StaticResource ClosingSummaryValue}"
                                   Foreground="#0E7490" />
                        <TextBlock Grid.Row="2"
                                   Text="Sales before discounts and returns"
                                   Style="{StaticResource ClosingSummaryHint}" />
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource ClosingSummaryCard}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FAFFFFFF" Offset="0" />
                            <GradientStop Color="#F0FFFFFF" Offset=".55" />
                            <GradientStop Color="#E2F8FAFC" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="Expected cash" Style="{StaticResource ClosingSummaryLabel}" />
                            <Border Style="{StaticResource ClosingSummaryBadge}" Background="#74D1FAE5">
                                <TextBlock Text="CASH" Foreground="#047857" FontSize="9.5" FontWeight="Bold" />
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1"
                                   Text="{Binding Workspace.Snapshot.ExpectedCash, StringFormat=؋ {0:N2}, TargetNullValue='؋ 0.00'}"
                                   Style="{StaticResource ClosingSummaryValue}"
                                   Foreground="#047857" />
                        <TextBlock Grid.Row="2"
                                   Text="Opening cash plus cash collected"
                                   Style="{StaticResource ClosingSummaryHint}" />
                    </Grid>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource ClosingSummaryCard}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FAFFFFFF" Offset="0" />
                            <GradientStop Color="#F0FFFFFF" Offset=".54" />
                            <GradientStop Color="#E2F8FAFC" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="Cash collected" Style="{StaticResource ClosingSummaryLabel}" />
                            <Border Style="{StaticResource ClosingSummaryBadge}" Background="#70E9D5FF">
                                <TextBlock Text="TODAY" Foreground="#6D28D9" FontSize="9.5" FontWeight="Bold" />
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1"
                                   Text="{Binding Workspace.Snapshot.CashCollected, StringFormat=؋ {0:N2}, TargetNullValue='؋ 0.00'}"
                                   Style="{StaticResource ClosingSummaryValue}"
                                   Foreground="#6D28D9" />
                        <TextBlock Grid.Row="2"
                                   Text="Cash payments received for the day"
                                   Style="{StaticResource ClosingSummaryHint}" />
                    </Grid>
                </Border>

                <Border Grid.Column="6" Style="{StaticResource ClosingSummaryCard}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FAFFFFFF" Offset="0" />
                            <GradientStop Color="#F0FFFFFF" Offset=".54" />
                            <GradientStop Color="#E2F8FAFC" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="Day status" Style="{StaticResource ClosingSummaryLabel}" />
                            <Border Style="{StaticResource ClosingSummaryBadge}">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource ClosingSummaryBadge}">
                                        <Setter Property="Background" Value="#DBEAFE" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Workspace.Closing.Status}" Value="finalized">
                                                <Setter Property="Background" Value="#FEF3C7" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Workspace.Closing.Status}" Value="approved">
                                                <Setter Property="Background" Value="#D1FAE5" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Workspace.Closing.Status}" Value="reopened">
                                                <Setter Property="Background" Value="#EDE9FE" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="STATE"
                                           Foreground="#475569"
                                           FontSize="9.5"
                                           FontWeight="Bold" />
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1"
                                   Text="{Binding DayStatusText}"
                                   Style="{StaticResource ClosingSummaryValue}"
                                   FontSize="20" />
                        <TextBlock Grid.Row="2"
                                   Text="{Binding Workspace.Snapshot.BusinessDate, StringFormat=Business date {0:yyyy-MM-dd}, TargetNullValue='Business date —'}"
                                   Style="{StaticResource ClosingSummaryHint}" />
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.02*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1.25*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="0.98*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource ClosingPanel}">
                    <StackPanel>
                        <TextBlock Text="Cashier shift" Style="{StaticResource ClosingSectionTitle}" />
                        <TextBlock Text="Open your till, reconcile physical cash, and close the active shift before finalizing the day."
                                   Style="{StaticResource ClosingSectionHint}"
                                   Margin="0,3,0,14" />

                        <TextBlock Text="Location" Style="{StaticResource ClosingLabel}" />
                        <ComboBox ItemsSource="{Binding Locations}"
                                  SelectedItem="{Binding SelectedLocation}"
                                  DisplayMemberPath="Name"
                                  Height="38"
                                  Padding="8,4"
                                  Margin="0,0,0,12" />

                        <Border Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="11"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Open shift"
                                           FontSize="12.2"
                                           FontWeight="SemiBold"
                                           Foreground="#0F172A" />
                                <TextBlock Text="Enter the cash physically placed in the till at the start of the shift."
                                           Style="{StaticResource ClosingSectionHint}"
                                           Margin="0,2,0,9" />

                                <TextBlock Text="Opening cash" Style="{StaticResource ClosingLabel}" />
                                <Border Background="White"
                                        BorderBrush="#CBD5E1"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Height="38">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="؋"
                                                   Foreground="#0F766E"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding OpeningCash, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Padding="0"
                                                 VerticalContentAlignment="Center" />
                                    </Grid>
                                </Border>

                                <Button Content="Open shift"
                                        Command="{Binding OpenShiftCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        Height="36"
                                        Padding="13,6"
                                        HorizontalAlignment="Right"
                                        Margin="0,9,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="#F0FDFA"
                                BorderBrush="#CCFBF1"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="11">
                            <StackPanel>
                                <TextBlock Text="Reconcile &amp; close shift"
                                           FontSize="12.2"
                                           FontWeight="SemiBold"
                                           Foreground="#0F172A" />
                                <TextBlock Text="{Binding Workspace.MyOpenShift.Status, StringFormat=Current shift status: {0}, TargetNullValue='No open shift'}"
                                           Style="{StaticResource ClosingSectionHint}"
                                           Margin="0,2,0,9" />

                                <TextBlock Text="Counted cash" Style="{StaticResource ClosingLabel}" />
                                <Border Background="White"
                                        BorderBrush="#99E7D9"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Height="38"
                                        Margin="0,0,0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="؋"
                                                   Foreground="#0F766E"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding CountedCash, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Padding="0"
                                                 VerticalContentAlignment="Center" />
                                    </Grid>
                                </Border>

                                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="64"
                                         Padding="9,7"
                                         VerticalScrollBarVisibility="Auto"
                                         ToolTip="Closing notes" />

                                <Button Content="Close my shift"
                                        Command="{Binding CloseShiftCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Height="36"
                                        Padding="13,6"
                                        HorizontalAlignment="Right"
                                        Margin="0,9,0,0"
                                        Foreground="#0F766E"
                                        BorderBrush="#99E7D9"
                                        Background="#F0FDFA" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource ClosingPanel}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Today’s financial snapshot"
                                           Style="{StaticResource ClosingSectionTitle}" />
                                <TextBlock Text="Review the sales and payment totals that feed this closing."
                                           Style="{StaticResource ClosingSectionHint}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Background="#EFF6FF"
                                    CornerRadius="10"
                                    Padding="9,4"
                                    VerticalAlignment="Top">
                                <TextBlock Text="{Binding Workspace.Snapshot.BusinessDate, StringFormat={}{0:yyyy-MM-dd}, TargetNullValue='—'}"
                                           Foreground="#1D4ED8"
                                           FontSize="10.5"
                                           FontWeight="SemiBold" />
                            </Border>
                        </Grid>

                        <Border Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Text="Gross sales" Style="{StaticResource SnapshotLabel}" />
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{Binding Workspace.Snapshot.GrossSales, StringFormat=؋ {0:N2}, TargetNullValue='؋ 0.00'}"
                                           Style="{StaticResource SnapshotValue}" />

                                <TextBlock Grid.Row="1" Text="Discounts" Style="{StaticResource SnapshotLabel}" Margin="0,10,0,0" />
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Text="{Binding Workspace.Snapshot.DiscountTotal, StringFormat=؋ {0:N2}, TargetNullValue='؋ 0.00'}"
                                           Style="{StaticResource SnapshotValue}"
                                           Foreground="#B45309"
                                           Margin="0,10,0,0" />

                                <TextBlock Grid.Row="2" Text="Returns" Style="{StaticResource SnapshotLabel}" Margin="0,10,0,0" />
                                <TextBlock Grid.Row="2" Grid.Column="1"
                                           Text="{Binding Workspace.Snapshot.ReturnsTotal, StringFormat=؋ {0:N2}, TargetNullValue='؋ 0.00'}"
                                           Style="{StaticResource SnapshotValue}"
                                           Foreground="#B91C1C"
                                           Margin="0,10,0,0" />

                                <Border Grid.Row="3" Grid.ColumnSpan="2"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="0,1,0,0"
                                        Margin="0,11,0,0" />

                                <TextBlock Grid.Row="4" Text="Cash collected" Style="{StaticResource SnapshotLabel}" Margin="0,10,0,0" />
                                <TextBlock Grid.Row="4" Grid.Column="1"
                                           Text="{Binding Workspace.Snapshot.CashCollected, StringFormat=؋ {0:N2}, TargetNullValue='؋ 0.00'}"
                                           Style="{StaticResource SnapshotValue}"
                                           Foreground="#047857"
                                           Margin="0,10,0,0" />

                                <TextBlock Grid.Row="5" Text="Bank" Style="{StaticResource SnapshotLabel}" Margin="0,10,0,0" />
                                <TextBlock Grid.Row="5" Grid.Column="1"
                                           Text="{Binding Workspace.Snapshot.BankCollected, StringFormat=؋ {0:N2}, TargetNullValue='؋ 0.00'}"
                                           Style="{StaticResource SnapshotValue}"
                                           Margin="0,10,0,0" />

                                <TextBlock Grid.Row="6" Text="Mobile" Style="{StaticResource SnapshotLabel}" Margin="0,10,0,0" />
                                <TextBlock Grid.Row="6" Grid.Column="1"
                                           Text="{Binding Workspace.Snapshot.MobileCollected, StringFormat=؋ {0:N2}, TargetNullValue='؋ 0.00'}"
                                           Style="{StaticResource SnapshotValue}"
                                           Margin="0,10,0,0" />

                                <TextBlock Grid.Row="7" Text="Credit sales" Style="{StaticResource SnapshotLabel}" Margin="0,10,0,0" />
                                <TextBlock Grid.Row="7" Grid.Column="1"
                                           Text="{Binding Workspace.Snapshot.CreditSales, StringFormat=؋ {0:N2}, TargetNullValue='؋ 0.00'}"
                                           Style="{StaticResource SnapshotValue}"
                                           Margin="0,10,0,0" />

                                <TextBlock Grid.Row="8" Text="Opening cash" Style="{StaticResource SnapshotLabel}" Margin="0,10,0,0" />
                                <TextBlock Grid.Row="8" Grid.Column="1"
                                           Text="{Binding Workspace.Snapshot.OpeningCash, StringFormat=؋ {0:N2}, TargetNullValue='؋ 0.00'}"
                                           Style="{StaticResource SnapshotValue}"
                                           Margin="0,10,0,0" />
                            </Grid>
                        </Border>

                        <Border Background="#ECFDF5"
                                BorderBrush="#A7F3D0"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12"
                                Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Expected cash"
                                               Foreground="#065F46"
                                               FontSize="11.2"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Opening cash + today's cash collections"
                                               Foreground="#478477"
                                               FontSize="10.2"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Workspace.Snapshot.ExpectedCash, StringFormat=؋ {0:N2}, TargetNullValue='؋ 0.00'}"
                                           Foreground="#047857"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource ClosingPanel}">
                    <StackPanel>
                        <TextBlock Text="Day controls" Style="{StaticResource ClosingSectionTitle}" />
                        <TextBlock Text="Finalize after every cashier shift is closed. Approval locks the reviewed result; reopening requires a reason."
                                   Style="{StaticResource ClosingSectionHint}"
                                   Margin="0,3,0,14" />

                        <Border Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Closing state"
                                               Foreground="#64748B"
                                               FontSize="10.5" />
                                    <TextBlock Text="{Binding DayStatusText}"
                                               Foreground="#0F172A"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock Text="Variance"
                                               Foreground="#64748B"
                                               FontSize="10.5"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding Workspace.Closing.Variance, StringFormat=؋ {0:N2}, TargetNullValue='—'}"
                                               Foreground="#0F172A"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Right"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Button Content="Finalize day"
                                Command="{Binding FinalizeCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Height="40"
                                Padding="14,7"
                                HorizontalContentAlignment="Center" />

                        <Button Content="Approve closing"
                                Command="{Binding ApproveCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Height="40"
                                Padding="14,7"
                                Margin="0,8,0,0"
                                Foreground="#047857"
                                BorderBrush="#A7F3D0"
                                Background="#ECFDF5"
                                HorizontalContentAlignment="Center" />

                        <Border Background="#FFF7ED"
                                BorderBrush="#FED7AA"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="11"
                                Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Reopen a closed business day"
                                           Foreground="#9A3412"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Use this only when corrections are required. Reopening reverses the closing variance entries and allows sales to continue for this business date."
                                           Foreground="#B45309"
                                           FontSize="10.3"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,9" />

                                <TextBlock Text="Reason" Style="{StaticResource ClosingLabel}" />
                                <TextBox Text="{Binding ReopenReason, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="76"
                                         Padding="9,7"
                                         VerticalScrollBarVisibility="Auto"
                                         ToolTip="Explain why this business day must be reopened" />

                                <Button Content="Reopen day"
                                        Command="{Binding ReopenCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Height="36"
                                        Padding="13,6"
                                        HorizontalAlignment="Right"
                                        Margin="0,9,0,0"
                                        Foreground="#B91C1C"
                                        BorderBrush="#FCA5A5"
                                        Background="#FFF7F7" />
                            </StackPanel>
                        </Border>

                        <Border Background="#EFF6FF"
                                BorderBrush="#DBEAFE"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10"
                                Margin="0,12,0,0">
                            <TextBlock Text="Finalization remains disabled while your cashier shift is open. Close and reconcile the shift first."
                                       Foreground="#1D4ED8"
                                       FontSize="10.3"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="3"
                    Background="White"
                    BorderBrush="#DCE5F0"
                    BorderThickness="1"
                    CornerRadius="13"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="14,12,14,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Cashier shifts"
                                       Style="{StaticResource ClosingSectionTitle}" />
                            <TextBlock Text="Review opening, expected, counted cash and variance for every shift in this business day."
                                       Style="{StaticResource ClosingSectionHint}"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="#F1F5F9"
                                CornerRadius="10"
                                Padding="9,4"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding ShiftSummaryText}"
                                       Foreground="#475569"
                                       FontSize="10.5"
                                       FontWeight="SemiBold" />
                        </Border>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Workspace.Shifts}"
                              Style="{StaticResource ClosingTable}"
                              Margin="12,0,12,12"
                              MinHeight="190">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="User"
                                                Binding="{Binding UserId}"
                                                Width="1.5*"
                                                MinWidth="150" />
                            <DataGridTemplateColumn Header="Status" Width="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10"
                                                Padding="9,3"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#DBEAFE" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="closed">
                                                            <Setter Property="Background" Value="#D1FAE5" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}"
                                                       FontSize="10.2"
                                                       FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#1D4ED8" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="closed">
                                                                <Setter Property="Foreground" Value="#047857" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Opening"
                                                Binding="{Binding OpeningCash, StringFormat=؋ {0:N2}}"
                                                Width="120" />
                            <DataGridTextColumn Header="Expected"
                                                Binding="{Binding ExpectedCash, StringFormat=؋ {0:N2}}"
                                                Width="120" />
                            <DataGridTextColumn Header="Counted"
                                                Binding="{Binding CountedCash, StringFormat=؋ {0:N2}}"
                                                Width="120" />
                            <DataGridTextColumn Header="Variance"
                                                Binding="{Binding Variance, StringFormat=؋ {0:N2}}"
                                                Width="120" />
                            <DataGridTextColumn Header="Opened"
                                                Binding="{Binding OpenedAt, StringFormat={}{0:HH:mm}}"
                                                Width="95" />
                            <DataGridTextColumn Header="Closed"
                                                Binding="{Binding ClosedAt, StringFormat={}{0:HH:mm}}"
                                                Width="95" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Grid Grid.Row="4" Margin="2,9,2,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="#64748B"
                           FontSize="11.2"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="All close, approve, and reopen actions remain auditable."
                           Foreground="#94A3B8"
                           FontSize="10.5"
                           VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
