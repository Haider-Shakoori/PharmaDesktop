<UserControl x:Class="BusinessOS.Pharmacy.Desktop.DailyClosing.DailyClosingView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel><Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding LoadCommand}" Padding="12,6"/><StackPanel><TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}"/></StackPanel></DockPanel>
<Grid Grid.Row="1" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
<Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,12,0"><StackPanel><TextBlock Text="Location" Style="{StaticResource MutedText}"/><ComboBox ItemsSource="{Binding Locations}" SelectedItem="{Binding SelectedLocation}" DisplayMemberPath="Name"/><TextBlock Text="Opening cash" Style="{StaticResource MutedText}" Margin="0,8,0,0"/><TextBox Text="{Binding OpeningCash}"/><Button Content="Open shift" Command="{Binding OpenShiftCommand}" Padding="12,7" Margin="0,8,0,0"/><TextBlock Text="Counted cash" Style="{StaticResource MutedText}" Margin="0,12,0,0"/><TextBox Text="{Binding CountedCash}"/><TextBox Text="{Binding Notes}" Height="70" AcceptsReturn="True" ToolTip="Notes" Margin="0,8,0,0"/><Button Content="Close my shift" Command="{Binding CloseShiftCommand}" Padding="12,7" Margin="0,8,0,0"/></StackPanel></Border>
<Border Grid.Column="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,12,0"><StackPanel><TextBlock Text="Current snapshot" FontWeight="SemiBold"/><TextBlock Text="{Binding Workspace.Snapshot.BusinessDate, StringFormat=Business date: {0}}"/><TextBlock Text="{Binding Workspace.Snapshot.GrossSales, StringFormat=Gross sales: AFN {0:N4}}"/><TextBlock Text="{Binding Workspace.Snapshot.DiscountTotal, StringFormat=Discounts: AFN {0:N4}}"/><TextBlock Text="{Binding Workspace.Snapshot.ReturnsTotal, StringFormat=Returns: AFN {0:N4}}"/><TextBlock Text="{Binding Workspace.Snapshot.CashCollected, StringFormat=Cash: AFN {0:N4}}"/><TextBlock Text="{Binding Workspace.Snapshot.BankCollected, StringFormat=Bank: AFN {0:N4}}"/><TextBlock Text="{Binding Workspace.Snapshot.MobileCollected, StringFormat=Mobile: AFN {0:N4}}"/><TextBlock Text="{Binding Workspace.Snapshot.CreditSales, StringFormat=Credit: AFN {0:N4}}"/><TextBlock Text="{Binding Workspace.Snapshot.OpeningCash, StringFormat=Opening cash: AFN {0:N4}}"/><TextBlock Text="{Binding Workspace.Snapshot.ExpectedCash, StringFormat=Expected cash: AFN {0:N4}}" FontWeight="SemiBold"/><TextBlock Text="{Binding Workspace.Closing.Status, StringFormat=Closing status: {0}}" Margin="0,8,0,0"/></StackPanel></Border>
<Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12"><StackPanel><Button Content="Finalize day" Command="{Binding FinalizeCommand}" Padding="12,7"/><Button Content="Approve" Command="{Binding ApproveCommand}" Padding="12,7" Margin="0,8,0,0"/><TextBox Text="{Binding ReopenReason}" Height="70" AcceptsReturn="True" ToolTip="Reopen reason" Margin="0,14,0,0"/><Button Content="Reopen" Command="{Binding ReopenCommand}" Padding="12,7" Margin="0,8,0,0"/></StackPanel></Border>
</Grid>
<Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,18,0,0"><StackPanel><TextBlock Text="Shifts" FontWeight="SemiBold"/><DataGrid ItemsSource="{Binding Workspace.Shifts}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="220"><DataGrid.Columns><DataGridTextColumn Header="User" Binding="{Binding UserId}" Width="*"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/><DataGridTextColumn Header="Opening" Binding="{Binding OpeningCash, StringFormat=N4}" Width="100"/><DataGridTextColumn Header="Expected" Binding="{Binding ExpectedCash, StringFormat=N4}" Width="100"/><DataGridTextColumn Header="Counted" Binding="{Binding CountedCash, StringFormat=N4}" Width="100"/><DataGridTextColumn Header="Variance" Binding="{Binding Variance, StringFormat=N4}" Width="100"/></DataGrid.Columns></DataGrid></StackPanel></Border>
</Grid></ScrollViewer></UserControl>