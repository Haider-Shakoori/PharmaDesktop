<UserControl x:Class="BusinessOS.Pharmacy.Desktop.Customers.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleText}"/>
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}"
                    Style="{StaticResource PrimaryButton}" Padding="14,8"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource SurfaceCard}" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Padding="9,7" Margin="0,0,10,0"
                         ToolTip="Name, phone or email"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding ActiveFilters}"
                          SelectedItem="{Binding SelectedActiveFilter}"
                          Margin="0,0,10,0"/>
                <Button Grid.Column="2" Content="Search" Command="{Binding SearchCommand}" Padding="14,8"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="0.9*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SurfaceCard}">
                <DataGrid ItemsSource="{Binding Customers}"
                          SelectedItem="{Binding SelectedCustomer}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Customer" Binding="{Binding Name}" Width="1.5*"/>
                        <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="120"/>
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="1.2*"/>
                        <DataGridTextColumn Header="Credit limit" Binding="{Binding CreditLimit, StringFormat=N4}" Width="115"/>
                        <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="65"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource SurfaceCard}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Customer editor" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                        <TextBlock Text="Name"/>
                        <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Phone"/>
                                <TextBox Text="{Binding CustomerPhone}" Margin="0,4,0,10"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Email"/>
                                <TextBox Text="{Binding CustomerEmail}" Margin="0,4,0,10"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Credit limit (AFN)"/>
                        <TextBox Text="{Binding CreditLimit}" Margin="0,4,0,6"/>
                        <TextBlock Text="{Binding CreditRuleText}"
                                   Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>

                        <TextBlock Text="Notes"/>
                        <TextBox Text="{Binding CustomerNotes}"
                                 AcceptsReturn="True"
                                 Height="90"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0,4,0,10"/>

                        <CheckBox Content="Active" IsChecked="{Binding CustomerIsActive}" Margin="0,0,0,14"/>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="New" Command="{Binding NewCommand}" Padding="14,8" Margin="0,0,8,0"/>
                            <Button Content="Save customer"
                                    Command="{Binding SaveCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="14,8"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" Margin="0,10,0,0"/>
    </Grid>
</UserControl>
