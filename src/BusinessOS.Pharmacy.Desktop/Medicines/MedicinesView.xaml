<UserControl x:Class="BusinessOS.Pharmacy.Desktop.Medicines.MedicinesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BusinessOS.Pharmacy.Desktop.Controls"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">
    <UserControl.Resources>
        <Style x:Key="MedicineToolbarBox" TargetType="Control">
            <Setter Property="Height" Value="38" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="MedicineTableHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Height" Value="42" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid Background="{TemplateBinding Background}">
                            <Border BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </Border>

                            <Thumb x:Name="PART_LeftHeaderGripper"
                                   Width="5"
                                   HorizontalAlignment="Left"
                                   Background="Transparent"
                                   Cursor="SizeWE" />
                            <Thumb x:Name="PART_RightHeaderGripper"
                                   Width="5"
                                   HorizontalAlignment="Right"
                                   Background="Transparent"
                                   Cursor="SizeWE" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MedicineTableCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontWeight" Value="Bold" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MedicineTableRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="42" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D9E2EC" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#FAFCFF" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0FDFA" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0F766E" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="BorderBrush" Value="#0D9488" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MedicineTable" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="AlternationCount" Value="2" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="CellStyle" Value="{StaticResource MedicineTableCell}" />
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource MedicineTableHeader}" />
            <Setter Property="RowStyle" Value="{StaticResource MedicineTableRow}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style x:Key="MedicineTextColumnText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="MedicineRowPrimaryText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MedicineRowSecondaryText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MedicineActionButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#2563EB" />
            <Setter Property="Background" Value="#EFF6FF" />
            <Setter Property="BorderBrush" Value="#DBEAFE" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="Background" Value="#28FFFFFF" />
                    <Setter Property="BorderBrush" Value="#66FFFFFF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="#DCFCE7" />
        </Style>

        <Style x:Key="ModalFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <Style x:Key="ModalFieldBox" TargetType="Control">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource PageBackgroundBrush}">
        <Grid Margin="22" x:Name="MedicinePageContent">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Effect" Value="{x:Null}" />
                    <Setter Property="IsHitTestVisible" Value="True" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEditorOpen}" Value="True">
                            <Setter Property="IsHitTestVisible" Value="False" />
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <BlurEffect Radius="7"
                                                KernelType="Gaussian"
                                                RenderingBias="Performance" />
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <controls:PageHeader Grid.Row="0"
                                 Eyebrow="Medicine catalog"
                                 Title="{Binding Title}"
                                 Description="{Binding Subtitle}" />

            <!-- Tailwind/DataTables-style medicine catalog -->
            <Border Grid.Row="1"
                    Grid.RowSpan="2"
                    Background="White"
                    BorderBrush="#DCE5F0"
                    BorderThickness="1"
                    CornerRadius="13"
                    ClipToBounds="True"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Single toolbar inside the table card, matching the approved reference -->
                    <Grid Margin="12,12,12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.35*"/>
                            <ColumnDefinition Width="185"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Background="#FFFFFF"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                CornerRadius="8"
                                Height="38"
                                Margin="0,0,10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Data="{StaticResource IconSearch}"
                                      Width="15" Height="15"
                                      Stroke="#64748B"
                                      StrokeThickness="1.7"
                                      Fill="Transparent"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                                <Grid Grid.Column="1">
                                    <TextBlock Text="Search medicines..."
                                               Foreground="#94A3B8"
                                               FontSize="11.5"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="0"
                                             FontSize="12"
                                             VerticalContentAlignment="Center"
                                             ToolTip="Brand, generic, code, barcode or strength"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1"
                                Background="White"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                CornerRadius="8"
                                Height="38"
                                Margin="0,0,10,0">
                            <Grid>
                                <TextBlock Text="All Categories"
                                           Foreground="#475569"
                                           FontSize="11.5"
                                           Margin="11,0,28,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedFilterCategory}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ComboBox ItemsSource="{Binding Categories}"
                                          SelectedItem="{Binding SelectedFilterCategory}"
                                          DisplayMemberPath="Name"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Padding="8,0"
                                          FontSize="11.5"
                                          VerticalContentAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2"
                                Background="White"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                CornerRadius="8"
                                Height="38"
                                Margin="0,0,10,0">
                            <ComboBox ItemsSource="{Binding StatusOptions}"
                                      SelectedItem="{Binding SelectedStatus}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Padding="8,0"
                                      FontSize="11.5"
                                      VerticalContentAlignment="Center"/>
                        </Border>

                        <Button Grid.Column="3"
                                Content="{Binding TemplateLabel}"
                                Click="OnDownloadTemplateClick"
                                Style="{StaticResource SecondaryButton}"
                                Height="38"
                                Padding="11,7"
                                Margin="0,0,8,0"/>

                        <Button Grid.Column="4"
                                Content="{Binding ImportLabel}"
                                Click="OnImportCsvClick"
                                Style="{StaticResource SecondaryButton}"
                                Height="38"
                                Padding="11,7"
                                Margin="0,0,8,0"/>

                        <Button Grid.Column="5"
                                Command="{Binding NewCommand}"
                                Height="38"
                                Padding="14,7"
                                Background="#1677FF"
                                BorderBrush="#1677FF"
                                Foreground="White"
                                FontWeight="SemiBold"
                                FontSize="12">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconAdd}"
                                      Width="14" Height="14"
                                      Stroke="White"
                                      StrokeThickness="2"
                                      Fill="Transparent"
                                      Stretch="Uniform"
                                      Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding AddMedicineLabel}" Foreground="White"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Medicines}"
                              SelectedItem="{Binding SelectedMedicine}"
                              Style="{StaticResource MedicineTable}"
                              Margin="12,0,12,0">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Medicine" Width="2.1*" MinWidth="210">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center"
                                                    HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding BrandName}"
                                                       Style="{StaticResource MedicineRowPrimaryText}"
                                                       FontWeight="SemiBold"
                                                       FontSize="12.2"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding GenericName}"
                                                       Style="{StaticResource MedicineRowSecondaryText}"
                                                       FontSize="10.5"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Code"
                                                Binding="{Binding MedicineCode}"
                                                ElementStyle="{StaticResource MedicineTextColumnText}"
                                                Width="105"/>
                            <DataGridTextColumn Header="Category"
                                                Binding="{Binding CategoryName}"
                                                ElementStyle="{StaticResource MedicineTextColumnText}"
                                                Width="1.2*"
                                                MinWidth="120"/>
                            <DataGridTemplateColumn Header="Strength / Form"
                                                    Width="1.35*"
                                                    MinWidth="135">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Strength}" Style="{StaticResource MedicineRowPrimaryText}"/>
                                            <TextBlock Text="  ·  " Style="{StaticResource MedicineRowSecondaryText}"/>
                                            <TextBlock Text="{Binding DosageForm}" Style="{StaticResource MedicineRowSecondaryText}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Sale Unit"
                                                Binding="{Binding SaleUnit}"
                                                ElementStyle="{StaticResource MedicineTextColumnText}"
                                                Width="90"/>
                            <DataGridTextColumn Header="Reorder"
                                                Binding="{Binding ReorderLevel, StringFormat={}{0:0.####}}"
                                                ElementStyle="{StaticResource MedicineTextColumnText}"
                                                Width="85"/>

                            <DataGridTemplateColumn Header="Status" Width="92">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource StatusPill}">
                                                    <Setter Property="Background" Value="#D1FAE5"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                            <Setter Property="Background" Value="#28FFFFFF"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="10.3" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Active"/>
                                                        <Setter Property="Foreground" Value="#047857"/>
                                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                                        <Setter Property="TextAlignment" Value="Left"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Text" Value="Inactive"/>
                                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                                <Setter Property="Foreground" Value="White"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Actions" Width="72">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.EditMedicineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MedicineActionButton}"
                                                Width="30"
                                                Height="28"
                                                ToolTip="Edit medicine"
                                                VerticalAlignment="Center">
                                            <Path Data="M4,16 L4,20 L8,20 L19,9 L15,5 Z M13.8,6.2 L17.8,10.2"
                                                  Width="13" Height="13"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.7"
                                                  Fill="Transparent"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Stretch="Uniform"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- DataTables-style footer -->
                    <Grid Grid.Row="2"
                          Margin="14,10,14,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PageSummary}"
                                       Foreground="#64748B"
                                       FontSize="11.5"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="   Rows:"
                                       Foreground="#94A3B8"
                                       FontSize="11"
                                       VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding PageSizeOptions}"
                                      SelectedItem="{Binding PageSize}"
                                      Width="58"
                                      Height="28"
                                      Margin="5,0,0,0"
                                      FontSize="11"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Previous"
                                    Command="{Binding PreviousPageCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Height="30"
                                    MinHeight="30"
                                    Padding="10,4"
                                    FontSize="11"
                                    Margin="0,0,5,0"/>

                            <ItemsControl ItemsSource="{Binding PageNumbers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}"
                                                Command="{Binding DataContext.GoToPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                MinWidth="30"
                                                Height="30"
                                                Padding="7,3"
                                                Margin="0,0,4,0"
                                                Background="White"
                                                Foreground="#334155"
                                                BorderBrush="#DCE5F0"
                                                FontSize="11"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Content="Next"
                                    Command="{Binding NextPageCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Height="30"
                                    MinHeight="30"
                                    Padding="10,4"
                                    FontSize="11"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- CSV preview remains available without cluttering the main catalog -->
            <Expander Grid.Row="3"
                      Header="CSV import preview"
                      IsExpanded="{Binding HasCsvPreview}"
                      Margin="0,10,0,0">
                <Border Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12"
                        Margin="0,6,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding CsvPreviewSummary}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <DataGrid ItemsSource="{Binding CsvPreviewRows}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  MaxHeight="190">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="45"/>
                                <DataGridTextColumn Header="Code" Binding="{Binding MedicineCode}" Width="90"/>
                                <DataGridTextColumn Header="Medicine" Binding="{Binding BrandName}" Width="*"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="75"/>
                                <DataGridTextColumn Header="Errors" Binding="{Binding Errors}" Width="1.5*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Button Content="Import valid rows"
                                Command="{Binding ImportValidRowsCommand}"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Right"
                                Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </Expander>
        </Grid>

        <!-- Modern Add / Edit medicine modal -->
        <Grid Panel.ZIndex="50"
              Visibility="{Binding IsEditorOpen, Converter={StaticResource GlobalBoolToVisibility}}">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#70F8FAFC" Offset="0" />
                    <GradientStop Color="#60E9EFF7" Offset="0.55" />
                    <GradientStop Color="#72FFFFFF" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <Border Width="960"
                    MaxHeight="760"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.22" Color="#0F172A"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="22,18,22,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding EditorTitle}"
                                       FontSize="21"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"/>
                            <TextBlock Text="Medicine details, units, tracking and reference data"
                                       Margin="0,4,0,0"
                                       Foreground="#64748B"
                                       FontSize="12"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="✕"
                                Command="{Binding CancelEditorCommand}"
                                Style="{StaticResource GhostButton}"
                                Foreground="#475569"
                                Width="34"
                                Height="34"
                                FontSize="15"/>
                    </Grid>

                    <TabControl Grid.Row="1"
                                Margin="18,0,18,0"
                                Background="Transparent"
                                BorderBrush="#E2E8F0">
                        <TabItem Header="General">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Grid Margin="18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="Brand name" Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox Text="{Binding BrandName, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ModalFieldBox}"
                                                 Margin="0,0,0,13"/>

                                        <TextBlock Text="Medicine code" Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox Text="{Binding MedicineCode, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ModalFieldBox}"
                                                 Margin="0,0,0,13"/>

                                        <TextBlock Text="Strength" Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox Text="{Binding Strength}"
                                                 Style="{StaticResource ModalFieldBox}"
                                                 Margin="0,0,0,13"/>

                                        <TextBlock Text="Category" Style="{StaticResource ModalFieldLabel}"/>
                                        <ComboBox ItemsSource="{Binding Categories}"
                                                  SelectedItem="{Binding SelectedCategory}"
                                                  DisplayMemberPath="Name"
                                                  Style="{StaticResource ModalFieldBox}"
                                                  Margin="0,0,0,13"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Generic name" Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox Text="{Binding GenericName}"
                                                 Style="{StaticResource ModalFieldBox}"
                                                 Margin="0,0,0,13"/>

                                        <TextBlock Text="Barcode (optional)" Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox Text="{Binding Barcode}"
                                                 Style="{StaticResource ModalFieldBox}"
                                                 Margin="0,0,0,13"/>

                                        <TextBlock Text="Dosage form" Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox Text="{Binding DosageForm}"
                                                 Style="{StaticResource ModalFieldBox}"
                                                 Margin="0,0,0,13"/>

                                        <TextBlock Text="Manufacturer" Style="{StaticResource ModalFieldLabel}"/>
                                        <ComboBox ItemsSource="{Binding Manufacturers}"
                                                  SelectedItem="{Binding SelectedManufacturer}"
                                                  DisplayMemberPath="Name"
                                                  Style="{StaticResource ModalFieldBox}"
                                                  Margin="0,0,0,13"/>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Units &amp; Tracking">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Grid Margin="18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Purchase unit" Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox Text="{Binding PurchaseUnit}"
                                                 Style="{StaticResource ModalFieldBox}"
                                                 Margin="0,0,0,13"/>

                                        <TextBlock Text="Units / purchase unit" Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox Text="{Binding UnitsPerPurchaseUnit, ValidatesOnExceptions=True}"
                                                 Style="{StaticResource ModalFieldBox}"
                                                 Margin="0,0,0,13"/>

                                        <CheckBox Content="Prescription required"
                                                  IsChecked="{Binding PrescriptionRequired}"
                                                  Margin="0,8,0,10"/>
                                        <CheckBox Content="Batch tracking required"
                                                  IsChecked="{Binding BatchTrackingRequired}"
                                                  Margin="0,0,0,10"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Sale unit" Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox Text="{Binding SaleUnit}"
                                                 Style="{StaticResource ModalFieldBox}"
                                                 Margin="0,0,0,13"/>

                                        <TextBlock Text="Reorder level" Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox Text="{Binding ReorderLevel, ValidatesOnExceptions=True}"
                                                 Style="{StaticResource ModalFieldBox}"
                                                 Margin="0,0,0,13"/>

                                        <CheckBox Content="Expiry tracking required"
                                                  IsChecked="{Binding ExpiryTrackingRequired}"
                                                  Margin="0,8,0,10"/>
                                        <CheckBox Content="Active medicine"
                                                  IsChecked="{Binding IsActive}"
                                                  Margin="0,0,0,10"/>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="References &amp; Notes">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Grid Margin="18">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="Add category" Style="{StaticResource ModalFieldLabel}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource ModalFieldBox}"/>
                                            <Button Grid.Column="1"
                                                    Content="Add"
                                                    Command="{Binding AddCategoryCommand}"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Foreground="#334155"
                                                    Margin="8,0,0,0"
                                                    Padding="11,6"/>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Add manufacturer" Style="{StaticResource ModalFieldLabel}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="105"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding NewManufacturerName, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource ModalFieldBox}"/>
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding NewManufacturerCountry, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource ModalFieldBox}"
                                                     Margin="8,0,0,0"
                                                     ToolTip="Country"/>
                                            <Button Grid.Column="2"
                                                    Content="Add"
                                                    Command="{Binding AddManufacturerCommand}"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Margin="8,0,0,0"
                                                    Padding="11,6"/>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,20,0,0">
                                        <TextBlock Text="Notes" Style="{StaticResource ModalFieldLabel}"/>
                                        <TextBox Text="{Binding Notes}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 MinHeight="120"
                                                 Padding="10"
                                                 VerticalScrollBarVisibility="Auto"/>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>

                    <Border Grid.Row="2"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="0,1,0,0"
                            CornerRadius="0,0,16,16"
                            Padding="18,13">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding StatusMessage}"
                                       Foreground="#64748B"
                                       FontSize="11.5"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Cancel"
                                        Command="{Binding CancelEditorCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Foreground="#334155"
                                        Padding="16,8"
                                        Margin="0,0,8,0"/>
                                <Button Content="{Binding SaveLabel}"
                                        Command="{Binding SaveCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        Foreground="White"
                                        Padding="18,8"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>