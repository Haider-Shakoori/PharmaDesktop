<UserControl x:Class="BusinessOS.Pharmacy.Desktop.Medicines.MedicinesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BusinessOS.Pharmacy.Desktop.Controls">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0"
                             Eyebrow="Medicine catalog"
                             Title="{Binding Title}"
                             Description="{Binding Subtitle}">
            <controls:PageHeader.Actions>
                <StackPanel Orientation="Horizontal">
                    <Button Content="{Binding TemplateLabel}"
                            Click="OnDownloadTemplateClick"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0"/>
                    <Button Content="{Binding ImportLabel}"
                            Click="OnImportCsvClick"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0"/>
                    <Button Content="{Binding AddMedicineLabel}"
                            Command="{Binding NewCommand}"
                            Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <Border Grid.Row="1" Style="{StaticResource SurfaceCard}" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,10,0" Padding="10,8"
                         ToolTip="Brand, generic, code, barcode or strength"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding SelectedFilterCategory}"
                          DisplayMemberPath="Name"
                          Margin="0,0,10,0"
                          ToolTip="Category filter"/>
                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding StatusOptions}"
                          SelectedItem="{Binding SelectedStatus}"
                          Margin="0,0,10,0"/>
                <Button Grid.Column="3" Content="Search" Command="{Binding SearchCommand}"
                        Padding="14,8"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="0.85*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SurfaceCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Medicine catalog" Style="{StaticResource SectionTitleText}"/>
                        <Button Grid.Column="1" Content="{Binding EditLabel}"
                                Command="{Binding EditSelectedCommand}"
                                Padding="10,6"/>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Medicines}"
                              SelectedItem="{Binding SelectedMedicine}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Medicine" Binding="{Binding BrandName}" Width="1.5*"/>
                            <DataGridTextColumn Header="Code" Binding="{Binding MedicineCode}" Width="100"/>
                            <DataGridTextColumn Header="Generic" Binding="{Binding GenericName}" Width="1.2*"/>
                            <DataGridTextColumn Header="Strength" Binding="{Binding Strength}" Width="90"/>
                            <DataGridTextColumn Header="Form" Binding="{Binding DosageForm}" Width="90"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="1.1*"/>
                            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="65"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2"
                               Text="{Binding StatusMessage}"
                               Style="{StaticResource MutedText}"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Brand name" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding BrandName, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10" Padding="9,7"/>

                                    <TextBlock Text="Medicine code" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding MedicineCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10" Padding="9,7"/>

                                    <TextBlock Text="Strength" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding Strength}" Margin="0,5,0,10" Padding="9,7"/>

                                    <TextBlock Text="Category" FontWeight="SemiBold"/>
                                    <ComboBox ItemsSource="{Binding Categories}"
                                              SelectedItem="{Binding SelectedCategory}"
                                              DisplayMemberPath="Name"
                                              Margin="0,5,0,10" Padding="5"/>

                                    <TextBlock Text="Purchase unit" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding PurchaseUnit}" Margin="0,5,0,10" Padding="9,7"/>

                                    <TextBlock Text="Units / purchase unit" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding UnitsPerPurchaseUnit, ValidatesOnExceptions=True}"
                                             Margin="0,5,0,10" Padding="9,7"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Generic name" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding GenericName}" Margin="0,5,0,10" Padding="9,7"/>

                                    <TextBlock Text="Barcode (optional)" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding Barcode}" Margin="0,5,0,10" Padding="9,7"/>

                                    <TextBlock Text="Dosage form" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding DosageForm}" Margin="0,5,0,10" Padding="9,7"/>

                                    <TextBlock Text="Manufacturer" FontWeight="SemiBold"/>
                                    <ComboBox ItemsSource="{Binding Manufacturers}"
                                              SelectedItem="{Binding SelectedManufacturer}"
                                              DisplayMemberPath="Name"
                                              Margin="0,5,0,10" Padding="5"/>

                                    <TextBlock Text="Sale unit" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding SaleUnit}" Margin="0,5,0,10" Padding="9,7"/>

                                    <TextBlock Text="Reorder level" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding ReorderLevel, ValidatesOnExceptions=True}"
                                             Margin="0,5,0,10" Padding="9,7"/>
                                </StackPanel>
                            </Grid>

                            <UniformGrid Columns="2" Margin="0,4,0,10">
                                <CheckBox Content="Prescription required" IsChecked="{Binding PrescriptionRequired}" Margin="0,4"/>
                                <CheckBox Content="Batch tracking required" IsChecked="{Binding BatchTrackingRequired}" Margin="0,4"/>
                                <CheckBox Content="Expiry tracking required" IsChecked="{Binding ExpiryTrackingRequired}" Margin="0,4"/>
                                <CheckBox Content="Active medicine" IsChecked="{Binding IsActive}" Margin="0,4"/>
                            </UniformGrid>

                            <TextBlock Text="Notes" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding Notes}" AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="62" Margin="0,5,0,12" Padding="9,7"/>

                            <Button Content="{Binding SaveLabel}" Command="{Binding SaveCommand}"
                                    Style="{StaticResource PrimaryButton}" MinHeight="40"/>
                        </StackPanel>
                    </Border>

                    <Expander Header="{Binding ReferencesTitle}" IsExpanded="False" Margin="0,0,0,12">
                        <Border Style="{StaticResource SurfaceCard}" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Add category" FontWeight="SemiBold"/>
                                <Grid Margin="0,6,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/>
                                    <Button Grid.Column="1" Content="Add" Command="{Binding AddCategoryCommand}" Margin="8,0,0,0" Padding="10,6"/>
                                </Grid>

                                <TextBlock Text="Add manufacturer" FontWeight="SemiBold"/>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding NewManufacturerName, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" ToolTip="Manufacturer name"/>
                                    <TextBox Grid.Column="1" Text="{Binding NewManufacturerCountry, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0" Padding="8,6" ToolTip="Country"/>
                                    <Button Grid.Column="2" Content="Add" Command="{Binding AddManufacturerCommand}" Margin="8,0,0,0" Padding="10,6"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Expander>

                    <Expander Header="CSV import preview" IsExpanded="{Binding HasCsvPreview}">
                        <Border Style="{StaticResource SurfaceCard}" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding CsvPreviewSummary}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <DataGrid ItemsSource="{Binding CsvPreviewRows}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          MaxHeight="220">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="45"/>
                                        <DataGridTextColumn Header="Code" Binding="{Binding MedicineCode}" Width="90"/>
                                        <DataGridTextColumn Header="Medicine" Binding="{Binding BrandName}" Width="*"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="75"/>
                                        <DataGridTextColumn Header="Errors" Binding="{Binding Errors}" Width="1.5*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Button Content="Import valid rows"
                                        Command="{Binding ImportValidRowsCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
