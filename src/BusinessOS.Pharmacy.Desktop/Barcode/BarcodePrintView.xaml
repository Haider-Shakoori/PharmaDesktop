<UserControl x:Class="BusinessOS.Pharmacy.Desktop.Barcode.BarcodePrintView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">
    <UserControl.Resources>
        <Style x:Key="BarcodePageEyebrow" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}" />
        </Style>

        <Style x:Key="BarcodePageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="BarcodePageSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="BarcodeGlassCard" TargetType="Border">
            <Setter Property="BorderBrush" Value="#B8FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#ECFFFFFF" Offset="0" />
                        <GradientStop Color="#D8F8FBFF" Offset="0.55" />
                        <GradientStop Color="#C7ECF4FF" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14"
                                      ShadowDepth="3"
                                      Opacity="0.10"
                                      RenderingBias="Performance" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BarcodeSectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#334155" />
        </Style>

        <Style x:Key="BarcodeFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <Style x:Key="BarcodeTableHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Height" Value="42" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid Background="{TemplateBinding Background}">
                            <Border BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </Border>
                            <Thumb x:Name="PART_LeftHeaderGripper"
                                   Width="5"
                                   HorizontalAlignment="Left"
                                   Background="Transparent"
                                   Cursor="SizeWE" />
                            <Thumb x:Name="PART_RightHeaderGripper"
                                   Width="5"
                                   HorizontalAlignment="Right"
                                   Background="Transparent"
                                   Cursor="SizeWE" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BarcodeTableCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontWeight" Value="Bold" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BarcodeTableRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="46" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D9E2EC" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#FAFCFF" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0FDFA" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0F766E" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="BorderBrush" Value="#0D9488" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BarcodeTextCell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="Foreground" Value="#334155" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BarcodePrimaryRowText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BarcodeSecondaryRowText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BarcodeOptionCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,14,8" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource PageBackgroundBrush}">
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Labels" Style="{StaticResource BarcodePageEyebrow}" />
                    <TextBlock Text="{Binding Title}"
                               Style="{StaticResource BarcodePageTitle}"
                               Margin="0,3,0,0" />
                    <TextBlock Text="{Binding Subtitle}"
                               Style="{StaticResource BarcodePageSubtitle}"
                               Margin="0,3,0,0"
                               MaxWidth="760"
                               HorizontalAlignment="Left" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.55*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1*" MinWidth="385" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="White"
                        BorderBrush="#DCE5F0"
                        BorderThickness="1"
                        CornerRadius="14"
                        ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Margin="12,12,12,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Background="White"
                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Height="38"
                                    Margin="0,0,8,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource IconSearch}"
                                          Width="15"
                                          Height="15"
                                          Stroke="#64748B"
                                          StrokeThickness="1.7"
                                          Fill="Transparent"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                    <Grid Grid.Column="1">
                                        <TextBlock Text="{Binding SearchLabel}"
                                                   Foreground="#94A3B8"
                                                   FontSize="11.5"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Padding="0"
                                                 FontSize="12"
                                                 VerticalContentAlignment="Center"
                                                 ToolTip="Medicine, code, generic or strength" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <Button Grid.Column="1"
                                    Content="Search"
                                    Command="{Binding SearchCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Height="38"
                                    Padding="15,7" />
                        </Grid>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Medicines}"
                                  SelectedItem="{Binding SelectedMedicine}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserResizeRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  RowHeaderWidth="0"
                                  AlternationCount="2"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  Background="White"
                                  BorderThickness="0"
                                  CellStyle="{StaticResource BarcodeTableCell}"
                                  ColumnHeaderStyle="{StaticResource BarcodeTableHeader}"
                                  RowStyle="{StaticResource BarcodeTableRow}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  Margin="12,0,12,0">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Medicine" Width="2*" MinWidth="190">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center"
                                                        HorizontalAlignment="Left">
                                                <TextBlock Style="{StaticResource BarcodePrimaryRowText}"
                                                           FontWeight="SemiBold"
                                                           FontSize="12.1"
                                                           TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding BrandName}" />
                                                    <Run Text=" " />
                                                    <Run Text="{Binding Strength}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding GenericName}"
                                                           Style="{StaticResource BarcodeSecondaryRowText}"
                                                           FontSize="10.2"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Code"
                                                    Binding="{Binding MedicineCode}"
                                                    ElementStyle="{StaticResource BarcodeTextCell}"
                                                    Width="125" />
                                <DataGridTextColumn Header="Sale unit"
                                                    Binding="{Binding SaleUnit}"
                                                    ElementStyle="{StaticResource BarcodeTextCell}"
                                                    Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Grid.Row="2" Margin="14,10,14,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding StatusMessage}"
                                       Foreground="#64748B"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />

                            <Border Grid.Column="1"
                                    Background="#ECFDF5"
                                    BorderBrush="#BBF7D0"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="9,4">
                                <TextBlock Text="{Binding ResultsLabel}"
                                           Foreground="#047857"
                                           FontSize="10.5"
                                           FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource BarcodeGlassCard}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding OptionsLabel}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#0F172A" />
                                    <TextBlock Text="{Binding PreviewLabel}"
                                               Foreground="#64748B"
                                               FontSize="11"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Background="#CCECFEFF"
                                        BorderBrush="#B7E9F8FF"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="9,4"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="LIVE"
                                               Foreground="#0E7490"
                                               FontSize="9.5"
                                               FontWeight="Bold" />
                                </Border>
                            </Grid>

                            <Border Background="#EFFFFFFF"
                                    BorderBrush="#CFE2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="14"
                                    MinHeight="190"
                                    Margin="0,0,0,14">
                                <Grid>
                                    <Border Background="#F8FAFC"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="10"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch">
                                        <Viewbox Stretch="Uniform"
                                                 StretchDirection="DownOnly"
                                                 MaxHeight="210">
                                            <ContentControl Content="{Binding PreviewElement}" />
                                        </Viewbox>
                                    </Border>
                                </Grid>
                            </Border>

                            <TextBlock Text="Label content"
                                       Style="{StaticResource BarcodeSectionLabel}"
                                       Margin="0,0,0,8" />

                            <WrapPanel Margin="0,0,0,8">
                                <CheckBox Content="{Binding PharmacyNameLabel}"
                                          IsChecked="{Binding ShowPharmacyName}"
                                          Style="{StaticResource BarcodeOptionCheck}" />
                                <CheckBox Content="{Binding MedicineNameLabel}"
                                          IsChecked="{Binding ShowMedicineName}"
                                          Style="{StaticResource BarcodeOptionCheck}" />
                                <CheckBox Content="{Binding PriceLabel}"
                                          IsChecked="{Binding ShowPrice}"
                                          Style="{StaticResource BarcodeOptionCheck}" />
                                <CheckBox Content="{Binding CodeLabel}"
                                          IsChecked="{Binding ShowCode}"
                                          Style="{StaticResource BarcodeOptionCheck}" />
                            </WrapPanel>

                            <Border BorderBrush="#DCE5F0"
                                    BorderThickness="0,1,0,0"
                                    Margin="0,2,0,14" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="{Binding PriceLabel}"
                                               Style="{StaticResource BarcodeFieldLabel}" />
                                    <Border Background="White"
                                            BorderBrush="#CBD5E1"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Height="38">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="؋"
                                                       Foreground="#0F766E"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Padding="0"
                                                     VerticalContentAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding CopiesLabel}"
                                               Style="{StaticResource BarcodeFieldLabel}" />
                                    <TextBox Text="{Binding Copies, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="38"
                                             Padding="9,7" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{Binding LabelSizeLabel}"
                                       Style="{StaticResource BarcodeFieldLabel}"
                                       Margin="0,14,0,5" />
                            <ComboBox ItemsSource="{Binding LabelSizes}"
                                      SelectedItem="{Binding SelectedLabelSize}"
                                      DisplayMemberPath="Name"
                                      MinHeight="38"
                                      VerticalContentAlignment="Center" />

                            <TextBlock Text="{Binding PrinterLabel}"
                                       Style="{StaticResource BarcodeFieldLabel}"
                                       Margin="0,14,0,5" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding Printers}"
                                          SelectedItem="{Binding SelectedPrinter}"
                                          MinHeight="38"
                                          VerticalContentAlignment="Center" />
                                <Button Grid.Column="2"
                                        Command="{Binding RefreshPrintersCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Width="38"
                                        Height="38"
                                        Padding="0"
                                        ToolTip="Refresh printer list">
                                    <Path Data="M18,8 A7,7 0 1 0 20,14 M18,8 L18,3 M18,8 L13,8"
                                          Width="15"
                                          Height="15"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Fill="Transparent"
                                          Stretch="Uniform" />
                                </Button>
                            </Grid>

                            <Button Command="{Binding PrintCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    MinHeight="44"
                                    Margin="0,18,0,0"
                                    Foreground="White">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <Path Data="M5,8 L19,8 L19,18 L16,18 L16,22 L8,22 L8,18 L5,18 Z M8,3 L16,3 L16,8 L8,8 Z M9,15 L15,15"
                                          Width="16"
                                          Height="16"
                                          Stroke="White"
                                          StrokeThickness="1.7"
                                          Fill="Transparent"
                                          Stretch="Uniform"
                                          Margin="0,0,7,0" />
                                    <TextBlock Text="{Binding PrintLabel}"
                                               Foreground="White"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <TextBlock Grid.Row="2"
                       Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="10.5"
                       Margin="2,8,0,0"
                       TextTrimming="CharacterEllipsis" />
        </Grid>
    </Grid>
</UserControl>