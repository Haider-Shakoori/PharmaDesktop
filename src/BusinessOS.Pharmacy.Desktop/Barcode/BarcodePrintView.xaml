<UserControl x:Class="BusinessOS.Pharmacy.Desktop.Barcode.BarcodePrintView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BusinessOS.Pharmacy.Desktop.Controls">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0"
                             Eyebrow="Labels"
                             Title="{Binding Title}"
                             Description="{Binding Subtitle}" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="440" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SurfaceCard}" Margin="0,0,14,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="40"
                                 Padding="9,7"
                                 ToolTip="Medicine, code, generic or strength" />
                        <Button Grid.Column="1"
                                Content="Search"
                                Command="{Binding SearchCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Margin="8,0,0,0"
                                Padding="16,8" />
                    </Grid>

                    <ListView Grid.Row="1"
                              ItemsSource="{Binding Medicines}"
                              SelectedItem="{Binding SelectedMedicine}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              BorderThickness="1">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold">
                                            <Run Text="{Binding BrandName}" />
                                            <Run Text="{Binding Strength}" Foreground="#64748B" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding GenericName}"
                                                   Style="{StaticResource MutedText}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding MedicineCode}"
                                                   FontFamily="Consolas"
                                                   FontSize="11.5"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding SaleUnit}"
                                                   Style="{StaticResource MutedText}"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock Grid.Row="2"
                               Text="{Binding StatusMessage}"
                               Style="{StaticResource MutedText}"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource SurfaceCard}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding OptionsLabel}" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{Binding PreviewLabel}" Style="{StaticResource MutedText}" Margin="0,3,0,10" />

                        <Border Background="#F8FAFC"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                MinHeight="150">
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="190">
                                <ContentControl Content="{Binding PreviewElement}" />
                            </Viewbox>
                        </Border>

                        <CheckBox Content="{Binding PharmacyNameLabel}" IsChecked="{Binding ShowPharmacyName}" Margin="0,14,0,0" />
                        <CheckBox Content="{Binding MedicineNameLabel}" IsChecked="{Binding ShowMedicineName}" Margin="0,8,0,0" />
                        <CheckBox Content="{Binding PriceLabel}" IsChecked="{Binding ShowPrice}" Margin="0,8,0,0" />
                        <CheckBox Content="{Binding CodeLabel}" IsChecked="{Binding ShowCode}" Margin="0,8,0,0" />

                        <TextBlock Text="{Binding PriceLabel}" FontWeight="SemiBold" Margin="0,14,0,6" />
                        <TextBox Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="38" Padding="9,7" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding CopiesLabel}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBox Text="{Binding Copies, UpdateSourceTrigger=PropertyChanged}"
                                         MinHeight="38" Padding="9,7" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding LabelSizeLabel}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ComboBox ItemsSource="{Binding LabelSizes}"
                                          SelectedItem="{Binding SelectedLabelSize}"
                                          DisplayMemberPath="Name"
                                          MinHeight="38" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding PrinterLabel}" FontWeight="SemiBold" Margin="0,14,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Printers}"
                                      SelectedItem="{Binding SelectedPrinter}"
                                      MinHeight="38" />
                            <Button Grid.Column="1"
                                    Content="⟳"
                                    Command="{Binding RefreshPrintersCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0"
                                    Padding="12,6"
                                    ToolTip="Refresh printer list" />
                        </Grid>

                        <Button Content="{Binding PrintLabel}"
                                Command="{Binding PrintCommand}"
                                Style="{StaticResource PrimaryButton}"
                                MinHeight="42"
                                Margin="0,18,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
