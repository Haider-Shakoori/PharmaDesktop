<UserControl x:Class="BusinessOS.Pharmacy.Desktop.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BusinessOS.Pharmacy.Desktop.Dashboard"
             xmlns:controls="clr-namespace:BusinessOS.Pharmacy.Desktop.Controls"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">
    <UserControl.Resources>
        <local:DashboardPresentationConverter x:Key="Presentation" />
        <controls:BindingProxy x:Key="ColumnsProxy" />
        <!-- Dashboard-local typography keeps shared module styles unchanged. -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style x:Key="DashboardCard" TargetType="Border" BasedOn="{StaticResource SurfaceCard}">
            <Setter Property="Padding" Value="14" />
            <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Dashboard-only glass treatment. The KPI row keeps DashboardCard unchanged. -->
        <LinearGradientBrush x:Key="DashboardGlassPanelBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#B8FFFFFF" Offset="0" />
            <GradientStop Color="#8CF0F7FF" Offset="0.52" />
            <GradientStop Color="#A0FFFFFF" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="DashboardGlassPanelBorderBrush" Color="#E8FFFFFF" />
        <SolidColorBrush x:Key="DashboardGlassGridHeaderBrush" Color="#78EAF3FF" />
        <SolidColorBrush x:Key="DashboardGlassRowBrush" Color="#68FFFFFF" />
        <SolidColorBrush x:Key="DashboardGlassAltRowBrush" Color="#4FFFFFFF" />
        <SolidColorBrush x:Key="DashboardGlassHoverRowBrush" Color="#A8FFFFFF" />
        <SolidColorBrush x:Key="DashboardGlassSelectedRowBrush" Color="#B8DCEBFF" />
        <DropShadowEffect x:Key="DashboardGlassShadow"
                          BlurRadius="28"
                          ShadowDepth="5"
                          Direction="270"
                          Opacity="0.22"
                          Color="#315D9B" />

        <Style x:Key="DashboardGlassCard" TargetType="Border" BasedOn="{StaticResource DashboardCard}">
            <Setter Property="Background" Value="{StaticResource DashboardGlassPanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DashboardGlassPanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Effect" Value="{StaticResource DashboardGlassShadow}" />
        </Style>

        <Style x:Key="DashboardGridCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style x:Key="DashboardGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}" FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashboardGlassGridHeader" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource DashboardGridHeader}">
            <Setter Property="Background" Value="{StaticResource DashboardGlassGridHeaderBrush}" />
            <Setter Property="BorderBrush" Value="#72FFFFFF" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="DashboardGlassGridRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="{StaticResource DashboardGlassRowBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="#72FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <DataGridCellsPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="{StaticResource DashboardGlassAltRowBrush}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource DashboardGlassHoverRowBrush}" />
                    <Setter Property="BorderBrush" Value="#B8FFFFFF" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource DashboardGlassSelectedRowBrush}" />
                    <Setter Property="BorderBrush" Value="#C8DCEBFF" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DashboardGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="RowBackground" Value="{StaticResource DashboardGlassRowBrush}" />
            <Setter Property="AlternatingRowBackground" Value="{StaticResource DashboardGlassAltRowBrush}" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="AlternationCount" Value="2147483647" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
            <Setter Property="RowHeight" Value="30" />
            <Setter Property="ColumnHeaderHeight" Value="30" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="CellStyle" Value="{StaticResource DashboardGridCell}" />
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource DashboardGlassGridHeader}" />
            <Setter Property="RowStyle" Value="{StaticResource DashboardGlassGridRow}" />
        </Style>

        <Style x:Key="MiniLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>

        <Style x:Key="OverviewValue" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <Style x:Key="DashboardSectionIcon" TargetType="Path">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>

        <Style x:Key="DashboardMetricIconPath" TargetType="Path">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Stroke" Value="White" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IconKey}" Value="reports"><Setter Property="Data" Value="{StaticResource IconReports}" /></DataTrigger>
                <DataTrigger Binding="{Binding IconKey}" Value="purchases"><Setter Property="Data" Value="{StaticResource IconPos}" /></DataTrigger>
                <DataTrigger Binding="{Binding IconKey}" Value="inventory"><Setter Property="Data" Value="{StaticResource IconInventory}" /></DataTrigger>
                <DataTrigger Binding="{Binding IconKey}" Value="batches"><Setter Property="Data" Value="{StaticResource IconCalendar}" /></DataTrigger>
                <DataTrigger Binding="{Binding IconKey}" Value="expenses"><Setter Property="Data" Value="{StaticResource IconWallet}" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DashboardCellText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>

        <Style x:Key="PremiumProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="8" />
            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4" />
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="4"
                                        HorizontalAlignment="Left" />
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashboardLinkButton" TargetType="Button" BasedOn="{StaticResource ProfessionalButtonBase}">
            <Style.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                </Style>
            </Style.Resources>
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryDarkBrush}" />
            <Setter Property="Background" Value="{DynamicResource BrandPrimarySoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimarySoftBrush}" />
        </Style>

        <Style x:Key="PeriodButton" TargetType="Button" BasedOn="{StaticResource ProfessionalButtonBase}">
            <Setter Property="Background" Value="{DynamicResource SurfaceStrongBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="13,5" />
        </Style>
    </UserControl.Resources>

    <Grid ClipToBounds="True">
        <!-- Dashboard-only backdrop: slightly blurred so glass surfaces remain readable. -->
        <Image Source="pack://application:,,,/Darmaltoon;component/Assets/Glass/background.png"
               Stretch="UniformToFill"
               Opacity="0.94"
               IsHitTestVisible="False">
            <Image.Effect>
                <BlurEffect Radius="7" KernelType="Gaussian" />
            </Image.Effect>
        </Image>
        <Border Background="#20FFFFFF" IsHitTestVisible="False" />

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      Background="Transparent">
        <StackPanel Margin="22,10,22,4" MinWidth="1240">
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="{Binding DashboardTitle}"
                           FontSize="27"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding WelcomeText}"
                           Margin="0,2,0,0"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Stats}" Margin="0,0,0,8">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="5" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource DashboardCard}" Margin="0,0,8,0" MinHeight="104" ClipToBounds="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.ColumnSpan="2"
                                           Fill="{Binding AccentDecorBrush}"
                                           Margin="-14"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding DataContext.IsGlassTheme,
                                                        RelativeSource={RelativeSource AncestorType=UserControl},
                                                        Converter={StaticResource GlobalBoolToVisibility}}" />
                                <Ellipse Grid.Column="0"
                                         Fill="{Binding AccentGlow}"
                                         Width="92" Height="92"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         IsHitTestVisible="False"
                                         Visibility="{Binding DataContext.IsGlassTheme,
                                                      RelativeSource={RelativeSource AncestorType=UserControl},
                                                      Converter={StaticResource GlobalBoolToVisibility}}" />
                                <Border Width="54"
                                        Height="54"
                                        CornerRadius="10">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{Binding IconForeground}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IconKey}" Value="reports"><Setter Property="Background" Value="#3FC365" /></DataTrigger>
                                                <DataTrigger Binding="{Binding IconKey}" Value="purchases"><Setter Property="Background" Value="#159CF4" /></DataTrigger>
                                                <DataTrigger Binding="{Binding IconKey}" Value="inventory"><Setter Property="Background" Value="#FFB51B" /></DataTrigger>
                                                <DataTrigger Binding="{Binding IconKey}" Value="batches"><Setter Property="Background" Value="#FA3D70" /></DataTrigger>
                                                <DataTrigger Binding="{Binding IconKey}" Value="expenses"><Setter Property="Background" Value="#6035EF" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Path Style="{StaticResource DashboardMetricIconPath}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Label}"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                    <Viewbox Margin="0,4,0,0"
                                             Height="32"
                                             MaxWidth="150"
                                             Stretch="Uniform"
                                             StretchDirection="DownOnly"
                                             HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Value}"
                                                   FontSize="24"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextWrapping="NoWrap" />
                                    </Viewbox>
                                    <TextBlock Text="{Binding Note}"
                                               Margin="0,4,0,0"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="0.26*" MinWidth="280" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <Border Style="{StaticResource DashboardGlassCard}" Margin="0,0,0,8">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconReports}"
                                          Style="{StaticResource DashboardSectionIcon}"
                                          Stroke="{DynamicResource BrandPrimaryBrush}" />
                                    <TextBlock Text="{Binding SalesOverviewTitle}"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="{Binding PeriodTodayLabel}"
                                            Command="{Binding SelectPeriodCommand}"
                                            CommandParameter="today"
                                            Margin="0,0,2,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource PeriodButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedPeriod}" Value="today">
                                                        <Setter Property="Background" Value="{DynamicResource BrandPrimaryBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}" />
                                                        <Setter Property="Foreground" Value="White" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="{Binding PeriodWeekLabel}"
                                            Command="{Binding SelectPeriodCommand}"
                                            CommandParameter="week"
                                            Margin="0,0,2,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource PeriodButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedPeriod}" Value="week">
                                                        <Setter Property="Background" Value="{DynamicResource BrandPrimaryBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}" />
                                                        <Setter Property="Foreground" Value="White" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="{Binding PeriodMonthLabel}"
                                            Command="{Binding SelectPeriodCommand}"
                                            CommandParameter="month"
                                            Margin="0,0,2,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource PeriodButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedPeriod}" Value="month">
                                                        <Setter Property="Background" Value="{DynamicResource BrandPrimaryBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}" />
                                                        <Setter Property="Foreground" Value="White" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="{Binding PeriodYearLabel}"
                                            Command="{Binding SelectPeriodCommand}"
                                            CommandParameter="year">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource PeriodButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedPeriod}" Value="year">
                                                        <Setter Property="Background" Value="{DynamicResource BrandPrimaryBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}" />
                                                        <Setter Property="Foreground" Value="White" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="190" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Viewbox Height="118" Stretch="Fill">
                                        <Canvas Width="760" Height="178" Background="#24FFFFFF">
                                            <Line X1="24" Y1="24" X2="696" Y2="24" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" />
                                            <Line X1="24" Y1="54" X2="696" Y2="54" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" />
                                            <Line X1="24" Y1="84" X2="696" Y2="84" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" />
                                            <Line X1="24" Y1="114" X2="696" Y2="114" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" />
                                            <Line X1="24" Y1="148" X2="696" Y2="148" Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="1" />
                                            <Polygon Points="{Binding SalesAreaPoints}" Fill="#24168CF8" />
                                            <ItemsControl ItemsSource="{Binding SalesTimeline, Converter={StaticResource Presentation}, ConverterParameter=Invoices}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas Width="760" Height="178" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate><DataTemplate><Rectangle Width="12" Height="{Binding Height}" Fill="{DynamicResource BrandPrimarySoftBrush}" ToolTip="{Binding Tooltip}" /></DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Polyline Points="{Binding SalesChartPoints}"
                                                      Stroke="{DynamicResource BrandPrimaryBrush}"
                                                      StrokeThickness="1.8"
                                                      StrokeLineJoin="Round" />
                                            <ItemsControl ItemsSource="{Binding SalesChartPoints}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas Width="760" Height="178" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Ellipse Width="7"
                                                                 Height="7"
                                                                 Fill="{DynamicResource BrandPrimaryBrush}"
                                                                 Stroke="White"
                                                                 StrokeThickness="1.5"
                                                                 Margin="-3.5,-3.5,0,0" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Canvas>
                                    </Viewbox>
                                    <Viewbox Height="16" Stretch="Fill">
                                        <ItemsControl Width="760" Height="16" ItemsSource="{Binding SalesTimeline, Converter={StaticResource Presentation}, ConverterParameter=Hours}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas Width="760" Height="16" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding X}" /></Style></ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Width="36" TextAlignment="Center" Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" /></DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Viewbox>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3,0,0">
                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource BrandPrimaryBrush}" Margin="0,0,5,0" />
                                        <TextBlock Text="Sales (AFN)" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <Rectangle Width="9" Height="9" Fill="{DynamicResource BrandPrimarySoftBrush}" Margin="18,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Invoices" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1,0,0,0"
                                        Padding="12,4,0,0"
                                        Margin="10,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SalesTotalText}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding TotalSalesLabel}" Style="{StaticResource MiniLabel}" Margin="0,2,0,10" />
                                        <TextBlock Text="{Binding SalesInvoiceCountText}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding TotalInvoicesLabel}" Style="{StaticResource MiniLabel}" Margin="0,2,0,10" />
                                        <TextBlock Text="{Binding AverageInvoiceText}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding AverageInvoiceLabel}" Style="{StaticResource MiniLabel}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource DashboardGlassCard}" Margin="0,0,6,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconInventory}"
                                              Style="{StaticResource DashboardSectionIcon}"
                                              Stroke="#F97316" />
                                        <TextBlock Text="{Binding LowStockSectionTitle}" FontSize="17" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="{Binding ViewAllLabel}"
                                            Command="{Binding NavigateCommand}"
                                            CommandParameter="inventory"
                                            Style="{StaticResource DashboardLinkButton}" />
                                </Grid>
                                <DataGrid ItemsSource="{Binding LowStockItems}"
                                          Style="{StaticResource DashboardGrid}"
                                          Height="160">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn HeaderStyle="{StaticResource DashboardGlassGridHeader}" Header="#" Width="30" CanUserSort="False">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=DataGridRow}, Converter={StaticResource Presentation}, ConverterParameter=RowNumber}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn HeaderStyle="{StaticResource DashboardGlassGridHeader}" Header="{Binding Data.ColumnMedicine, Source={StaticResource ColumnsProxy}}" Binding="{Binding Medicine}" Width="*" MinWidth="130">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource DashboardCellText}">
                                                    <Setter Property="ToolTip" Value="{Binding Medicine}" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn HeaderStyle="{StaticResource DashboardGlassGridHeader}" Header="{Binding Data.ColumnCurrentStock, Source={StaticResource ColumnsProxy}}" Binding="{Binding CurrentStock, StringFormat={}{0:0.####}}" Width="92">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Setter Property="TextAlignment" Value="Right" />
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn HeaderStyle="{StaticResource DashboardGlassGridHeader}" Header="{Binding Data.ColumnMinimumStock, Source={StaticResource ColumnsProxy}}" Binding="{Binding MinimumStock, StringFormat={}{0:0.####}}" Width="78">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextAlignment" Value="Right" />
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn HeaderStyle="{StaticResource DashboardGlassGridHeader}" Header="{Binding Data.ColumnStatus, Source={StaticResource ColumnsProxy}}" Width="72">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource DangerSoftBrush}" CornerRadius="7" Padding="6,1"
                                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Status}" FontSize="10.5" Foreground="#E11D48" FontWeight="SemiBold" />
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource DashboardGlassCard}" Margin="6,0,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconCalendar}"
                                              Style="{StaticResource DashboardSectionIcon}"
                                              Stroke="#F43F5E" />
                                        <TextBlock Text="{Binding ExpiringSoonSectionTitle}" FontSize="17" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="{Binding ViewAllLabel}"
                                            Command="{Binding NavigateCommand}"
                                            CommandParameter="inventory"
                                            Style="{StaticResource DashboardLinkButton}" />
                                </Grid>
                                <DataGrid ItemsSource="{Binding ExpiryItems}"
                                          Style="{StaticResource DashboardGrid}"
                                          Height="160">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn HeaderStyle="{StaticResource DashboardGlassGridHeader}" Header="#" Width="30" CanUserSort="False">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=DataGridRow}, Converter={StaticResource Presentation}, ConverterParameter=RowNumber}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn HeaderStyle="{StaticResource DashboardGlassGridHeader}" Header="{Binding Data.ColumnMedicine, Source={StaticResource ColumnsProxy}}" Binding="{Binding Medicine}" Width="*" MinWidth="130">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource DashboardCellText}">
                                                    <Setter Property="ToolTip" Value="{Binding Medicine}" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn HeaderStyle="{StaticResource DashboardGlassGridHeader}" Header="{Binding Data.ColumnBatchNumber, Source={StaticResource ColumnsProxy}}" Binding="{Binding BatchNumber}" Width="85" />
                                        <DataGridTextColumn HeaderStyle="{StaticResource DashboardGlassGridHeader}" Header="{Binding Data.ColumnExpiryDate, Source={StaticResource ColumnsProxy}}" Binding="{Binding ExpiryDate, StringFormat={}{0:dd MMM yyyy}}" Width="108" />
                                        <DataGridTemplateColumn HeaderStyle="{StaticResource DashboardGlassGridHeader}" Header="{Binding Data.ColumnDaysLeft, Source={StaticResource ColumnsProxy}}" Width="78">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding DaysLeft, Converter={StaticResource Presentation}, ConverterParameter=ExpiryBackground}" CornerRadius="7" Padding="6,1"
                                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DaysLeft, StringFormat={}{0} days}" FontSize="10.5"
                                                                   Foreground="{Binding DaysLeft, Converter={StaticResource Presentation}, ConverterParameter=ExpiryForeground}" FontWeight="SemiBold" />
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource DashboardGlassCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconExpenses}"
                                          Style="{StaticResource DashboardSectionIcon}"
                                          Stroke="{DynamicResource BrandPrimaryBrush}" />
                                    <TextBlock Text="{Binding RecentTransactionsSectionTitle}" FontSize="17" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="{Binding ViewAllLabel}"
                                        Command="{Binding NavigateCommand}"
                                        CommandParameter="reports"
                                        Style="{StaticResource DashboardLinkButton}" />
                            </Grid>
                            <DataGrid ItemsSource="{Binding RecentTransactions}"
                                      Style="{StaticResource DashboardGrid}"
                                      Height="156">
                                <DataGrid.Columns>
                                        <DataGridTemplateColumn HeaderStyle="{StaticResource DashboardGlassGridHeader}" Header="#" Width="34" CanUserSort="False">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=DataGridRow}, Converter={StaticResource Presentation}, ConverterParameter=RowNumber}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    <DataGridTextColumn HeaderStyle="{StaticResource DashboardGlassGridHeader}" Header="{Binding Data.ColumnDateTime, Source={StaticResource ColumnsProxy}}" Binding="{Binding OccurredAt, StringFormat={}{0:dd MMM yyyy HH:mm}}" Width="150" />
                                    <DataGridTemplateColumn HeaderStyle="{StaticResource DashboardGlassGridHeader}" Header="{Binding Data.ColumnType, Source={StaticResource ColumnsProxy}}" Width="68">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource InfoSoftBrush}" CornerRadius="7" Padding="6,1"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Type}" FontSize="10.5" Foreground="{DynamicResource BrandPrimaryDarkBrush}" FontWeight="SemiBold" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn HeaderStyle="{StaticResource DashboardGlassGridHeader}" Header="{Binding Data.ColumnDocumentNumber, Source={StaticResource ColumnsProxy}}" Binding="{Binding DocumentNumber}" Width="150" />
                                    <DataGridTextColumn HeaderStyle="{StaticResource DashboardGlassGridHeader}" Header="{Binding Data.ColumnParty, Source={StaticResource ColumnsProxy}}" Binding="{Binding Party}" Width="*" MinWidth="130" />
                                    <DataGridTextColumn HeaderStyle="{StaticResource DashboardGlassGridHeader}" Header="{Binding Data.ColumnItems, Source={StaticResource ColumnsProxy}}" Binding="{Binding Items}" Width="60">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Right" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn HeaderStyle="{StaticResource DashboardGlassGridHeader}" Header="{Binding Data.ColumnTotal, Source={StaticResource ColumnsProxy}}" Binding="{Binding Total, StringFormat={}{0:N2}}" Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Right" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn HeaderStyle="{StaticResource DashboardGlassGridHeader}" Header="{Binding Data.ColumnPaymentMethod, Source={StaticResource ColumnsProxy}}" Binding="{Binding PaymentMethod}" Width="120" />
                                    <DataGridTemplateColumn HeaderStyle="{StaticResource DashboardGlassGridHeader}" Header="{Binding Data.ColumnStatus, Source={StaticResource ColumnsProxy}}" Width="76">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="7" Padding="6,1"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="open">
                                                                    <Setter Property="Background" Value="#DBEAFE" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="completed">
                                                                    <Setter Property="Background" Value="#DBEAFE" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Status}" FontSize="10.5" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="open">
                                                                        <Setter Property="Foreground" Value="#2563EB" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="completed">
                                                                        <Setter Property="Foreground" Value="#2563EB" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource DashboardCard}" MinHeight="150" Margin="0,0,0,8">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconRoles}"
                                          Style="{StaticResource DashboardSectionIcon}"
                                          Stroke="#16A34A" />
                                    <TextBlock Text="{Binding LicenseSubscriptionTitle}" FontSize="15" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource SuccessSoftBrush}" CornerRadius="8" Padding="7,3">
                                    <TextBlock Text="{Binding PlanLabel}" Foreground="{DynamicResource SuccessBrush}" FontSize="10.5" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding LicenseValidityText}" Margin="0,5,0,4"
                                       FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ProgressBar Value="{Binding LicenseProgressValue}" Maximum="100"
                                         Style="{StaticResource PremiumProgressBar}" />
                            <Grid Margin="0,4,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding LicenseDaysRemainingText}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding LicenseProgressValue, StringFormat={}{0:0}%}"
                                           FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding LicenseFeatures}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,4,2">
                                            <Border Width="15" Height="15" CornerRadius="8" Background="{DynamicResource SuccessSoftBrush}"
                                                    VerticalAlignment="Center" Margin="0,0,6,0">
                                                <Path Data="{StaticResource IconRoles}" Width="9" Height="9"
                                                      Stroke="#16A34A" StrokeThickness="2" Fill="Transparent"
                                                      Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{Binding}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource DashboardCard}" Margin="0,0,0,8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Path Data="{StaticResource IconLightning}"
                                      Style="{StaticResource DashboardSectionIcon}"
                                      Stroke="#F59E0B" />
                                <TextBlock Text="{Binding QuickActionsTitle}" FontSize="15" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding QuickActions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Key}"
                                                IsEnabled="{Binding IsAvailable}"
                                                Foreground="White"
                                                MinHeight="30"
                                                Padding="8,2"
                                                Margin="0,0,0,5"
                                                HorizontalContentAlignment="Stretch">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ProfessionalButtonBase}">
                                                    <Setter Property="Background" Value="{Binding Accent}" />
                                                    <Setter Property="BorderBrush" Value="{Binding Accent}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Key}" Value="sync">
                                                            <Setter Property="Background" Value="{DynamicResource BrandPrimarySoftBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimarySoftBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Grid>
                                                <Grid.Resources>
                                                    <Style x:Key="ActionText" TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="White" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Key}" Value="sync"><Setter Property="Foreground" Value="#1559C6" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Resources>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="22" Height="22" CornerRadius="7"
                                                        Background="Transparent"
                                                        HorizontalAlignment="Left">
                                                    <Path Width="18" Height="18"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center">
                                                        <Path.Style>
                                                            <Style TargetType="Path" BasedOn="{StaticResource NavigationIconPath}">
                                                                <Setter Property="Stroke" Value="White" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Key}" Value="pos"><Setter Property="Data" Value="{StaticResource IconAdd}" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Key}" Value="purchases"><Setter Property="Data" Value="{StaticResource IconPos}" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Key}" Value="backup"><Setter Property="Data" Value="{StaticResource IconCloudBackup}" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Key}" Value="sync">
                                                                        <Setter Property="Stroke" Value="#1559C6" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Label}"
                                                           Style="{StaticResource ActionText}" FontWeight="SemiBold"
                                                           FontSize="13" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding Shortcut}"
                                                           Style="{StaticResource ActionText}" FontSize="11"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource DashboardCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconDashboard}"
                                          Style="{StaticResource DashboardSectionIcon}"
                                          Stroke="{DynamicResource BrandPrimaryBrush}" />
                                    <TextBlock Text="{Binding PharmacyOverviewTitle}" FontSize="15" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="{Binding ViewReportsLabel}"
                                        Command="{Binding NavigateCommand}"
                                        CommandParameter="reports"
                                        Style="{StaticResource DashboardLinkButton}" />
                            </Grid>

                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconMedicines}" Width="13" Height="13" Stretch="Uniform" Stroke="#52759D" StrokeThickness="1.8" Margin="0,0,10,0" VerticalAlignment="Center" /><TextBlock Text="{Binding TotalMedicinesLabel}" Style="{StaticResource MiniLabel}" /></StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding OverviewMedicinesText}" Style="{StaticResource OverviewValue}" />
                            </Grid>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconInventory}" Width="13" Height="13" Stretch="Uniform" Stroke="#52759D" StrokeThickness="1.8" Margin="0,0,10,0" VerticalAlignment="Center" /><TextBlock Text="{Binding TotalBatchesLabel}" Style="{StaticResource MiniLabel}" /></StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding OverviewBatchesText}" Style="{StaticResource OverviewValue}" />
                            </Grid>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconSuppliers}" Width="13" Height="13" Stretch="Uniform" Stroke="#52759D" StrokeThickness="1.8" Margin="0,0,10,0" VerticalAlignment="Center" /><TextBlock Text="{Binding TotalSuppliersLabel}" Style="{StaticResource MiniLabel}" /></StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding OverviewSuppliersText}" Style="{StaticResource OverviewValue}" />
                            </Grid>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconCustomers}" Width="13" Height="13" Stretch="Uniform" Stroke="#52759D" StrokeThickness="1.8" Margin="0,0,10,0" VerticalAlignment="Center" /><TextBlock Text="{Binding TotalCustomersLabel}" Style="{StaticResource MiniLabel}" /></StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding OverviewCustomersText}" Style="{StaticResource OverviewValue}" />
                            </Grid>
                            <Separator Margin="0,4" Background="{DynamicResource BorderBrush}" />
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconReports}" Width="13" Height="13" Stretch="Uniform" Stroke="#52759D" StrokeThickness="1.8" Margin="0,0,10,0" VerticalAlignment="Center" /><TextBlock Text="{Binding MonthSalesLabel}" Style="{StaticResource MiniLabel}" /></StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding OverviewMonthSalesText}" Style="{StaticResource OverviewValue}" />
                            </Grid>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconPos}" Width="13" Height="13" Stretch="Uniform" Stroke="#52759D" StrokeThickness="1.8" Margin="0,0,10,0" VerticalAlignment="Center" /><TextBlock Text="{Binding MonthPurchasesLabel}" Style="{StaticResource MiniLabel}" /></StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding OverviewMonthPurchasesText}" Style="{StaticResource OverviewValue}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
