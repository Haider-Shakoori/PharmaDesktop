<UserControl x:Class="BusinessOS.Pharmacy.Desktop.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BusinessOS.Pharmacy.Desktop.Dashboard"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">
    <UserControl.Resources>
        <local:DashboardPresentationConverter x:Key="Presentation" />
        <!-- Dashboard-local typography keeps shared module styles unchanged. -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#24334F" />
        </Style>
        <Style x:Key="DashboardCard" TargetType="Border" BasedOn="{StaticResource SurfaceCard}">
            <Setter Property="Padding" Value="18" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderBrush" Value="#E7EDF4" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#C9D9EA" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DashboardGridCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style x:Key="DashboardGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F4F7FB" />
            <Setter Property="Foreground" Value="#314763" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="BorderBrush" Value="#E5ECF4" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}" FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashboardGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="RowBackground" Value="White" />
            <Setter Property="AlternatingRowBackground" Value="#FBFDFF" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E8EEF5" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="AlternationCount" Value="2147483647" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="RowHeight" Value="33" />
            <Setter Property="ColumnHeaderHeight" Value="31" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="CellStyle" Value="{StaticResource DashboardGridCell}" />
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource DashboardGridHeader}" />
        </Style>

        <Style x:Key="MiniLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#64748B" />
        </Style>

        <Style x:Key="OverviewValue" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="#102A56" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <Style x:Key="DashboardSectionIcon" TargetType="Path">
            <Setter Property="Width" Value="27" />
            <Setter Property="Height" Value="27" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>

        <Style x:Key="DashboardMetricIconPath" TargetType="Path">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Stroke" Value="White" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IconKey}" Value="reports"><Setter Property="Data" Value="{StaticResource IconReports}" /></DataTrigger>
                <DataTrigger Binding="{Binding IconKey}" Value="purchases"><Setter Property="Data" Value="{StaticResource IconPos}" /></DataTrigger>
                <DataTrigger Binding="{Binding IconKey}" Value="inventory"><Setter Property="Data" Value="{StaticResource IconInventory}" /></DataTrigger>
                <DataTrigger Binding="{Binding IconKey}" Value="batches"><Setter Property="Data" Value="{StaticResource IconCalendar}" /></DataTrigger>
                <DataTrigger Binding="{Binding IconKey}" Value="expenses"><Setter Property="Data" Value="{StaticResource IconWallet}" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DashboardCellText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="#314763" />
        </Style>

        <Style x:Key="PremiumProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="9" />
            <Setter Property="Background" Value="#E7EDF5" />
            <Setter Property="Foreground" Value="#22C55E" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4" />
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="4"
                                        HorizontalAlignment="Left" />
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashboardLinkButton" TargetType="Button" BasedOn="{StaticResource ProfessionalButtonBase}">
            <Style.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Foreground" Value="#31547C" />
                </Style>
            </Style.Resources>
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="11,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#0B6FD3" />
            <Setter Property="Background" Value="#EAF4FF" />
            <Setter Property="BorderBrush" Value="#D6E9FB" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto"
                  Background="{DynamicResource AppBackgroundBrush}">
        <StackPanel Margin="26,24,26,18" MinWidth="1240">
            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="Dashboard"
                           FontSize="33"
                           FontWeight="Bold"
                           Foreground="#0B1F44" />
                <TextBlock Text="{Binding WelcomeText}"
                           Margin="0,3,0,0"
                           FontSize="15"
                           Foreground="#52677F" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Stats}" Margin="0,0,0,10">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="5" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource DashboardCard}" Margin="0,0,10,0" MinHeight="134">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="70"
                                        Height="70"
                                        CornerRadius="12">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{Binding IconForeground}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IconKey}" Value="reports"><Setter Property="Background" Value="#3FC365" /></DataTrigger>
                                                <DataTrigger Binding="{Binding IconKey}" Value="purchases"><Setter Property="Background" Value="#159CF4" /></DataTrigger>
                                                <DataTrigger Binding="{Binding IconKey}" Value="inventory"><Setter Property="Background" Value="#FFB51B" /></DataTrigger>
                                                <DataTrigger Binding="{Binding IconKey}" Value="batches"><Setter Property="Background" Value="#FA3D70" /></DataTrigger>
                                                <DataTrigger Binding="{Binding IconKey}" Value="expenses"><Setter Property="Background" Value="#6035EF" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Path Style="{StaticResource DashboardMetricIconPath}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Label}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="#2E4667"
                                               TextWrapping="Wrap" />
                                    <Viewbox Margin="0,5,0,0"
                                             Height="38"
                                             MaxWidth="168"
                                             Stretch="Uniform"
                                             StretchDirection="DownOnly"
                                             HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Value}"
                                                   FontSize="30"
                                                   FontWeight="Bold"
                                                   Foreground="#0B1F44"
                                                   TextWrapping="NoWrap" />
                                    </Viewbox>
                                    <TextBlock Text="{Binding Note}"
                                               Margin="0,5,0,0"
                                               FontSize="13"
                                               Foreground="#64748B"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="0.265*" MinWidth="300" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <Border Style="{StaticResource DashboardCard}" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconReports}"
                                          Style="{StaticResource DashboardSectionIcon}"
                                          Stroke="#0B82F6" />
                                    <TextBlock Text="Sales Overview"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Foreground="#15284B"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Border Background="#0B82F6" CornerRadius="7,0,0,7" Padding="20,8">
                                        <TextBlock Text="Today" Foreground="White" FontSize="13" FontWeight="SemiBold" />
                                    </Border>
                                    <Border Background="White" BorderBrush="#DDE6F0" BorderThickness="1" Padding="19,8">
                                        <TextBlock Text="This Week" Foreground="#52677F" FontSize="13" />
                                    </Border>
                                    <Border Background="White" BorderBrush="#DDE6F0" BorderThickness="1,1,0,1" Padding="19,8">
                                        <TextBlock Text="This Month" Foreground="#52677F" FontSize="13" />
                                    </Border>
                                    <Border Background="White" BorderBrush="#DDE6F0" BorderThickness="1" CornerRadius="0,7,7,0" Padding="19,8">
                                        <TextBlock Text="This Year" Foreground="#52677F" FontSize="13" />
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="225" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Viewbox Height="150" Stretch="Fill">
                                        <Canvas Width="760" Height="178" Background="White">
                                            <Line X1="24" Y1="24" X2="696" Y2="24" Stroke="#E8EEF5" StrokeThickness="1" />
                                            <Line X1="24" Y1="54" X2="696" Y2="54" Stroke="#E8EEF5" StrokeThickness="1" />
                                            <Line X1="24" Y1="84" X2="696" Y2="84" Stroke="#E8EEF5" StrokeThickness="1" />
                                            <Line X1="24" Y1="114" X2="696" Y2="114" Stroke="#E8EEF5" StrokeThickness="1" />
                                            <Line X1="24" Y1="148" X2="696" Y2="148" Stroke="#CAD8E7" StrokeThickness="1" />
                                            <Polygon Points="{Binding SalesAreaPoints}" Fill="#24168CF8" />
                                            <ItemsControl ItemsSource="{Binding SalesTimeline, Converter={StaticResource Presentation}, ConverterParameter=Invoices}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas Width="760" Height="178" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate><DataTemplate><Rectangle Width="12" Height="{Binding Height}" Fill="#A9D9FC" ToolTip="{Binding Tooltip}" /></DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Polyline Points="{Binding SalesChartPoints}"
                                                      Stroke="#0B82F6"
                                                      StrokeThickness="1.8"
                                                      StrokeLineJoin="Round" />
                                            <ItemsControl ItemsSource="{Binding SalesChartPoints}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas Width="760" Height="178" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Ellipse Width="7"
                                                                 Height="7"
                                                                 Fill="#0B82F6"
                                                                 Stroke="White"
                                                                 StrokeThickness="1.5"
                                                                 Margin="-3.5,-3.5,0,0" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Canvas>
                                    </Viewbox>
                                    <Viewbox Height="20" Stretch="Fill">
                                        <ItemsControl Width="760" Height="20" ItemsSource="{Binding SalesTimeline, Converter={StaticResource Presentation}, ConverterParameter=Hours}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas Width="760" Height="20" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding X}" /></Style></ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Width="36" TextAlignment="Center" Text="{Binding Label}" FontSize="12" Foreground="#64748B" /></DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Viewbox>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                        <Ellipse Width="10" Height="10" Fill="#0B82F6" Margin="0,0,6,0" />
                                        <TextBlock Text="Sales (AFN)" FontSize="13" Foreground="#52677F" />
                                        <Rectangle Width="11" Height="11" Fill="#A9D9FC" Margin="22,0,7,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Invoices" FontSize="13" Foreground="#52677F" />
                                    </StackPanel>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        BorderBrush="#DFE8F2"
                                        BorderThickness="1,0,0,0"
                                        Padding="14,6,0,0"
                                        Margin="12,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SalesTotalText}" FontSize="22" FontWeight="Bold" Foreground="#0B1F44" />
                                        <TextBlock Text="Total Sales" Style="{StaticResource MiniLabel}" Margin="0,3,0,14" />
                                        <TextBlock Text="{Binding SalesInvoiceCountText}" FontSize="22" FontWeight="Bold" Foreground="#0B1F44" />
                                        <TextBlock Text="Total Invoices" Style="{StaticResource MiniLabel}" Margin="0,3,0,14" />
                                        <TextBlock Text="{Binding AverageInvoiceText}" FontSize="22" FontWeight="Bold" Foreground="#0B1F44" />
                                        <TextBlock Text="Average Invoice" Style="{StaticResource MiniLabel}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource DashboardCard}" Margin="0,0,7,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconInventory}"
                                              Style="{StaticResource DashboardSectionIcon}"
                                              Stroke="#F97316" />
                                        <TextBlock Text="Low Stock Items" FontSize="20" FontWeight="Bold"
                                                   Foreground="#15284B" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="View All"
                                            Command="{Binding NavigateCommand}"
                                            CommandParameter="inventory"
                                            Style="{StaticResource DashboardLinkButton}" />
                                </Grid>
                                <DataGrid ItemsSource="{Binding LowStockItems}"
                                          Style="{StaticResource DashboardGrid}"
                                          Height="204">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn HeaderStyle="{StaticResource DashboardGridHeader}" Header="#" Width="36" CanUserSort="False">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=DataGridRow}, Converter={StaticResource Presentation}, ConverterParameter=RowNumber}" FontSize="12.5" Foreground="#64748B" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn HeaderStyle="{StaticResource DashboardGridHeader}" Header="Medicine" Binding="{Binding Medicine}" Width="*" MinWidth="145">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource DashboardCellText}">
                                                    <Setter Property="ToolTip" Value="{Binding Medicine}" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn HeaderStyle="{StaticResource DashboardGridHeader}" Header="Current Stock" Binding="{Binding CurrentStock, StringFormat={}{0:0.####}}" Width="112">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#EF4444" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Setter Property="TextAlignment" Value="Right" />
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn HeaderStyle="{StaticResource DashboardGridHeader}" Header="Min. Stock" Binding="{Binding MinimumStock, StringFormat={}{0:0.####}}" Width="90">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextAlignment" Value="Right" />
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Setter Property="Foreground" Value="#314763" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn HeaderStyle="{StaticResource DashboardGridHeader}" Header="Status" Width="88">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="#FFE7EA" CornerRadius="8" Padding="7,2"
                                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Status}" FontSize="11.5" Foreground="#E11D48" FontWeight="SemiBold" />
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource DashboardCard}" Margin="7,0,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconCalendar}"
                                              Style="{StaticResource DashboardSectionIcon}"
                                              Stroke="#F43F5E" />
                                        <TextBlock Text="Expiring Soon" FontSize="20" FontWeight="Bold"
                                                   Foreground="#15284B" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="View All"
                                            Command="{Binding NavigateCommand}"
                                            CommandParameter="inventory"
                                            Style="{StaticResource DashboardLinkButton}" />
                                </Grid>
                                <DataGrid ItemsSource="{Binding ExpiryItems}"
                                          Style="{StaticResource DashboardGrid}"
                                          Height="204">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn HeaderStyle="{StaticResource DashboardGridHeader}" Header="#" Width="36" CanUserSort="False">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=DataGridRow}, Converter={StaticResource Presentation}, ConverterParameter=RowNumber}" FontSize="12.5" Foreground="#64748B" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn HeaderStyle="{StaticResource DashboardGridHeader}" Header="Medicine" Binding="{Binding Medicine}" Width="*" MinWidth="145">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource DashboardCellText}">
                                                    <Setter Property="ToolTip" Value="{Binding Medicine}" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn HeaderStyle="{StaticResource DashboardGridHeader}" Header="Batch No." Binding="{Binding BatchNumber}" Width="95" />
                                        <DataGridTextColumn HeaderStyle="{StaticResource DashboardGridHeader}" Header="Expiry Date" Binding="{Binding ExpiryDate, StringFormat={}{0:dd MMM yyyy}}" Width="120" />
                                        <DataGridTemplateColumn HeaderStyle="{StaticResource DashboardGridHeader}" Header="Days Left" Width="95">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding DaysLeft, Converter={StaticResource Presentation}, ConverterParameter=ExpiryBackground}" CornerRadius="8" Padding="7,2"
                                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DaysLeft, StringFormat={}{0} days}" FontSize="11.5"
                                                                   Foreground="{Binding DaysLeft, Converter={StaticResource Presentation}, ConverterParameter=ExpiryForeground}" FontWeight="SemiBold" />
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource DashboardCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconExpenses}"
                                          Style="{StaticResource DashboardSectionIcon}"
                                          Stroke="#0B82F6" />
                                    <TextBlock Text="Recent Transactions" FontSize="20" FontWeight="Bold"
                                               Foreground="#15284B" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="View All"
                                        Command="{Binding NavigateCommand}"
                                        CommandParameter="reports"
                                        Style="{StaticResource DashboardLinkButton}" />
                            </Grid>
                            <DataGrid ItemsSource="{Binding RecentTransactions}"
                                      Style="{StaticResource DashboardGrid}"
                                      Height="200">
                                <DataGrid.Columns>
                                        <DataGridTemplateColumn HeaderStyle="{StaticResource DashboardGridHeader}" Header="#" Width="40" CanUserSort="False">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=DataGridRow}, Converter={StaticResource Presentation}, ConverterParameter=RowNumber}" FontSize="12.5" Foreground="#64748B" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    <DataGridTextColumn HeaderStyle="{StaticResource DashboardGridHeader}" Header="Date &amp; Time" Binding="{Binding OccurredAt, StringFormat={}{0:dd MMM yyyy HH:mm}}" Width="170" />
                                    <DataGridTemplateColumn HeaderStyle="{StaticResource DashboardGridHeader}" Header="Type" Width="76">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="#E7F2FF" CornerRadius="8" Padding="7,2"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Type}" FontSize="11.5" Foreground="#0B6FD3" FontWeight="SemiBold" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn HeaderStyle="{StaticResource DashboardGridHeader}" Header="Invoice/Purchase #" Binding="{Binding DocumentNumber}" Width="172" />
                                    <DataGridTextColumn HeaderStyle="{StaticResource DashboardGridHeader}" Header="Customer / Supplier" Binding="{Binding Party}" Width="*" MinWidth="150" />
                                    <DataGridTextColumn HeaderStyle="{StaticResource DashboardGridHeader}" Header="Items" Binding="{Binding Items}" Width="68">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Right" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="Foreground" Value="#314763" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn HeaderStyle="{StaticResource DashboardGridHeader}" Header="Total (AFN)" Binding="{Binding Total, StringFormat={}{0:N2}}" Width="112">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Right" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="Foreground" Value="#314763" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn HeaderStyle="{StaticResource DashboardGridHeader}" Header="Payment Method" Binding="{Binding PaymentMethod}" Width="138" />
                                    <DataGridTemplateColumn HeaderStyle="{StaticResource DashboardGridHeader}" Header="Status" Width="84">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="8" Padding="7,2"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#DCFCE7" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="open">
                                                                    <Setter Property="Background" Value="#DBEAFE" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="completed">
                                                                    <Setter Property="Background" Value="#DBEAFE" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Status}" FontSize="11.5" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#15803D" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="open">
                                                                        <Setter Property="Foreground" Value="#2563EB" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="completed">
                                                                        <Setter Property="Foreground" Value="#2563EB" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource DashboardCard}" MinHeight="170" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconRoles}"
                                          Style="{StaticResource DashboardSectionIcon}"
                                          Stroke="#16A34A" />
                                    <TextBlock Text="License &amp; Subscription" FontSize="17" FontWeight="Bold"
                                               Foreground="#15284B" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="#DCFCE7" CornerRadius="9" Padding="9,4">
                                    <TextBlock Text="{Binding PlanLabel}" Foreground="#15803D" FontSize="11.5" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding LicenseValidityText}" Margin="0,6,0,5"
                                       FontSize="14" Foreground="#52677F" />
                            <ProgressBar Value="{Binding LicenseProgressValue}" Maximum="100"
                                         Style="{StaticResource PremiumProgressBar}" />
                            <Grid Margin="0,5,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding LicenseDaysRemainingText}" FontSize="12.5" Foreground="#64748B" />
                                <TextBlock Grid.Column="1" Text="{Binding LicenseProgressValue, StringFormat={}{0:0}%}"
                                           FontSize="12.5" Foreground="#52677F" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding LicenseFeatures}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,4,3">
                                            <Border Width="18" Height="18" CornerRadius="9" Background="#DCFCE7"
                                                    VerticalAlignment="Center" Margin="0,0,7,0">
                                                <Path Data="{StaticResource IconRoles}" Width="11" Height="11"
                                                      Stroke="#16A34A" StrokeThickness="2" Fill="Transparent"
                                                      Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{Binding}" FontSize="12.5" Foreground="#405875"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource DashboardCard}" Margin="0,0,0,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Path Data="{StaticResource IconLightning}"
                                      Style="{StaticResource DashboardSectionIcon}"
                                      Stroke="#F59E0B" />
                                <TextBlock Text="{Binding QuickActionsTitle}" FontSize="17" FontWeight="Bold"
                                           Foreground="#15284B" VerticalAlignment="Center" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding QuickActions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Key}"
                                                IsEnabled="{Binding IsAvailable}"
                                                Foreground="White"
                                                MinHeight="36"
                                                Padding="9,3"
                                                Margin="0,0,0,6"
                                                HorizontalContentAlignment="Stretch">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ProfessionalButtonBase}">
                                                    <Setter Property="Background" Value="{Binding Accent}" />
                                                    <Setter Property="BorderBrush" Value="{Binding Accent}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Key}" Value="sync">
                                                            <Setter Property="Background" Value="#DCEBFF" />
                                                            <Setter Property="BorderBrush" Value="#DCEBFF" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Grid>
                                                <Grid.Resources>
                                                    <Style x:Key="ActionText" TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="White" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Key}" Value="sync"><Setter Property="Foreground" Value="#1559C6" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Resources>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="38" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="26" Height="26" CornerRadius="8"
                                                        Background="Transparent"
                                                        HorizontalAlignment="Left">
                                                    <Path Width="22" Height="22"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center">
                                                        <Path.Style>
                                                            <Style TargetType="Path" BasedOn="{StaticResource NavigationIconPath}">
                                                                <Setter Property="Stroke" Value="White" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Key}" Value="pos"><Setter Property="Data" Value="{StaticResource IconAdd}" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Key}" Value="purchases"><Setter Property="Data" Value="{StaticResource IconPos}" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Key}" Value="backup"><Setter Property="Data" Value="{StaticResource IconCloudBackup}" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Key}" Value="sync">
                                                                        <Setter Property="Stroke" Value="#1559C6" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Label}"
                                                           Style="{StaticResource ActionText}" FontWeight="SemiBold"
                                                           FontSize="15" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding Shortcut}"
                                                           Style="{StaticResource ActionText}" FontSize="12"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource DashboardCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconDashboard}"
                                          Style="{StaticResource DashboardSectionIcon}"
                                          Stroke="#0B82F6" />
                                    <TextBlock Text="Pharmacy Overview" FontSize="17" FontWeight="Bold"
                                               Foreground="#15284B" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="View Reports"
                                        Command="{Binding NavigateCommand}"
                                        CommandParameter="reports"
                                        Style="{StaticResource DashboardLinkButton}" />
                            </Grid>

                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconMedicines}" Width="16" Height="16" Stretch="Uniform" Stroke="#52759D" StrokeThickness="1.8" Margin="0,0,14,0" VerticalAlignment="Center" /><TextBlock Text="Total Medicines" Style="{StaticResource MiniLabel}" /></StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding OverviewMedicinesText}" Style="{StaticResource OverviewValue}" />
                            </Grid>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconInventory}" Width="16" Height="16" Stretch="Uniform" Stroke="#52759D" StrokeThickness="1.8" Margin="0,0,14,0" VerticalAlignment="Center" /><TextBlock Text="Total Batches" Style="{StaticResource MiniLabel}" /></StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding OverviewBatchesText}" Style="{StaticResource OverviewValue}" />
                            </Grid>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconSuppliers}" Width="16" Height="16" Stretch="Uniform" Stroke="#52759D" StrokeThickness="1.8" Margin="0,0,14,0" VerticalAlignment="Center" /><TextBlock Text="Total Suppliers" Style="{StaticResource MiniLabel}" /></StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding OverviewSuppliersText}" Style="{StaticResource OverviewValue}" />
                            </Grid>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconCustomers}" Width="16" Height="16" Stretch="Uniform" Stroke="#52759D" StrokeThickness="1.8" Margin="0,0,14,0" VerticalAlignment="Center" /><TextBlock Text="Total Customers" Style="{StaticResource MiniLabel}" /></StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding OverviewCustomersText}" Style="{StaticResource OverviewValue}" />
                            </Grid>
                            <Separator Margin="0,6" Background="#E8EEF5" />
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconReports}" Width="16" Height="16" Stretch="Uniform" Stroke="#52759D" StrokeThickness="1.8" Margin="0,0,14,0" VerticalAlignment="Center" /><TextBlock Text="Total Sales (This Month)" Style="{StaticResource MiniLabel}" /></StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding OverviewMonthSalesText}" Style="{StaticResource OverviewValue}" />
                            </Grid>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconPos}" Width="16" Height="16" Stretch="Uniform" Stroke="#52759D" StrokeThickness="1.8" Margin="0,0,14,0" VerticalAlignment="Center" /><TextBlock Text="Total Purchases (This Month)" Style="{StaticResource MiniLabel}" /></StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding OverviewMonthPurchasesText}" Style="{StaticResource OverviewValue}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
