<UserControl x:Class="BusinessOS.Pharmacy.Desktop.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="DashboardCard" TargetType="Border" BasedOn="{StaticResource SurfaceCard}">
            <Setter Property="Padding" Value="12" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderBrush" Value="#DDE6F0" />
        </Style>

        <Style x:Key="DashboardGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="RowBackground" Value="White" />
            <Setter Property="AlternatingRowBackground" Value="#FBFDFF" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E8EEF5" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="RowHeight" Value="27" />
            <Setter Property="ColumnHeaderHeight" Value="27" />
            <Setter Property="FontSize" Value="10.5" />
        </Style>

        <Style x:Key="MiniLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="#64748B" />
        </Style>

        <Style x:Key="OverviewValue" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#102A56" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <Style x:Key="DashboardSectionIcon" TargetType="Path">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="StrokeThickness" Value="1.9" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>

        <Style x:Key="DashboardMetricIconPath" TargetType="Path">
            <Setter Property="Width" Value="23" />
            <Setter Property="Height" Value="23" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Stroke" Value="White" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IconKey}" Value="reports"><Setter Property="Data" Value="{StaticResource IconReports}" /></DataTrigger>
                <DataTrigger Binding="{Binding IconKey}" Value="purchases"><Setter Property="Data" Value="{StaticResource IconPurchases}" /></DataTrigger>
                <DataTrigger Binding="{Binding IconKey}" Value="inventory"><Setter Property="Data" Value="{StaticResource IconInventory}" /></DataTrigger>
                <DataTrigger Binding="{Binding IconKey}" Value="batches"><Setter Property="Data" Value="{StaticResource IconBatches}" /></DataTrigger>
                <DataTrigger Binding="{Binding IconKey}" Value="expenses"><Setter Property="Data" Value="{StaticResource IconExpenses}" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DashboardLinkButton" TargetType="Button" BasedOn="{StaticResource ProfessionalButtonBase}">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Foreground" Value="#0B6FD3" />
            <Setter Property="Background" Value="#EAF4FF" />
            <Setter Property="BorderBrush" Value="#D6E9FB" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16,12,16,16">
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="Dashboard"
                           FontSize="27"
                           FontWeight="Bold"
                           Foreground="#0B1F44" />
                <TextBlock Text="{Binding WelcomeText}"
                           Margin="0,2,0,0"
                           FontSize="11.5"
                           Foreground="#52677F" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Stats}" Margin="0,0,0,10">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="5" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource DashboardCard}" Margin="0,0,10,0" MinHeight="98">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="48"
                                        Height="48"
                                        CornerRadius="10"
                                        Background="{Binding IconForeground}"
                                        VerticalAlignment="Top"
                                        HorizontalAlignment="Left">
                                    <Path Style="{StaticResource DashboardMetricIconPath}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding Label}"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Foreground="#2E4667"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Value}"
                                               Margin="0,5,0,0"
                                               FontSize="19"
                                               FontWeight="Bold"
                                               Foreground="#0B1F44"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Note}"
                                               Margin="0,4,0,0"
                                               FontSize="9.5"
                                               Foreground="#64748B"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="326" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <Border Style="{StaticResource DashboardCard}" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconReports}"
                                          Style="{StaticResource DashboardSectionIcon}"
                                          Stroke="#0B82F6" />
                                    <TextBlock Text="Sales Overview"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="#102A56"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Border Background="#0B82F6" CornerRadius="5,0,0,5" Padding="15,5">
                                        <TextBlock Text="Today" Foreground="White" FontSize="10" FontWeight="SemiBold" />
                                    </Border>
                                    <Border Background="White" BorderBrush="#DDE6F0" BorderThickness="1" Padding="14,5">
                                        <TextBlock Text="This Week" Foreground="#52677F" FontSize="10" />
                                    </Border>
                                    <Border Background="White" BorderBrush="#DDE6F0" BorderThickness="1,1,0,1" Padding="14,5">
                                        <TextBlock Text="This Month" Foreground="#52677F" FontSize="10" />
                                    </Border>
                                    <Border Background="White" BorderBrush="#DDE6F0" BorderThickness="1" CornerRadius="0,5,5,0" Padding="14,5">
                                        <TextBlock Text="This Year" Foreground="#52677F" FontSize="10" />
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="174" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Viewbox Height="178" Stretch="Fill">
                                        <Canvas Width="760" Height="178" Background="White">
                                            <Line X1="28" Y1="24" X2="736" Y2="24" Stroke="#E8EEF5" StrokeThickness="1" />
                                            <Line X1="28" Y1="54" X2="736" Y2="54" Stroke="#E8EEF5" StrokeThickness="1" />
                                            <Line X1="28" Y1="84" X2="736" Y2="84" Stroke="#E8EEF5" StrokeThickness="1" />
                                            <Line X1="28" Y1="114" X2="736" Y2="114" Stroke="#E8EEF5" StrokeThickness="1" />
                                            <Line X1="28" Y1="148" X2="736" Y2="148" Stroke="#CAD8E7" StrokeThickness="1" />
                                            <Polygon Points="{Binding SalesAreaPoints}" Fill="#24168CF8" />
                                            <Polyline Points="{Binding SalesChartPoints}"
                                                      Stroke="#0B82F6"
                                                      StrokeThickness="3"
                                                      StrokeLineJoin="Round" />
                                        </Canvas>
                                    </Viewbox>
                                    <ItemsControl ItemsSource="{Binding SalesTimeline}" Margin="4,2,4,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="12" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Hour, StringFormat={}{0}:00}"
                                                           FontSize="9"
                                                           Foreground="#64748B"
                                                           HorizontalAlignment="Center" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                                        <Ellipse Width="8" Height="8" Fill="#0B82F6" Margin="0,0,5,0" />
                                        <TextBlock Text="Sales (AFN)" FontSize="9.5" Foreground="#52677F" />
                                    </StackPanel>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        BorderBrush="#DFE8F2"
                                        BorderThickness="1,0,0,0"
                                        Padding="16,8,0,0"
                                        Margin="12,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SalesTotalText}" FontSize="16" FontWeight="Bold" Foreground="#0B1F44" />
                                        <TextBlock Text="Total Sales" Style="{StaticResource MiniLabel}" Margin="0,2,0,11" />
                                        <TextBlock Text="{Binding SalesInvoiceCountText}" FontSize="15" FontWeight="Bold" Foreground="#0B1F44" />
                                        <TextBlock Text="Total Invoices" Style="{StaticResource MiniLabel}" Margin="0,2,0,11" />
                                        <TextBlock Text="{Binding AverageInvoiceText}" FontSize="15" FontWeight="Bold" Foreground="#0B1F44" />
                                        <TextBlock Text="Average Invoice" Style="{StaticResource MiniLabel}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource DashboardCard}" Margin="0,0,5,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconInventory}"
                                              Style="{StaticResource DashboardSectionIcon}"
                                              Stroke="#F97316" />
                                        <TextBlock Text="Low Stock Items" FontSize="13.5" FontWeight="Bold"
                                                   Foreground="#102A56" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="View All"
                                            Command="{Binding NavigateCommand}"
                                            CommandParameter="inventory"
                                            Style="{StaticResource DashboardLinkButton}" />
                                </Grid>
                                <DataGrid ItemsSource="{Binding LowStockItems}"
                                          Style="{StaticResource DashboardGrid}"
                                          Height="162">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Medicine" Binding="{Binding Medicine}" Width="*" />
                                        <DataGridTextColumn Header="Current Stock" Binding="{Binding CurrentStock, StringFormat={}{0:0.####}}" Width="82">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#EF4444" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Min. Stock" Binding="{Binding MinimumStock, StringFormat={}{0:0.####}}" Width="72" />
                                        <DataGridTemplateColumn Header="Status" Width="78">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="#FFE7EA" CornerRadius="7" Padding="7,2"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Status}" FontSize="9.5" Foreground="#E11D48" FontWeight="SemiBold" />
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource DashboardCard}" Margin="5,0,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconBatches}"
                                              Style="{StaticResource DashboardSectionIcon}"
                                              Stroke="#F43F5E" />
                                        <TextBlock Text="Expiring Soon" FontSize="13.5" FontWeight="Bold"
                                                   Foreground="#102A56" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="View All"
                                            Command="{Binding NavigateCommand}"
                                            CommandParameter="inventory"
                                            Style="{StaticResource DashboardLinkButton}" />
                                </Grid>
                                <DataGrid ItemsSource="{Binding ExpiryItems}"
                                          Style="{StaticResource DashboardGrid}"
                                          Height="162">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Medicine" Binding="{Binding Medicine}" Width="*" />
                                        <DataGridTextColumn Header="Batch No." Binding="{Binding BatchNumber}" Width="72" />
                                        <DataGridTextColumn Header="Expiry Date" Binding="{Binding ExpiryDate, StringFormat={}{0:dd MMM yyyy}}" Width="92" />
                                        <DataGridTemplateColumn Header="Days Left" Width="70">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="#FFF1D6" CornerRadius="7" Padding="7,2"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DaysLeft, StringFormat={}{0} days}" FontSize="9.5"
                                                                   Foreground="#D97706" FontWeight="SemiBold" />
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource DashboardCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconReports}"
                                          Style="{StaticResource DashboardSectionIcon}"
                                          Stroke="#0B82F6" />
                                    <TextBlock Text="Recent Transactions" FontSize="13.5" FontWeight="Bold"
                                               Foreground="#102A56" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="View All"
                                        Command="{Binding NavigateCommand}"
                                        CommandParameter="reports"
                                        Style="{StaticResource DashboardLinkButton}" />
                            </Grid>
                            <DataGrid ItemsSource="{Binding RecentTransactions}"
                                      Style="{StaticResource DashboardGrid}"
                                      Height="170">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date &amp; Time" Binding="{Binding OccurredAt, StringFormat={}{0:dd MMM yyyy HH:mm}}" Width="125" />
                                    <DataGridTemplateColumn Header="Type" Width="74">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="#E7F2FF" CornerRadius="7" Padding="7,2"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Type}" FontSize="9.5" Foreground="#0B6FD3" FontWeight="SemiBold" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Invoice/Purchase #" Binding="{Binding DocumentNumber}" Width="124" />
                                    <DataGridTextColumn Header="Customer / Supplier" Binding="{Binding Party}" Width="*" />
                                    <DataGridTextColumn Header="Items" Binding="{Binding Items}" Width="48" />
                                    <DataGridTextColumn Header="Total (AFN)" Binding="{Binding Total, StringFormat={}{0:N2}}" Width="86" />
                                    <DataGridTextColumn Header="Payment Method" Binding="{Binding PaymentMethod}" Width="102" />
                                    <DataGridTemplateColumn Header="Status" Width="78">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="#DCFCE7" CornerRadius="7" Padding="7,2"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Status}" FontSize="9.5" Foreground="#15803D" FontWeight="SemiBold" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource DashboardCard}" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconBadgeCheck}"
                                          Style="{StaticResource DashboardSectionIcon}"
                                          Stroke="#16A34A" />
                                    <TextBlock Text="License &amp; Subscription" FontSize="13.5" FontWeight="Bold"
                                               Foreground="#102A56" VerticalAlignment="Center" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="#DCFCE7" CornerRadius="8" Padding="8,3">
                                    <TextBlock Text="{Binding PlanLabel}" Foreground="#15803D" FontSize="9.5" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding LicenseValidityText}" Margin="0,9,0,7"
                                       FontSize="10.5" Foreground="#52677F" />
                            <ProgressBar Value="{Binding LicenseProgressValue}" Maximum="100" Height="8"
                                         Foreground="#22C55E" Background="#E5EDF6" BorderThickness="0" />
                            <Grid Margin="0,5,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding LicenseDaysRemainingText}" FontSize="9.5" Foreground="#64748B" />
                                <TextBlock Grid.Column="1" Text="{Binding LicenseProgressValue, StringFormat={}{0:0}%}"
                                           FontSize="9.5" Foreground="#52677F" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding LicenseFeatures}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,4,3">
                                            <Border Width="15" Height="15" CornerRadius="8" Background="#DCFCE7"
                                                    VerticalAlignment="Center" Margin="0,0,6,0">
                                                <Path Data="{StaticResource IconBadgeCheck}" Width="9" Height="9"
                                                      Stroke="#16A34A" StrokeThickness="2" Fill="Transparent"
                                                      Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{Binding}" FontSize="9.4" Foreground="#405875"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource DashboardCard}" Margin="0,0,0,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Path Data="{StaticResource IconPos}"
                                      Style="{StaticResource DashboardSectionIcon}"
                                      Stroke="#F59E0B" />
                                <TextBlock Text="{Binding QuickActionsTitle}" FontSize="13.5" FontWeight="Bold"
                                           Foreground="#102A56" VerticalAlignment="Center" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding QuickActions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Key}"
                                                IsEnabled="{Binding IsAvailable}"
                                                Style="{StaticResource ProfessionalButtonBase}"
                                                Background="{Binding Accent}"
                                                BorderBrush="{Binding Accent}"
                                                Foreground="White"
                                                Padding="10,7"
                                                Margin="0,0,0,6"
                                                HorizontalContentAlignment="Stretch">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Path Style="{StaticResource NavigationIconPath}"
                                                      Width="15" Height="15"
                                                      Stroke="White"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Label}"
                                                           Foreground="White" FontWeight="SemiBold"
                                                           FontSize="10.5" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding Shortcut}"
                                                           Foreground="White" FontSize="9.5"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource DashboardCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconDashboard}"
                                          Style="{StaticResource DashboardSectionIcon}"
                                          Stroke="#0B82F6" />
                                    <TextBlock Text="Pharmacy Overview" FontSize="13.5" FontWeight="Bold"
                                               Foreground="#102A56" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="View Reports"
                                        Command="{Binding NavigateCommand}"
                                        CommandParameter="reports"
                                        Style="{StaticResource DashboardLinkButton}" />
                            </Grid>

                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Total Medicines" Style="{StaticResource MiniLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding OverviewMedicinesText}" Style="{StaticResource OverviewValue}" />
                            </Grid>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Total Batches" Style="{StaticResource MiniLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding OverviewBatchesText}" Style="{StaticResource OverviewValue}" />
                            </Grid>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Total Suppliers" Style="{StaticResource MiniLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding OverviewSuppliersText}" Style="{StaticResource OverviewValue}" />
                            </Grid>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Total Customers" Style="{StaticResource MiniLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding OverviewCustomersText}" Style="{StaticResource OverviewValue}" />
                            </Grid>
                            <Separator Margin="0,5" Background="#E8EEF5" />
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Total Sales (This Month)" Style="{StaticResource MiniLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding OverviewMonthSalesText}" Style="{StaticResource OverviewValue}" FontSize="10.5" />
                            </Grid>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Total Purchases (This Month)" Style="{StaticResource MiniLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding OverviewMonthPurchasesText}" Style="{StaticResource OverviewValue}" FontSize="10.5" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
