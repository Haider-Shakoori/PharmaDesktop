<UserControl x:Class="BusinessOS.Pharmacy.Desktop.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="DashboardCard" TargetType="Border" BasedOn="{StaticResource SurfaceCard}">
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style x:Key="DashboardGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E2E8F0" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="MiniLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>

        <Style x:Key="OverviewValue" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <Style x:Key="DashboardSectionIcon" TargetType="Path">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="StrokeThickness" Value="1.8" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>

        <Style x:Key="DashboardMetricIconPath" TargetType="Path">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Stroke" Value="{Binding IconForeground}" />
            <Setter Property="StrokeThickness" Value="1.8" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IconKey}" Value="reports"><Setter Property="Data" Value="{StaticResource IconReports}" /></DataTrigger>
                <DataTrigger Binding="{Binding IconKey}" Value="purchases"><Setter Property="Data" Value="{StaticResource IconPurchases}" /></DataTrigger>
                <DataTrigger Binding="{Binding IconKey}" Value="inventory"><Setter Property="Data" Value="{StaticResource IconInventory}" /></DataTrigger>
                <DataTrigger Binding="{Binding IconKey}" Value="batches"><Setter Property="Data" Value="{StaticResource IconBatches}" /></DataTrigger>
                <DataTrigger Binding="{Binding IconKey}" Value="expenses"><Setter Property="Data" Value="{StaticResource IconExpenses}" /></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">
            <!-- Dashboard heading -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Dashboard"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding WelcomeText}"
                               Margin="0,3,0,0"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="{Binding RefreshLabel}"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="100"
                        VerticalAlignment="Center" />
            </Grid>

            <!-- Five primary cards from the generated design -->
            <ItemsControl ItemsSource="{Binding Stats}" Margin="0,0,0,14">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="5" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource DashboardCard}" Margin="0,0,10,0" MinHeight="122">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34"
                                            Height="34"
                                            CornerRadius="9"
                                            Background="{Binding IconBackground}"
                                            VerticalAlignment="Center">
                                        <Path Style="{StaticResource DashboardMetricIconPath}"
                                              Width="17"
                                              Height="17"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Label}"
                                               Margin="8,0,0,0"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="{Binding Value}"
                                           Margin="0,10,0,0"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Note}"
                                           Margin="0,5,0,0"
                                           FontSize="9.5"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Main dashboard body -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <!-- Sales overview -->
                    <Border Style="{StaticResource DashboardCard}" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconReports}"
                                          Style="{StaticResource DashboardSectionIcon}"
                                          Stroke="{DynamicResource InfoBrush}" />
                                    <TextBlock Text="Sales Overview"
                                               FontSize="15"
                                               FontWeight="Bold" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Border Background="{DynamicResource BrandPrimaryBrush}" CornerRadius="5" Padding="14,5">
                                        <TextBlock Text="Today" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                    <Border BorderBrush="#E2E8F0" BorderThickness="1" Padding="12,5">
                                        <TextBlock Text="This Week" Foreground="#64748B" FontSize="11" />
                                    </Border>
                                    <Border BorderBrush="#E2E8F0" BorderThickness="1" Padding="12,5">
                                        <TextBlock Text="This Month" Foreground="#64748B" FontSize="11" />
                                    </Border>
                                    <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="0,5,5,0" Padding="12,5">
                                        <TextBlock Text="This Year" Foreground="#64748B" FontSize="11" />
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="180" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <Viewbox Height="170" Stretch="Fill">
                                        <Canvas Width="720" Height="170" Background="White">
                                            <Line X1="24" Y1="28" X2="696" Y2="28" Stroke="#E8EEF5" StrokeThickness="1" />
                                            <Line X1="24" Y1="58" X2="696" Y2="58" Stroke="#E8EEF5" StrokeThickness="1" />
                                            <Line X1="24" Y1="88" X2="696" Y2="88" Stroke="#E8EEF5" StrokeThickness="1" />
                                            <Line X1="24" Y1="118" X2="696" Y2="118" Stroke="#E8EEF5" StrokeThickness="1" />
                                            <Line X1="24" Y1="148" X2="696" Y2="148" Stroke="#CBD5E1" StrokeThickness="1" />
                                            <Polygon Points="{Binding SalesAreaPoints}"
                                                     Fill="#221687F8" />
                                            <Polyline Points="{Binding SalesChartPoints}"
                                                      Stroke="#1687F8"
                                                      StrokeThickness="3"
                                                      StrokeLineJoin="Round" />
                                        </Canvas>
                                    </Viewbox>

                                    <ItemsControl ItemsSource="{Binding SalesTimeline}" Margin="4,3,4,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="12" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Hour, StringFormat={}{0}:00}"
                                                           FontSize="9"
                                                           Foreground="#64748B"
                                                           HorizontalAlignment="Center" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                                        <Ellipse Width="8" Height="8" Fill="#1687F8" Margin="0,0,5,0" />
                                        <TextBlock Text="Sales (AFN)" FontSize="10" Foreground="#64748B" />
                                    </StackPanel>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1,0,0,0"
                                        Padding="16,6,0,0"
                                        Margin="12,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SalesTotalText}" FontSize="17" FontWeight="Bold" />
                                        <TextBlock Text="Total Sales" Style="{StaticResource MiniLabel}" Margin="0,2,0,10" />
                                        <TextBlock Text="{Binding SalesInvoiceCountText}" FontSize="16" FontWeight="Bold" />
                                        <TextBlock Text="Total Invoices" Style="{StaticResource MiniLabel}" Margin="0,2,0,10" />
                                        <TextBlock Text="{Binding AverageInvoiceText}" FontSize="16" FontWeight="Bold" />
                                        <TextBlock Text="Average Invoice" Style="{StaticResource MiniLabel}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Low stock and expiry -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource DashboardCard}" Margin="0,0,6,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconInventory}"
                                              Style="{StaticResource DashboardSectionIcon}"
                                              Stroke="{DynamicResource WarningBrush}" />
                                        <TextBlock Text="Low Stock Items" FontSize="14" FontWeight="Bold" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="View All"
                                            Command="{Binding NavigateCommand}"
                                            CommandParameter="inventory"
                                            Padding="9,3" />
                                </Grid>
                                <DataGrid ItemsSource="{Binding LowStockItems}"
                                          Style="{StaticResource DashboardGrid}"
                                          MinHeight="165">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Medicine" Binding="{Binding Medicine}" Width="*" />
                                        <DataGridTextColumn Header="Current Stock" Binding="{Binding CurrentStock, StringFormat={}{0:0.####}}" Width="85" />
                                        <DataGridTextColumn Header="Min. Stock" Binding="{Binding MinimumStock, StringFormat={}{0:0.####}}" Width="75" />
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="70" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource DashboardCard}" Margin="6,0,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconBatches}"
                                              Style="{StaticResource DashboardSectionIcon}"
                                              Stroke="{DynamicResource DangerBrush}" />
                                        <TextBlock Text="Expiring Soon" FontSize="14" FontWeight="Bold" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="View All"
                                            Command="{Binding NavigateCommand}"
                                            CommandParameter="inventory"
                                            Padding="9,3" />
                                </Grid>
                                <DataGrid ItemsSource="{Binding ExpiryItems}"
                                          Style="{StaticResource DashboardGrid}"
                                          MinHeight="165">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Medicine" Binding="{Binding Medicine}" Width="*" />
                                        <DataGridTextColumn Header="Batch No." Binding="{Binding BatchNumber}" Width="75" />
                                        <DataGridTextColumn Header="Expiry Date" Binding="{Binding ExpiryDate, StringFormat={}{0:dd MMM yyyy}}" Width="90" />
                                        <DataGridTextColumn Header="Days Left" Binding="{Binding DaysLeft}" Width="65" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Recent transactions -->
                    <Border Style="{StaticResource DashboardCard}" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconReports}"
                                          Style="{StaticResource DashboardSectionIcon}"
                                          Stroke="{DynamicResource InfoBrush}" />
                                    <TextBlock Text="Recent Transactions" FontSize="14" FontWeight="Bold" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="View All"
                                        Command="{Binding NavigateCommand}"
                                        CommandParameter="reports"
                                        Padding="9,3" />
                            </Grid>
                            <DataGrid ItemsSource="{Binding RecentTransactions}"
                                      Style="{StaticResource DashboardGrid}"
                                      MinHeight="170">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date &amp; Time" Binding="{Binding OccurredAt, StringFormat={}{0:dd MMM yyyy HH:mm}}" Width="130" />
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="70" />
                                    <DataGridTextColumn Header="Invoice/Purchase #" Binding="{Binding DocumentNumber}" Width="130" />
                                    <DataGridTextColumn Header="Customer / Supplier" Binding="{Binding Party}" Width="*" />
                                    <DataGridTextColumn Header="Items" Binding="{Binding Items}" Width="50" />
                                    <DataGridTextColumn Header="Total (AFN)" Binding="{Binding Total, StringFormat={}{0:N2}}" Width="90" />
                                    <DataGridTextColumn Header="Payment Method" Binding="{Binding PaymentMethod}" Width="105" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="75" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- Preserve prior alert information -->
                    <Border Background="#FFFBEB"
                            BorderBrush="#FCD34D"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12"
                            Visibility="{Binding HasAlerts, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="!"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#92400E"
                                       Margin="0,0,10,0" />
                            <StackPanel>
                                <TextBlock Text="{Binding AttentionTitle}"
                                           FontWeight="Bold"
                                           Foreground="#92400E" />
                                <TextBlock Text="{Binding AttentionSummary}"
                                           Margin="0,2,0,0"
                                           Foreground="#92400E" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right side -->
                <StackPanel Grid.Column="1">
                    <!-- License & Subscription -->
                    <Border Style="{StaticResource DashboardCard}" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconBadgeCheck}"
                                          Style="{StaticResource DashboardSectionIcon}"
                                          Stroke="{DynamicResource SuccessBrush}" />
                                    <TextBlock Text="License &amp; Subscription" FontSize="14" FontWeight="Bold" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="#DCFCE7" CornerRadius="9" Padding="8,3">
                                    <TextBlock Text="{Binding PlanLabel}" Foreground="#15803D" FontSize="10" FontWeight="SemiBold" />
                                </Border>
                            </Grid>

                            <TextBlock Text="{Binding LicenseValidityText}"
                                       Margin="0,10,0,6"
                                       FontSize="11"
                                       Foreground="#64748B"
                                       TextWrapping="Wrap" />
                            <ProgressBar Value="{Binding LicenseProgressValue}"
                                         Maximum="100"
                                         Height="8" />
                            <TextBlock Text="{Binding LicenseDaysRemainingText}"
                                       Margin="0,5,0,7"
                                       FontSize="10"
                                       Foreground="#64748B" />

                            <ItemsControl ItemsSource="{Binding LicenseFeatures}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                            <Ellipse Width="6" Height="6"
                                                     Fill="{DynamicResource SuccessBrush}"
                                                     Margin="0,0,7,0"
                                                     VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding}" FontSize="10" Foreground="#475569" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Quick Actions -->
                    <Border Style="{StaticResource DashboardCard}" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Width="28" Height="28"
                                        CornerRadius="8"
                                        Background="{DynamicResource SelectedBrush}"
                                        Margin="0,0,8,0">
                                    <Path Data="{StaticResource IconPos}"
                                          Width="15" Height="15"
                                          Stroke="{DynamicResource BrandPrimaryBrush}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Fill="Transparent"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding QuickActionsTitle}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding QuickActions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Key}"
                                                IsEnabled="{Binding IsAvailable}"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="8,7"
                                                Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="28"
                                                        Height="28"
                                                        CornerRadius="8"
                                                        Background="{DynamicResource SurfaceMutedBrush}"
                                                        HorizontalAlignment="Left">
                                                    <Path Style="{StaticResource NavigationIconPath}"
                                                          Width="15"
                                                          Height="15"
                                                          Stroke="{Binding Accent}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Label}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                                <Border Grid.Column="2"
                                                        Background="{DynamicResource SurfaceMutedBrush}"
                                                        CornerRadius="6"
                                                        Padding="6,3">
                                                    <TextBlock Text="{Binding Shortcut}"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               FontSize="10"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding SyncStatusText}"
                                       Margin="0,3,0,0"
                                       FontSize="9"
                                       Foreground="#64748B"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Pharmacy overview -->
                    <Border Style="{StaticResource DashboardCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconDashboard}"
                                          Style="{StaticResource DashboardSectionIcon}"
                                          Stroke="{DynamicResource InfoBrush}" />
                                    <TextBlock Text="Pharmacy Overview" FontSize="14" FontWeight="Bold" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="View Reports"
                                        Command="{Binding NavigateCommand}"
                                        CommandParameter="reports"
                                        Padding="8,3"
                                        FontSize="10" />
                            </Grid>

                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Total Medicines" Style="{StaticResource MiniLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding OverviewMedicinesText}" Style="{StaticResource OverviewValue}" />
                            </Grid>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Total Batches" Style="{StaticResource MiniLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding OverviewBatchesText}" Style="{StaticResource OverviewValue}" />
                            </Grid>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Total Suppliers" Style="{StaticResource MiniLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding OverviewSuppliersText}" Style="{StaticResource OverviewValue}" />
                            </Grid>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Total Customers" Style="{StaticResource MiniLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding OverviewCustomersText}" Style="{StaticResource OverviewValue}" />
                            </Grid>
                            <Separator Margin="0,5" />
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Total Sales (This Month)" Style="{StaticResource MiniLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding OverviewMonthSalesText}" Style="{StaticResource OverviewValue}" FontSize="11" />
                            </Grid>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Total Purchases (This Month)" Style="{StaticResource MiniLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding OverviewMonthPurchasesText}" Style="{StaticResource OverviewValue}" FontSize="11" />
                            </Grid>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Stock Value" Style="{StaticResource MiniLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding OverviewStockValueText}" Style="{StaticResource OverviewValue}" FontSize="11" />
                            </Grid>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Credit Due" Style="{StaticResource MiniLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding OverviewCreditDueText}" Style="{StaticResource OverviewValue}" FontSize="11" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding StatusText}"
                       Margin="0,12,0,0"
                       FontSize="10"
                       Foreground="{DynamicResource TextMutedBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
