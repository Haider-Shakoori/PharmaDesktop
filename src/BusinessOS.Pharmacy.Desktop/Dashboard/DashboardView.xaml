<UserControl x:Class="BusinessOS.Pharmacy.Desktop.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="26">
            <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <Border Background="#ECFDF5"
                                CornerRadius="12"
                                Padding="10,4"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,10">
                            <TextBlock Text="{Binding SubscriptionLabel}"
                                       Foreground="#047857"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="{Binding PharmacyName}"
                                   FontSize="27"
                                   FontWeight="Bold" />
                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                            <TextBlock Text="{Binding SignedInUser}"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text=" · "
                                       Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="{Binding BusinessDateText}"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusText}"
                                   Margin="0,10,0,0"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button Content="{Binding RefreshLabel}"
                                Command="{Binding RefreshCommand}"
                                Style="{StaticResource PrimaryButton}"
                                MinWidth="110"
                                Margin="0,0,0,10" />
                        <Border Background="{DynamicResource AppBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="{Binding PharmacyCodeLabel}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding PharmacyCode}"
                                           Margin="0,4,0,0"
                                           FontFamily="Consolas"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding Stats}" Margin="0,0,0,18">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SurfaceCard}" Margin="0,0,10,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="12" />
                                    <TextBlock Text="{Binding Value}"
                                               Margin="0,8,0,0"
                                               FontSize="22"
                                               FontWeight="Bold" />
                                    <TextBlock Text="{Binding Note}"
                                               Margin="0,6,0,0"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="10" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Background="{DynamicResource AppBackgroundBrush}"
                                        Width="34"
                                        Height="34"
                                        CornerRadius="17"
                                        Margin="12,0,0,0">
                                    <TextBlock Text="{Binding Glyph}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontWeight="Bold" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="{Binding QuickActionsTitle}"
                               Foreground="#0F766E"
                               FontSize="12"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding RunPharmacyTitle}"
                               Margin="0,4,0,14"
                               Style="{StaticResource SectionTitleText}" />

                    <ItemsControl ItemsSource="{Binding QuickActions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button IsEnabled="{Binding IsAvailable}"
                                        MinWidth="145"
                                        Padding="14,10"
                                        Margin="0,0,10,10"
                                        ToolTip="This module will become active when its scheduled native module batch is installed.">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Glyph}"
                                                   Margin="0,0,8,0"
                                                   FontWeight="Bold" />
                                        <TextBlock Text="{Binding Label}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Background="#FFFBEB"
                    BorderBrush="#FCD34D"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18"
                    Margin="0,0,0,18"
                    Visibility="{Binding HasAlerts, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="{Binding AttentionTitle}"
                               FontWeight="Bold"
                               Foreground="#92400E" />
                    <TextBlock Text="{Binding AttentionSummary}"
                               Margin="0,5,0,0"
                               Foreground="#92400E" />

                    <ItemsControl ItemsSource="{Binding Alerts}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White"
                                        BorderBrush="#FDE68A"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12"
                                        Margin="0,0,0,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Detail}"
                                                       Margin="0,3,0,0"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Kind}"
                                                   FontSize="10"
                                                   Foreground="#92400E"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SurfaceCard}"
                    Visibility="{Binding HasAlerts, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=False}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✓" FontSize="18" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding NoAlertsText}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
