<UserControl x:Class="BusinessOS.Pharmacy.Desktop.Networking.NetworkSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:auth="clr-namespace:BusinessOS.Pharmacy.Desktop.Authentication">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,14">
    <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <StackPanel>
    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleText}"/>
    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
    </StackPanel>
    <Button Grid.Column="1"
    Content="{Binding RefreshLabel}"
    Command="{Binding RefreshCommand}"
    Padding="14,8"/>
    </Grid>

        <TabControl Grid.Row="1">
            <TabItem Header="{Binding ProfileAppearanceTabLabel}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="4,16,4,6">
                        <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,16">
                        <StackPanel>
                        <TextBlock Text="{Binding ProfileTitle}" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{Binding ProfileSubtitle}" Style="{StaticResource MutedText}" Margin="0,4,0,14" TextWrapping="Wrap" />
                        <Grid>
                        <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Width="150" Margin="0,0,18,0">
                        <Border Width="120" Height="120" CornerRadius="60" Background="{DynamicResource BrandPrimarySoftBrush}" HorizontalAlignment="Left">
                        <Grid>
                        <Path Data="{StaticResource IconUsers}"
                        Width="52" Height="52"
                        Stroke="{DynamicResource BrandPrimaryDarkBrush}" StrokeThickness="1.6"
                        Fill="Transparent" Stretch="Uniform"
                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Ellipse Width="120" Height="120">
                        <Ellipse.Fill>
                        <ImageBrush ImageSource="{Binding ProfileImagePath}" Stretch="UniformToFill" />
                        </Ellipse.Fill>
                        <Ellipse.Style>
                        <Style TargetType="Ellipse">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                        <DataTrigger Binding="{Binding HasProfileImage}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        </Style.Triggers>
                        </Style>
                        </Ellipse.Style>
                        </Ellipse>
                        </Grid>
                        </Border>
                        <Button Content="{Binding UploadPhotoLabel}"
                        Command="{Binding UploadProfileImageCommand}"
                        Margin="0,10,0,0"
                        Padding="12,7" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding FirstNameLabel}" FontWeight="SemiBold" />
                        <TextBox Text="{Binding ProfileFirstName, UpdateSourceTrigger=PropertyChanged}"
                        MinHeight="40" Padding="9,7" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding LastNameLabel}" FontWeight="SemiBold" Margin="0,12,0,0" />
                        <TextBox Text="{Binding ProfileLastName, UpdateSourceTrigger=PropertyChanged}"
                        MinHeight="40" Padding="9,7" Margin="0,6,0,0" />
                        <Button Content="{Binding SaveProfileLabel}"
                        Command="{Binding SaveProfileCommand}"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Left"
                        Margin="0,16,0,0"
                        Padding="18,8" />
                        </StackPanel>
                        </Grid>
                        </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,16">
                        <StackPanel>
                        <TextBlock Text="{Binding AppearanceTitle}" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{Binding AppearanceSubtitle}" Style="{StaticResource MutedText}" Margin="0,4,0,14" TextWrapping="Wrap" />
                        <RadioButton GroupName="ApplicationTheme"
                        IsChecked="{Binding UseGlassTheme}"
                        Margin="0,4,0,0">
                        <StackPanel Margin="6,2,0,0">
                        <TextBlock Text="{Binding GlassThemeLabel}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding GlassThemeDescription}" Style="{StaticResource MutedText}" />
                        </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="ApplicationTheme"
                        IsChecked="{Binding UseClassicTheme}"
                        Margin="0,12,0,0">
                        <StackPanel Margin="6,2,0,0">
                        <TextBlock Text="{Binding ClassicThemeLabel}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ClassicThemeDescription}" Style="{StaticResource MutedText}" />
                        </StackPanel>
                        </RadioButton>
                        </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{Binding SalesPrintingTabLabel}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="4,16,4,6">
                        <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,16">
                        <StackPanel>
                        <TextBlock Text="{Binding ReceiptTitle}" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{Binding ReceiptSubtitle}" Style="{StaticResource MutedText}" Margin="0,4,0,14" TextWrapping="Wrap" />
                        <UniformGrid Columns="2">
                        <CheckBox Content="{Binding ReceiptShowBatchLabel}" IsChecked="{Binding ReceiptShowBatchDetails}" Margin="0,4,18,4" />
                        <CheckBox Content="{Binding ReceiptShowCashierLabel}" IsChecked="{Binding ReceiptShowCashier}" Margin="0,4,18,4" />
                        <CheckBox Content="{Binding ReceiptShowCustomerLabel}" IsChecked="{Binding ReceiptShowCustomer}" Margin="0,4,18,4" />
                        <CheckBox Content="{Binding ReceiptShowPaymentsLabel}" IsChecked="{Binding ReceiptShowPayments}" Margin="0,4,18,4" />
                        <CheckBox Content="{Binding ReceiptShowFooterLabel}" IsChecked="{Binding ReceiptShowFooter}" Margin="0,4,18,4" />
                        </UniformGrid>
                        <TextBlock Text="{Binding ReceiptFooterTextLabel}" FontWeight="SemiBold" Margin="0,14,0,6" />
                        <TextBox Text="{Binding ReceiptFooterText, UpdateSourceTrigger=PropertyChanged}"
                        MinHeight="40" Padding="9,7" MaxWidth="420" HorizontalAlignment="Left" />
                        <Button Content="{Binding SaveReceiptLabel}"
                        Command="{Binding SaveReceiptSettingsCommand}"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Left"
                        Margin="0,16,0,0"
                        Padding="18,8" />
                        </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,16">
                        <StackPanel>
                        <TextBlock Text="{Binding PosTitle}" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{Binding PosSubtitle}" Style="{StaticResource MutedText}" Margin="0,4,0,14" TextWrapping="Wrap" />
                        <CheckBox Content="{Binding PosShowTopSellersLabel}"
                        IsChecked="{Binding PosShowTopSellers}"
                        FontWeight="SemiBold" />
                        <TextBlock Text="{Binding PosShowTopSellersHint}" Style="{StaticResource MutedText}" Margin="24,2,0,0" />

                        <UniformGrid Columns="2" Margin="0,14,0,0">
                        <StackPanel Margin="0,0,18,0">
                        <TextBlock Text="{Binding PosTopSellerCountLabel}" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding PosTopSellerCountOptions}"
                        SelectedItem="{Binding PosTopSellerCount}"
                        MinHeight="38" Padding="8,6" HorizontalAlignment="Left" MinWidth="160" />
                        </StackPanel>
                        <StackPanel Margin="18,0,0,0">
                        <TextBlock Text="{Binding PosTopSellerDaysLabel}" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding PosTopSellerDaysOptions}"
                        SelectedItem="{Binding PosTopSellerDays}"
                        MinHeight="38" Padding="8,6" HorizontalAlignment="Left" MinWidth="160" />
                        </StackPanel>
                        </UniformGrid>

                        <Grid Margin="0,16,0,0">
                        <StackPanel>
                        <TextBlock Text="{Binding PosPreviewTitle}" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding PosTopSellerPreview}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                        <DataTemplate>
                        <TextBlock Text="{Binding}" Style="{StaticResource MutedText}" Margin="0,0,0,3" />
                        </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding PosPreviewEmpty}"
                        Style="{StaticResource MutedText}"
                        Margin="0,6,0,0"
                        Visibility="{Binding PosTopSellerPreview.Count, Converter={StaticResource GlobalCountZeroToVisibility}}" />
                        </StackPanel>
                        <Button Content="{Binding PosPreviewRefreshLabel}"
                        Command="{Binding RefreshTopSellersCommand}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Padding="14,6" />
                        </Grid>

                        <Button Content="{Binding SavePosLabel}"
                        Command="{Binding SavePosSettingsCommand}"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Left"
                        Margin="0,16,0,0"
                        Padding="18,8" />
                        </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{Binding NotificationTabLabel}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="4,16,4,6">
                        <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{Binding NotificationTitle}"
                                           Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="{Binding NotificationSubtitle}"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,4,0,16"
                                           TextWrapping="Wrap"
                                           MaxWidth="820"
                                           HorizontalAlignment="Left" />

                                <Border Background="#F8FAFC"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="14"
                                        Margin="0,0,0,14">
                                    <StackPanel>
                                        <CheckBox Content="{Binding NotificationEnableLabel}"
                                                  IsChecked="{Binding NotificationEnableToasts}"
                                                  FontWeight="SemiBold"
                                                  Margin="0,0,0,12" />

                                        <UniformGrid Columns="2">
                                            <CheckBox Content="{Binding NotificationSuccessLabel}"
                                                      IsChecked="{Binding NotificationSuccessToasts}"
                                                      Margin="0,5,18,5" />
                                            <CheckBox Content="{Binding NotificationInformationLabel}"
                                                      IsChecked="{Binding NotificationInformationToasts}"
                                                      Margin="0,5,18,5" />
                                            <CheckBox Content="{Binding NotificationWarningLabel}"
                                                      IsChecked="{Binding NotificationWarningToasts}"
                                                      Margin="0,5,18,5" />
                                            <CheckBox Content="{Binding NotificationErrorLabel}"
                                                      IsChecked="{Binding NotificationErrorToasts}"
                                                      Margin="0,5,18,5" />
                                            <CheckBox Content="{Binding NotificationSyncLabel}"
                                                      IsChecked="{Binding NotificationSyncToasts}"
                                                      Margin="0,5,18,5" />
                                            <CheckBox Content="{Binding NotificationConnectivityLabel}"
                                                      IsChecked="{Binding NotificationConnectivityToasts}"
                                                      Margin="0,5,18,5" />
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <Border Background="#F0FDFA"
                                        BorderBrush="#CCFBF1"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="14"
                                        Margin="0,0,0,14">
                                    <StackPanel>
                                        <CheckBox Content="{Binding NotificationStockLabel}"
                                                  IsChecked="{Binding NotificationStockAlerts}"
                                                  FontWeight="SemiBold" />
                                        <TextBlock Text="When enabled, out-of-stock and low-stock medicines appear in Notification Center and can be printed or exported as an Excel purchase list."
                                                   Style="{StaticResource MutedText}"
                                                   Margin="24,4,0,0"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Grid MaxWidth="520" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding NotificationDurationLabel}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />

                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding NotificationDurationOptions}"
                                              SelectedItem="{Binding NotificationToastDurationSeconds}"
                                              MinHeight="38"
                                              Padding="8,6"
                                              Margin="12,0,8,0" />

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding NotificationDurationSuffix}"
                                               Style="{StaticResource MutedText}"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <Button Content="{Binding SaveNotificationLabel}"
                                        Command="{Binding SaveNotificationSettingsCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Left"
                                        Margin="0,18,0,0"
                                        Padding="18,8" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{Binding NetworkTerminalsTabLabel}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="4,16,4,6">
                        <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,20,0">
                                    <TextBlock Text="{Binding LiveServerSyncTitle}"
                                               Style="{StaticResource SectionTitleText}" />
                                    <TextBlock Text="{Binding LiveServerSyncSubtitle}"
                                               Style="{StaticResource MutedText}"
                                               Margin="0,4,0,12"
                                               TextWrapping="Wrap"
                                               MaxWidth="760"
                                               HorizontalAlignment="Left" />
                                    <TextBlock Text="{Binding LiveServerSyncStatus}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding LiveServerSyncManagedBy}"
                                               Style="{StaticResource MutedText}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                          Content="{Binding LiveServerSyncToggleLabel}"
                                          IsChecked="{Binding LiveServerSyncEnabled, Mode=OneWay}"
                                          IsThreeState="True"
                                          IsEnabled="False"
                                          VerticalAlignment="Center"
                                          FontWeight="SemiBold"
                                          ToolTip="{Binding LiveServerSyncManagedLabel}" />
                            </Grid>
                        </Border>

                        <UniformGrid Columns="2" Margin="0,0,0,16">
                        <Border Style="{StaticResource SurfaceCard}" Margin="0,0,8,0">
                        <StackPanel>
                        <TextBlock Text="{Binding DeploymentModeLabel}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding CurrentMode}" FontSize="22" FontWeight="Bold" Margin="0,7,0,0"/>
                        <TextBlock Text="{Binding ServiceStatus}" Style="{StaticResource MutedText}" Margin="0,7,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SurfaceCard}" Margin="8,0,0,0">
                        <StackPanel>
                        <TextBlock Text="{Binding ConnectionLabel}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ConnectionStatus}" Margin="0,7,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" Margin="0,7,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        </Border>
                        </UniformGrid>

                        <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,16">
                        <StackPanel>
                        <TextBlock Text="{Binding DeploymentModeLabel}" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12"/>
                        <Grid>
                        <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding Modes}"
                        SelectedItem="{Binding RequestedMode}"
                        Padding="6"/>
                        <TextBlock Grid.Column="1"
                        Text="Standalone ↔ Server preserves the same local database. Client ownership changes require migration/recovery."
                        Margin="14,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource MutedText}"
                        TextWrapping="Wrap"/>
                        <Button Grid.Column="2"
                        Content="{Binding ApplyModeLabel}"
                        Command="{Binding ApplyModeCommand}"
                        Padding="12,8"/>
                        </Grid>
                        </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,16">
                        <StackPanel>
                        <TextBlock Text="{Binding ServiceLabel}" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12"/>

                        <Grid>
                        <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="{Binding ServerNameLabel}" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding ServerName}" Margin="0,5,0,10" Padding="9,7"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding PortLabel}" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding ServerPort}" Margin="0,5,0,10" Padding="9,7"/>
                        </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding ServerAddressLabel}" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding ServerHost}" Margin="0,5,0,10" Padding="9,7"/>

                        <TextBlock Text="{Binding ServerIdLabel}" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding ServerId}" IsReadOnly="True" Margin="0,5,0,10" Padding="9,7" FontFamily="Consolas"/>

                        <TextBlock Text="{Binding CertificateLabel}" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding CertificateFingerprint}" IsReadOnly="True" Margin="0,5,0,12" Padding="9,7" FontFamily="Consolas"/>

                        <WrapPanel>
                        <Button Content="{Binding SaveConnectionLabel}" Command="{Binding SaveConnectionCommand}" Padding="12,8" Margin="0,0,8,8"/>
                        <Button Content="{Binding StartServerLabel}" Command="{Binding StartServerCommand}" Padding="12,8" Margin="0,0,8,8"/>
                        <Button Content="{Binding FirewallLabel}" Command="{Binding ConfigureFirewallCommand}" Padding="12,8" Margin="0,0,8,8"/>
                        <Button Content="{Binding TestConnectionLabel}" Command="{Binding TestConnectionCommand}" Padding="12,8" Margin="0,0,8,8"/>
                        <Button Content="{Binding RediscoverLabel}" Command="{Binding RediscoverCommand}" Padding="12,8" Margin="0,0,8,8"/>
                        </WrapPanel>
                        </StackPanel>
                        </Border>

                        <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="0.95*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource SurfaceCard}">
                        <StackPanel>
                        <TextBlock Text="{Binding PairingLabel}" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12"/>
                        <Button Content="{Binding CreatePairingLabel}"
                        Command="{Binding CreatePairingCodeCommand}"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Left"
                        Padding="14,9"/>
                        <Border Background="{DynamicResource SurfaceMutedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Margin="0,14,0,0"
                        Padding="16">
                        <StackPanel>
                        <TextBlock Text="{Binding PairingCode}"
                        FontFamily="Consolas"
                        FontSize="32"
                        FontWeight="Bold"
                        HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding PairingExpiry}"
                        Style="{StaticResource MutedText}"
                        HorizontalAlignment="Center"
                        Margin="0,5,0,0"/>
                        </StackPanel>
                        </Border>
                        <TextBlock Text="Pairing codes are short-lived, one-time credentials. Do not reuse or store them."
                        Style="{StaticResource MutedText}"
                        TextWrapping="Wrap"
                        Margin="0,10,0,0"/>
                        </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource SurfaceCard}">
                        <StackPanel>
                        <TextBlock Text="{Binding TerminalsLabel}" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12"/>
                        <ComboBox ItemsSource="{Binding Terminals}"
                        SelectedItem="{Binding SelectedTerminal}"
                        DisplayMemberPath="Name"
                        Padding="6"
                        Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding RenameTerminalTo}" Padding="9,7"/>
                        <Button Grid.Column="1"
                        Content="{Binding RenameLabel}"
                        Command="{Binding RenameTerminalCommand}"
                        Margin="8,0,0,0"
                        Padding="12,8"/>
                        </Grid>

                        <Border Background="{DynamicResource SurfaceMutedBrush}"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,0,0,10">
                        <StackPanel>
                        <TextBlock Text="{Binding SelectedTerminal.ComputerName, StringFormat=Computer: {0}}"/>
                        <TextBlock Text="{Binding SelectedTerminal.TerminalRole, StringFormat=Role: {0}}" Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding SelectedTerminal.LastSeenAt, StringFormat=Last seen: {0}}" Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding SelectedTerminal.IsActive, StringFormat=Active: {0}}" Margin="0,3,0,0"/>
                        </StackPanel>
                        </Border>

                        <Button Content="{Binding RevokeLabel}"
                        Command="{Binding RevokeTerminalCommand}"
                        Padding="12,8"
                        HorizontalAlignment="Left"/>
                        </StackPanel>
                        </Border>
                        </Grid>

                        <Border Style="{StaticResource SurfaceCard}">
                        <StackPanel>
                        <Grid>
                        <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Diagnostics" Style="{StaticResource SectionTitleText}"/>
                        <Button Grid.Column="1"
                        Content="{Binding RunDiagnosticsLabel}"
                        Command="{Binding RunDiagnosticsCommand}"
                        Padding="12,8"/>
                        </Grid>

                        <TextBlock Text="{Binding NetworkProfileLabel}" FontWeight="SemiBold" Margin="0,12,0,0"/>
                        <TextBlock Text="{Binding NetworkProfileStatus}" Style="{StaticResource MutedText}"
                        Margin="0,4,0,0" TextWrapping="Wrap"/>

                        <TextBlock Text="{Binding FirewallStatusLabel}" FontWeight="SemiBold" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding FirewallStatus}" Style="{StaticResource MutedText}"
                        Margin="0,4,0,0" TextWrapping="Wrap"/>

                        <TextBox Text="{Binding DiagnosticsReport}"
                        IsReadOnly="True"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto"
                        MinHeight="160"
                        Margin="0,12,0,0"
                        Padding="10"
                        FontFamily="Consolas"/>
                        </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{Binding SecurityTabLabel}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <auth:PasswordChangeView DataContext="{Binding DataContext.PasswordChange, RelativeSource={RelativeSource AncestorType=Window}}" />
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
