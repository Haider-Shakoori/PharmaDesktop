<Window x:Class="BusinessOS.Pharmacy.Desktop.Networking.DeploymentSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Darmaltoon Setup"
        Width="760" Height="720"
        MinWidth="680" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="34">
            <TextBlock Text="How will this computer be used?" FontSize="27" FontWeight="Bold"/>
            <TextBlock Text="Choose the setup that matches this pharmacy. You can change network mode later from Network &amp; Terminals."
                       Style="{StaticResource MutedText}" Margin="0,6,0,22" TextWrapping="Wrap"/>

            <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,14">
                <StackPanel>
                    <RadioButton Content="Standalone Pharmacy — one computer runs the pharmacy"
                                 IsChecked="{Binding SelectedMode, Converter={StaticResource EnumEqualityConverter}, ConverterParameter=Standalone}"
                                 Margin="0,0,0,10"/>
                    <RadioButton Content="Main Pharmacy Server — this computer stores pharmacy data and allows other pharmacy computers to connect"
                                 IsChecked="{Binding SelectedMode, Converter={StaticResource EnumEqualityConverter}, ConverterParameter=Server}"
                                 Margin="0,0,0,10"/>
                    <RadioButton Content="Client Terminal — connect this computer to an existing Darmaltoon Main Pharmacy Server"
                                 IsChecked="{Binding SelectedMode, Converter={StaticResource EnumEqualityConverter}, ConverterParameter=Client}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Main server / client connection details" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12"/>

                    <TextBlock Text="Server name" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding ServerName}" Margin="0,5,0,10" Padding="9,7"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Server address or hostname" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding ServerHost}" Margin="0,5,0,10" Padding="9,7"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Port" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding ServerPort}" Margin="0,5,0,10" Padding="9,7"/>
                        </StackPanel>
                    </Grid>

                    <Button Content="Find Pharmacy Servers" Command="{Binding DiscoverCommand}" Padding="12,8" HorizontalAlignment="Left"/>
                    <ListBox ItemsSource="{Binding DiscoveredServers}" SelectedItem="{Binding SelectedDiscoveredServer}"
                             DisplayMemberPath="ServerName" MaxHeight="110" Margin="0,8,0,12"/>

                    <TextBlock Text="Server UUID" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding ServerId}" Margin="0,5,0,10" Padding="9,7"/>

                    <TextBlock Text="Server certificate SHA-256 fingerprint" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding CertificateSha256}" Margin="0,5,0,10" Padding="9,7" FontFamily="Consolas"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Pairing code" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding PairingCode}" Margin="0,5,0,0" Padding="9,7"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="Terminal name" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding TerminalName}" Margin="0,5,0,0" Padding="9,7"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Terminal role" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding TerminalRole}" Margin="0,5,0,0" Padding="9,7"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,14"/>
            <Button Content="Continue" Command="{Binding SaveCommand}"
                    Style="{StaticResource PrimaryButton}" MinHeight="44"/>
        </StackPanel>
    </ScrollViewer>
</Window>
