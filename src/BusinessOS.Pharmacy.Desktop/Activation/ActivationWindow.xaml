<Window x:Class="BusinessOS.Pharmacy.Desktop.Activation.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Activate BusinessOS Pharmacy"
        Width="560" Height="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="40">
        <Border Style="{StaticResource SurfaceCard}" Padding="30">
            <StackPanel>
                <TextBlock Text="BusinessOS Pharmacy" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="BusinessOS.af" Style="{StaticResource MutedText}" Margin="0,4,0,26" />

                <TextBlock Text="Activate Your Pharmacy" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Use the license key issued by the BusinessOS Pharmacy website."
                           Style="{StaticResource MutedText}" Margin="0,6,0,20" TextWrapping="Wrap" />

                <TextBlock Text="License Key" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBox Text="{Binding LicenseKey, UpdateSourceTrigger=PropertyChanged}"
                         MinHeight="42" Padding="10,8" FontSize="14" />

                <Button Content="Activate"
                        Command="{Binding ActivateCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,14,0,0" MinHeight="42" />

                <TextBlock Text="{Binding StatusMessage}"
                           TextWrapping="Wrap"
                           Margin="0,14,0,18"
                           Foreground="{DynamicResource TextMutedBrush}" />

                <Separator />
                <TextBlock Text="Don't have a license?" Margin="0,18,0,8" />
                <Button Content="Start 7-Day Free Trial"
                        Command="{Binding StartTrialCommand}"
                        Padding="14,9" Cursor="Hand" />

                <TextBlock Margin="0,18,0,0"
                           Style="{StaticResource MutedText}"
                           TextWrapping="Wrap"
                           Text="Initial activation requires internet. After activation, BusinessOS Pharmacy can continue operating offline while the signed entitlement remains valid." />
            </StackPanel>
        </Border>
    </Grid>
</Window>