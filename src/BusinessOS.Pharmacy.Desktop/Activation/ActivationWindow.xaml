<Window x:Class="BusinessOS.Pharmacy.Desktop.Activation.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Darmaltoon;component/Assets/Darmaltoon.ico"
        Title="Activate Darmaltoon"
        Width="620" Height="680"
        MinWidth="560" MinHeight="600"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="36">
            <Border Style="{StaticResource SurfaceCard}" Padding="28">
                <StackPanel>
                    <TextBlock Text="Darmaltoon" FontSize="30" FontWeight="SemiBold" />
                    <TextBlock Text="darmaltoon.com · BusinessOS.af"
                               Style="{StaticResource MutedText}"
                               Margin="0,4,0,24" />

                    <TextBlock Text="Activate Your Pharmacy"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Activate an existing subscription, or request a new 7-day trial below."
                               Style="{StaticResource MutedText}"
                               Margin="0,6,0,18"
                               TextWrapping="Wrap" />

                    <Border Padding="16"
                            Margin="0,0,0,22"
                            CornerRadius="12"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource BorderBrush}"
                            Background="{DynamicResource AppBackgroundBrush}">
                        <StackPanel>
                            <TextBlock Text="New to Darmaltoon?"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                            <TextBlock Margin="0,5,0,12"
                                       Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap"
                                       Text="Request a 7-day trial on the Darmaltoon website. After your request is approved, copy the generated license key and return here to activate this PC." />
                            <Button Content="Request 7-Day Free Trial"
                                    Command="{Binding StartTrialCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    MinHeight="42"
                                    Cursor="Hand" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Already have a license key?"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10" />

                    <TextBlock Text="License Key"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6" />
                    <TextBox Text="{Binding LicenseKey, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="44"
                             Padding="10,8"
                             FontSize="14" />

                    <Button Content="Activate"
                            Command="{Binding ActivateCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,14,0,0"
                            MinHeight="42" />

                    <TextBlock Text="{Binding StatusMessage}"
                               TextWrapping="Wrap"
                               Margin="0,14,0,0"
                               Foreground="{DynamicResource TextMutedBrush}" />

                    <Separator Margin="0,20,0,16" />

                    <TextBlock Style="{StaticResource MutedText}"
                               TextWrapping="Wrap"
                               Text="Initial activation requires internet. After activation, Darmaltoon can continue operating offline while the signed entitlement remains valid." />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
