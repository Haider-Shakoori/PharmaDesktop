<UserControl x:Class="BusinessOS.Pharmacy.Desktop.Inventory.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BusinessOS.Pharmacy.Desktop.Controls"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">
    <UserControl.Resources>
        <Style x:Key="InventoryToolbarBox" TargetType="Control">
            <Setter Property="Height" Value="38" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="InventoryTableHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Height" Value="42" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid Background="{TemplateBinding Background}">
                            <Border BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </Border>
                            <Thumb x:Name="PART_LeftHeaderGripper"
                                   Width="5"
                                   HorizontalAlignment="Left"
                                   Background="Transparent"
                                   Cursor="SizeWE" />
                            <Thumb x:Name="PART_RightHeaderGripper"
                                   Width="5"
                                   HorizontalAlignment="Right"
                                   Background="Transparent"
                                   Cursor="SizeWE" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InventoryTableCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="FontSize" Value="12.2" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontWeight" Value="Bold" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InventoryTableRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="44" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D9E2EC" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#FAFCFF" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0FDFA" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0F766E" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="BorderBrush" Value="#0D9488" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InventoryTable" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="AlternationCount" Value="2" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="CellStyle" Value="{StaticResource InventoryTableCell}" />
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource InventoryTableHeader}" />
            <Setter Property="RowStyle" Value="{StaticResource InventoryTableRow}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style x:Key="InventoryTextColumnText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="#334155" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InventoryRowPrimaryText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InventoryRowSecondaryText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InventoryActionButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Foreground" Value="#2563EB" />
            <Setter Property="Background" Value="#EFF6FF" />
            <Setter Property="BorderBrush" Value="#DBEAFE" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="Background" Value="#28FFFFFF" />
                    <Setter Property="BorderBrush" Value="#66FFFFFF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InventoryStatusPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="InventoryModalLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <Style x:Key="InventoryModalField" TargetType="Control">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="InventoryTabButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>

        <Style x:Key="InventoryHistoryTable" TargetType="DataGrid" BasedOn="{StaticResource InventoryTable}">
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource InventoryTableRow}">
                        <Setter Property="Height" Value="38" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource PageBackgroundBrush}">
        <Grid Margin="22" x:Name="InventoryPageContent">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Effect" Value="{x:Null}" />
                    <Setter Property="IsHitTestVisible" Value="True" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEditorOpen}" Value="True">
                            <Setter Property="IsHitTestVisible" Value="False" />
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <BlurEffect Radius="7"
                                                KernelType="Gaussian"
                                                RenderingBias="Performance" />
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <controls:PageHeader Grid.Row="0"
                                 Eyebrow="{Binding Eyebrow}"
                                 Title="{Binding Title}"
                                 Description="{Binding Subtitle}" />

            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#DCE5F0"
                    BorderThickness="1"
                    CornerRadius="13"
                    ClipToBounds="True"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="12,12,12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.1*"/>
                            <ColumnDefinition Width="125"/>
                            <ColumnDefinition Width="125"/>
                            <ColumnDefinition Width="175"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Background="White"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                CornerRadius="8"
                                Height="38"
                                Margin="0,0,8,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Data="{StaticResource IconSearch}"
                                      Width="15" Height="15"
                                      Stroke="#64748B"
                                      StrokeThickness="1.7"
                                      Fill="Transparent"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                                <Grid Grid.Column="1">
                                    <TextBlock Text="Search medicine, code or batch..."
                                               Foreground="#94A3B8"
                                               FontSize="11.2"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="0"
                                             FontSize="12"
                                             VerticalContentAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1"
                                Background="White"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                CornerRadius="8"
                                Height="38"
                                Margin="0,0,8,0">
                            <ComboBox ItemsSource="{Binding FilterStatuses}"
                                      SelectedItem="{Binding SelectedFilterStatus}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Padding="8,0"
                                      FontSize="11.2"
                                      VerticalContentAlignment="Center"/>
                        </Border>

                        <Border Grid.Column="2"
                                Background="White"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                CornerRadius="8"
                                Height="38"
                                Margin="0,0,8,0">
                            <ComboBox ItemsSource="{Binding ExpiryFilters}"
                                      SelectedItem="{Binding SelectedExpiryFilter}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Padding="8,0"
                                      FontSize="11.2"
                                      VerticalContentAlignment="Center"/>
                        </Border>

                        <Border Grid.Column="3"
                                Background="White"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                CornerRadius="8"
                                Height="38"
                                Margin="0,0,8,0">
                            <Grid>
                                <TextBlock Text="All locations"
                                           Foreground="#475569"
                                           FontSize="11.2"
                                           Margin="10,0,26,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedFilterLocation}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ComboBox ItemsSource="{Binding Locations}"
                                          SelectedItem="{Binding SelectedFilterLocation}"
                                          DisplayMemberPath="Name"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Padding="8,0"
                                          FontSize="11.2"
                                          VerticalContentAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Button Grid.Column="4"
                                Content="Search"
                                Command="{Binding SearchCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Height="38"
                                Padding="11,7"
                                Margin="0,0,8,0"/>

                        <Button Grid.Column="5"
                                Content="{Binding TemplateLabel}"
                                Command="{Binding DownloadCsvTemplateCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                    <Setter Property="Height" Value="38"/>
                                    <Setter Property="Padding" Value="11,7"/>
                                    <Setter Property="Margin" Value="0,0,8,0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInventoryMode}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Grid.Column="6"
                                Content="{Binding ImportLabel}"
                                Command="{Binding ImportCsvCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                    <Setter Property="Height" Value="38"/>
                                    <Setter Property="Padding" Value="11,7"/>
                                    <Setter Property="Margin" Value="0,0,8,0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInventoryMode}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Grid.Column="7"
                                Command="{Binding OpenOpeningStockCommand}"
                                Height="38"
                                Padding="14,7"
                                Background="#1677FF"
                                BorderBrush="#1677FF"
                                Foreground="White"
                                FontWeight="SemiBold"
                                FontSize="12">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Setter Property="Height" Value="38"/>
                                    <Setter Property="Padding" Value="14,7"/>
                                    <Setter Property="Background" Value="#1677FF"/>
                                    <Setter Property="BorderBrush" Value="#1677FF"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInventoryMode}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconAdd}"
                                      Width="14" Height="14"
                                      Stroke="White"
                                      StrokeThickness="2"
                                      Fill="Transparent"
                                      Stretch="Uniform"
                                      Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding OpeningStockLabel}" Foreground="White"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Batches}"
                              SelectedItem="{Binding SelectedBatch}"
                              Style="{StaticResource InventoryTable}"
                              Margin="12,0,12,0">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Medicine" Width="1.8*" MinWidth="175">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center"
                                                    HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding BrandName}"
                                                       Style="{StaticResource InventoryRowPrimaryText}"
                                                       FontWeight="SemiBold"
                                                       FontSize="12.1"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Style="{StaticResource InventoryRowSecondaryText}"
                                                       FontSize="10.2"
                                                       TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding GenericName}"/>
                                                <Run Text="  ·  "/>
                                                <Run Text="{Binding Strength}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Code"
                                                Binding="{Binding MedicineCode}"
                                                ElementStyle="{StaticResource InventoryTextColumnText}"
                                                Width="95"/>
                            <DataGridTextColumn Header="Batch"
                                                Binding="{Binding BatchNumber}"
                                                ElementStyle="{StaticResource InventoryTextColumnText}"
                                                Width="105"/>
                            <DataGridTextColumn Header="Location"
                                                Binding="{Binding StockLocationName}"
                                                ElementStyle="{StaticResource InventoryTextColumnText}"
                                                Width="1.1*"
                                                MinWidth="110"/>
                            <DataGridTextColumn Header="Available"
                                                Binding="{Binding AvailableQuantity, StringFormat={}{0:0.####}}"
                                                ElementStyle="{StaticResource InventoryTextColumnText}"
                                                Width="88"/>

                            <DataGridTemplateColumn Header="Expiry" Width="102">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ExpiresAt, StringFormat={}{0:yyyy-MM-dd}}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Left">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource InventoryTextColumnText}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpired}" Value="True">
                                                            <Setter Property="Foreground" Value="#DC2626"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsNearExpiry}" Value="True">
                                                            <Setter Property="Foreground" Value="#B45309"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Status" Width="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border>
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource InventoryStatusPill}">
                                                    <Setter Property="Background" Value="#D1FAE5"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="depleted">
                                                            <Setter Property="Background" Value="#E2E8F0"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="quarantined">
                                                            <Setter Property="Background" Value="#FEF3C7"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="recalled">
                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="damaged">
                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                            <Setter Property="Background" Value="#28FFFFFF"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}"
                                                       FontSize="10.2"
                                                       FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#047857"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="depleted">
                                                                <Setter Property="Foreground" Value="#475569"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="quarantined">
                                                                <Setter Property="Foreground" Value="#B45309"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="recalled">
                                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="damaged">
                                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                                <Setter Property="Foreground" Value="White"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Cost"
                                                Binding="{Binding PurchaseCost, StringFormat={}{0:N4}}"
                                                ElementStyle="{StaticResource InventoryTextColumnText}"
                                                Width="82"/>
                            <DataGridTextColumn Header="Price"
                                                Binding="{Binding SalePrice, StringFormat={}{0:N4}}"
                                                ElementStyle="{StaticResource InventoryTextColumnText}"
                                                Width="82"/>

                            <DataGridTemplateColumn Header="Actions" Width="72">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.OpenBatchEditorCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource InventoryActionButton}"
                                                Width="30"
                                                Height="28"
                                                ToolTip="{Binding DataContext.ManageLabel, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                VerticalAlignment="Center">
                                            <Path Data="M4,16 L4,20 L8,20 L19,9 L15,5 Z M13.8,6.2 L17.8,10.2"
                                                  Width="13" Height="13"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.7"
                                                  Fill="Transparent"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Stretch="Uniform"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="2" Margin="14,10,14,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PageSummary}"
                                       Foreground="#64748B"
                                       FontSize="11.5"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="   Rows:"
                                       Foreground="#94A3B8"
                                       FontSize="11"
                                       VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding PageSizeOptions}"
                                      SelectedItem="{Binding PageSize}"
                                      Width="58"
                                      Height="28"
                                      Margin="5,0,0,0"
                                      FontSize="11"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Previous"
                                    Command="{Binding PreviousPageCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Height="30"
                                    MinHeight="30"
                                    Padding="10,4"
                                    FontSize="11"
                                    Margin="0,0,5,0"/>

                            <ItemsControl ItemsSource="{Binding PageNumbers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}"
                                                Command="{Binding DataContext.GoToPageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SecondaryButton}"
                                                Width="30"
                                                Height="30"
                                                MinHeight="30"
                                                Padding="4"
                                                Margin="0,0,5,0"
                                                FontSize="11"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Content="Next"
                                    Command="{Binding NextPageCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Height="30"
                                    MinHeight="30"
                                    Padding="10,4"
                                    FontSize="11"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <TextBlock Grid.Row="2"
                       Text="{Binding StatusMessage}"
                       Style="{StaticResource MutedText}"
                       Margin="2,0,0,0"
                       TextWrapping="Wrap"/>
        </Grid>

        <Grid Panel.ZIndex="50"
              Visibility="{Binding IsEditorOpen, Converter={StaticResource GlobalBoolToVisibility}}">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#70F8FAFC" Offset="0" />
                    <GradientStop Color="#60E9EFF7" Offset="0.55" />
                    <GradientStop Color="#72FFFFFF" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>

            <Border Width="960"
                    MaxWidth="960"
                    MaxHeight="760"
                    Margin="28"
                    Padding="0"
                    Background="White"
                    BorderBrush="#D8E2EE"
                    BorderThickness="1"
                    CornerRadius="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18"
                                      ShadowDepth="5"
                                      Opacity="0.18"
                                      RenderingBias="Performance"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="22,18,18,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding EditorTitle}"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A"/>
                            <TextBlock Text="{Binding DetailTitle}"
                                       FontSize="11.5"
                                       Foreground="#64748B"
                                       Margin="0,3,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="✕"
                                Command="{Binding CloseEditorCommand}"
                                Style="{StaticResource GhostButton}"
                                Foreground="#475569"
                                Width="32"
                                Height="32"
                                Padding="0"
                                FontSize="14"/>
                    </Grid>

                    <Border Grid.Row="1"
                            BorderBrush="#E2E8F0"
                            BorderThickness="0,1,0,1"
                            Background="#F8FAFC"
                            Padding="18,8">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{Binding OpeningStockTitle}"
                                    Command="{Binding ShowOpeningTabCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource InventoryTabButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInventoryMode}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsOpeningEditor}" Value="True">
                                                <Setter Property="Background" Value="#E0F2FE"/>
                                                <Setter Property="Foreground" Value="#0369A1"/>
                                                <Setter Property="BorderBrush" Value="#BAE6FD"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="{Binding AdjustmentTitle}"
                                    Command="{Binding ShowAdjustmentTabCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource InventoryTabButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInventoryMode}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsAdjustmentEditor}" Value="True">
                                                <Setter Property="Background" Value="#CCFBF1"/>
                                                <Setter Property="Foreground" Value="#0F766E"/>
                                                <Setter Property="BorderBrush" Value="#99F6E4"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="{Binding StatusTitle}"
                                    Command="{Binding ShowStatusTabCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource InventoryTabButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBatchesMode}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsStatusEditor}" Value="True">
                                                <Setter Property="Background" Value="#FEF3C7"/>
                                                <Setter Property="Foreground" Value="#B45309"/>
                                                <Setter Property="BorderBrush" Value="#FDE68A"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="{Binding HistoryTitle}"
                                    Command="{Binding ShowHistoryTabCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource InventoryTabButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedBatch}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsHistoryEditor}" Value="True">
                                                <Setter Property="Background" Value="#E2E8F0"/>
                                                <Setter Property="Foreground" Value="#334155"/>
                                                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="22,18">
                        <Grid>
                            <Grid Visibility="{Binding IsOpeningEditor, Converter={StaticResource GlobalBoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Medicine" Style="{StaticResource InventoryModalLabel}"/>
                                    <ComboBox ItemsSource="{Binding Medicines}"
                                              SelectedItem="{Binding SelectedOpeningMedicine}"
                                              DisplayMemberPath="BrandName"
                                              Style="{StaticResource InventoryModalField}"
                                              Margin="0,0,0,12"/>

                                    <TextBlock Text="Stock location" Style="{StaticResource InventoryModalLabel}"/>
                                    <ComboBox ItemsSource="{Binding Locations}"
                                              SelectedItem="{Binding SelectedOpeningLocation}"
                                              DisplayMemberPath="Name"
                                              Style="{StaticResource InventoryModalField}"
                                              Margin="0,0,0,12"/>

                                    <TextBlock Text="Batch / lot number" Style="{StaticResource InventoryModalLabel}"/>
                                    <TextBox Text="{Binding OpeningBatchNumber}"
                                             MinHeight="38"
                                             Padding="9,6"
                                             Margin="0,0,0,12"/>

                                    <TextBlock Text="Manufactured date (yyyy-MM-dd)" Style="{StaticResource InventoryModalLabel}"/>
                                    <TextBox Text="{Binding ManufacturedAtText}"
                                             MinHeight="38"
                                             Padding="9,6"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Expiry date (yyyy-MM-dd)" Style="{StaticResource InventoryModalLabel}"/>
                                    <TextBox Text="{Binding ExpiresAtText}"
                                             MinHeight="38"
                                             Padding="9,6"
                                             Margin="0,0,0,12"/>

                                    <TextBlock Text="Quantity" Style="{StaticResource InventoryModalLabel}"/>
                                    <TextBox Text="{Binding OpeningQuantity, ValidatesOnExceptions=True}"
                                             MinHeight="38"
                                             Padding="9,6"
                                             Margin="0,0,0,12"/>

                                    <TextBlock Text="Purchase cost" Style="{StaticResource InventoryModalLabel}"/>
                                    <TextBox Text="{Binding PurchaseCost, ValidatesOnExceptions=True}"
                                             MinHeight="38"
                                             Padding="9,6"
                                             Margin="0,0,0,12"/>

                                    <TextBlock Text="Sale price (optional)" Style="{StaticResource InventoryModalLabel}"/>
                                    <TextBox Text="{Binding SalePrice}"
                                             MinHeight="38"
                                             Padding="9,6"
                                             Margin="0,0,0,12"/>

                                    <TextBlock Text="Notes" Style="{StaticResource InventoryModalLabel}"/>
                                    <TextBox Text="{Binding OpeningNotes}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MinHeight="78"
                                             Padding="9,6"/>
                                </StackPanel>
                            </Grid>

                            <Grid Visibility="{Binding IsAdjustmentEditor, Converter={StaticResource GlobalBoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Selected batch" Style="{StaticResource InventoryModalLabel}"/>
                                    <Border Background="#F8FAFC"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="11"
                                            Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SelectedBatch.BrandName}"
                                                       FontWeight="SemiBold"
                                                       Foreground="#0F172A"/>
                                            <TextBlock Foreground="#64748B"
                                                       FontSize="11"
                                                       Margin="0,3,0,0">
                                                <Run Text="{Binding SelectedBatch.BatchNumber, TargetNullValue='No batch'}"/>
                                                <Run Text="  ·  "/>
                                                <Run Text="{Binding SelectedBatch.StockLocationName}"/>
                                                <Run Text="  ·  Available "/>
                                                <Run Text="{Binding SelectedBatch.AvailableQuantity, StringFormat={}{0:0.####}}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="Quantity change (+/-)" Style="{StaticResource InventoryModalLabel}"/>
                                    <TextBox Text="{Binding AdjustmentQuantity, ValidatesOnExceptions=True}"
                                             MinHeight="38"
                                             Padding="9,6"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Reason code" Style="{StaticResource InventoryModalLabel}"/>
                                    <ComboBox ItemsSource="{Binding AdjustmentReasons}"
                                              SelectedItem="{Binding SelectedAdjustmentReason}"
                                              Style="{StaticResource InventoryModalField}"
                                              Margin="0,0,0,12"/>

                                    <TextBlock Text="Reason" Style="{StaticResource InventoryModalLabel}"/>
                                    <TextBox Text="{Binding AdjustmentReason}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MinHeight="120"
                                             Padding="9,6"/>
                                </StackPanel>
                            </Grid>

                            <Grid Visibility="{Binding IsStatusEditor, Converter={StaticResource GlobalBoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Selected batch" Style="{StaticResource InventoryModalLabel}"/>
                                    <Border Background="#F8FAFC"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="11">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SelectedBatch.BrandName}"
                                                       FontWeight="SemiBold"
                                                       Foreground="#0F172A"/>
                                            <TextBlock Text="{Binding SelectedBatch.BatchNumber, TargetNullValue='No batch'}"
                                                       Foreground="#64748B"
                                                       FontSize="11"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="New status" Style="{StaticResource InventoryModalLabel}"/>
                                    <ComboBox ItemsSource="{Binding BatchStatuses}"
                                              SelectedItem="{Binding SelectedBatchStatus}"
                                              Style="{StaticResource InventoryModalField}"
                                              Margin="0,0,0,12"/>

                                    <TextBlock Text="Reason" Style="{StaticResource InventoryModalLabel}"/>
                                    <TextBox Text="{Binding BatchStatusReason}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MinHeight="120"
                                             Padding="9,6"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Visibility="{Binding IsHistoryEditor, Converter={StaticResource GlobalBoolToVisibility}}">
                                <TextBlock Text="{Binding DetailTitle}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#0F172A"
                                           Margin="0,0,0,12"/>

                                <TextBlock Text="Recent stock movements"
                                           FontWeight="SemiBold"
                                           Foreground="#334155"
                                           Margin="0,0,0,6"/>
                                <DataGrid ItemsSource="{Binding Movements}"
                                          Style="{StaticResource InventoryHistoryTable}"
                                          Height="205">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Type" Binding="{Binding MovementType}"
                                                            ElementStyle="{StaticResource InventoryTextColumnText}" Width="110"/>
                                        <DataGridTextColumn Header="Δ Qty" Binding="{Binding QuantityDelta, StringFormat={}{0:0.####}}"
                                                            ElementStyle="{StaticResource InventoryTextColumnText}" Width="85"/>
                                        <DataGridTextColumn Header="Balance" Binding="{Binding BalanceAfter, StringFormat={}{0:0.####}}"
                                                            ElementStyle="{StaticResource InventoryTextColumnText}" Width="90"/>
                                        <DataGridTextColumn Header="When" Binding="{Binding OccurredAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                                            ElementStyle="{StaticResource InventoryTextColumnText}" Width="145"/>
                                        <DataGridTextColumn Header="Reason" Binding="{Binding Reason}"
                                                            ElementStyle="{StaticResource InventoryTextColumnText}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Text="Batch status history"
                                           FontWeight="SemiBold"
                                           Foreground="#334155"
                                           Margin="0,16,0,6"/>
                                <DataGrid ItemsSource="{Binding StatusEvents}"
                                          Style="{StaticResource InventoryHistoryTable}"
                                          Height="165">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="From" Binding="{Binding FromStatus}"
                                                            ElementStyle="{StaticResource InventoryTextColumnText}" Width="95"/>
                                        <DataGridTextColumn Header="To" Binding="{Binding ToStatus}"
                                                            ElementStyle="{StaticResource InventoryTextColumnText}" Width="95"/>
                                        <DataGridTextColumn Header="When" Binding="{Binding ChangedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                                            ElementStyle="{StaticResource InventoryTextColumnText}" Width="145"/>
                                        <DataGridTextColumn Header="Reason" Binding="{Binding Reason}"
                                                            ElementStyle="{StaticResource InventoryTextColumnText}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <Border Grid.Row="3"
                            BorderBrush="#E2E8F0"
                            BorderThickness="0,1,0,0"
                            Background="#F8FAFC"
                            Padding="18,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding StatusMessage}"
                                       Foreground="#64748B"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Cancel"
                                        Command="{Binding CloseEditorCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Foreground="#334155"
                                        Height="36"
                                        Padding="13,6"
                                        Margin="0,0,8,0"/>

                                <Button Content="Post opening stock"
                                        Command="{Binding CreateOpeningStockCommand}"
                                        Foreground="White"
                                        Height="36"
                                        Padding="14,6">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOpeningEditor}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Content="Post adjustment"
                                        Command="{Binding AdjustCommand}"
                                        Foreground="White"
                                        Height="36"
                                        Padding="14,6">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAdjustmentEditor}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Content="Change batch status"
                                        Command="{Binding ChangeStatusCommand}"
                                        Foreground="White"
                                        Height="36"
                                        Padding="14,6">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStatusEditor}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>