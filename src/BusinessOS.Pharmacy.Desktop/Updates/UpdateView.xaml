<UserControl x:Class="BusinessOS.Pharmacy.Desktop.Updates.UpdateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="UpdatePanel" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FCFFFFFF" Offset="0" />
                        <GradientStop Color="#F5FFFFFF" Offset=".58" />
                        <GradientStop Color="#EAF8FAFC" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#D9FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.10" RenderingBias="Performance" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UpdateMetricCard" TargetType="Border">
            <Setter Property="Background" Value="#FAFCFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Padding" Value="14,12" />
        </Style>

        <Style x:Key="UpdateConflictCard" TargetType="Border">
            <Setter Property="Background" Value="#FBFCFE" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource PageBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="APPLICATION DELIVERY" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrandPrimaryBrush}" />
                        <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#ECFDF5" BorderBrush="#D1FAE5" BorderThickness="1" CornerRadius="11" Padding="11,7" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="8" Height="8" CornerRadius="4" Background="#059669" VerticalAlignment="Center" />
                            <TextBlock Text="Signed release channel" Foreground="#047857" FontSize="10.3" FontWeight="Bold" Margin="7,0,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="0.75*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource UpdatePanel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Release status" Foreground="#0F172A" FontSize="14" FontWeight="Bold" />
                                    <TextBlock Text="Compare the installed build with the latest verified release." Foreground="#64748B" FontSize="10.6" Margin="0,3,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="#EAF3FF" CornerRadius="9" Padding="9,4" VerticalAlignment="Center">
                                    <TextBlock Text="Version aware" Foreground="#0B5FC6" FontSize="9.4" FontWeight="Bold" />
                                </Border>
                            </Grid>

                            <UniformGrid Grid.Row="1" Columns="2" Margin="0,14,0,0">
                                <Border Style="{StaticResource UpdateMetricCard}" Margin="0,0,7,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Installed version" Foreground="#64748B" FontSize="10.5" />
                                            <TextBlock Text="{Binding CurrentVersion}" Foreground="#0F172A" FontSize="22" FontWeight="Bold" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="9" Padding="8,4" VerticalAlignment="Center">
                                            <TextBlock Text="LOCAL" Foreground="#475569" FontSize="9" FontWeight="Bold" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource UpdateMetricCard}" Margin="7,0,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Available version" Foreground="#64748B" FontSize="10.5" />
                                            <TextBlock Text="{Binding AvailableVersion}" Foreground="#0B5FC6" FontSize="22" FontWeight="Bold" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#DCEEFF" CornerRadius="9" Padding="8,4" VerticalAlignment="Center">
                                            <TextBlock Text="CLOUD" Foreground="#0B5FC6" FontSize="9" FontWeight="Bold" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </UniformGrid>

                            <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Compatibility" Foreground="#475569" FontSize="10.5" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding CompatibilityText}" Foreground="#334155" FontSize="11.2" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding StatusMessage}" Foreground="#64748B" FontSize="10.7" TextWrapping="Wrap" Margin="0,7,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource UpdatePanel}">
                        <StackPanel>
                            <TextBlock Text="Update actions" Foreground="#0F172A" FontSize="14" FontWeight="Bold" />
                            <TextBlock Text="Each stage validates release metadata before the next action becomes available." Foreground="#64748B" FontSize="10.6" TextWrapping="Wrap" Margin="0,3,0,14" />

                            <Button Content="{Binding CheckLabel}" Command="{Binding CheckCommand}" Style="{StaticResource PrimaryButton}" Height="40" Padding="15,8" HorizontalAlignment="Stretch" Margin="0,0,0,8" />
                            <Button Content="{Binding DownloadLabel}" Command="{Binding DownloadCommand}" Style="{StaticResource SecondaryButton}" Height="40" Padding="15,8" HorizontalAlignment="Stretch" Margin="0,0,0,8" />
                            <Button Content="{Binding InstallLabel}" Command="{Binding InstallCommand}" Style="{StaticResource SecondaryButton}" Height="40" Padding="15,8" HorizontalAlignment="Stretch" />

                            <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,14,0,0">
                                <TextBlock Text="Installation creates a safety backup where applicable and only applies a verified package." Foreground="#92400E" FontSize="10.3" TextWrapping="Wrap" />
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                                <ProgressBar Width="78" Height="5" IsIndeterminate="True" Foreground="{DynamicResource BrandPrimaryBrush}" Background="#E2E8F0" VerticalAlignment="Center" />
                                <TextBlock Text="Working…" Foreground="#64748B" FontSize="10.5" FontWeight="SemiBold" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Style="{StaticResource UpdatePanel}" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="0.8*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Release notes" Foreground="#0F172A" FontSize="14" FontWeight="Bold" />
                            <TextBlock Text="What changes in the available Darmaltoon release." Foreground="#64748B" FontSize="10.6" Margin="0,3,0,10" />
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="11" Padding="12" MinHeight="95">
                                <TextBlock Text="{Binding ReleaseNotes}" Foreground="#334155" FontSize="11" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>

                        <Border Grid.Column="2" Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1" CornerRadius="12" Padding="13">
                            <StackPanel>
                                <TextBlock Text="Verification chain" Foreground="#1D4ED8" FontSize="11.5" FontWeight="Bold" />
                                <TextBlock Text="1. Signed manifest" Foreground="#475569" FontSize="10.5" Margin="0,8,0,0" />
                                <TextBlock Text="2. Package checksum" Foreground="#475569" FontSize="10.5" Margin="0,4,0,0" />
                                <TextBlock Text="3. Deployment compatibility" Foreground="#475569" FontSize="10.5" Margin="0,4,0,0" />
                                <TextBlock Text="4. Safe apply plan" Foreground="#475569" FontSize="10.5" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="3" Style="{StaticResource UpdatePanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding ConflictsTitle}" Foreground="#0F172A" FontSize="14" FontWeight="Bold" />
                                <TextBlock Text="{Binding ConflictSummary}" Foreground="#64748B" FontSize="10.7" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#FEF3C7" CornerRadius="9" Padding="9,4" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Conflicts.Count, StringFormat={}{0} conflicts}" Foreground="#92400E" FontSize="9.5" FontWeight="Bold" />
                                </Border>
                                <Button Content="{Binding RefreshConflictsLabel}" Command="{Binding RefreshConflictsCommand}" Style="{StaticResource SecondaryButton}" Height="34" Padding="11,5" />
                            </StackPanel>
                        </Grid>

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Conflicts}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource UpdateConflictCard}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="34" Height="34" CornerRadius="10" Background="#FEF3C7" VerticalAlignment="Top">
                                                <TextBlock Text="!" Foreground="#92400E" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{Binding EventType}" Foreground="#0F172A" FontSize="11.5" FontWeight="Bold" />
                                                <TextBlock Text="{Binding Reference}" Foreground="#64748B" FontSize="10.2" Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding ErrorMessage}" Foreground="#334155" FontSize="10.7" TextWrapping="Wrap" Margin="0,5,0,0" />
                                                <TextBlock Foreground="#94A3B8" FontSize="9.8" Margin="0,4,0,0">
                                                    <Run Text="{Binding ErrorCode, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding RaisedText, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <Button Content="{Binding DataContext.RetryLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Command="{Binding DataContext.RetryConflictCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding IdempotencyKey}"
                                                        Style="{StaticResource SecondaryButton}" Height="32" Padding="10,5" Margin="0,0,6,0" />
                                                <Button Content="{Binding DataContext.DismissLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Command="{Binding DataContext.DismissConflictCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding IdempotencyKey}"
                                                        Style="{StaticResource GhostButton}" Foreground="#B91C1C" Height="32" Padding="10,5" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Grid.Row="2" Margin="0,10,0,0">
                            <TextBlock Text="{Binding ConflictsEmptyText}" Foreground="#64748B" FontSize="10.8" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasConflicts}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding ConflictsHelpText}" Foreground="#94A3B8" FontSize="10.2" TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>