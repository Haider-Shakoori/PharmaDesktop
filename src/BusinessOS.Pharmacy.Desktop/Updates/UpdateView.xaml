<UserControl x:Class="BusinessOS.Pharmacy.Desktop.Updates.UpdateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
            </StackPanel>

            <Border Grid.Row="1" Margin="0,18,0,0"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Installed version" Style="{StaticResource MutedText}"/>
                        <TextBlock Text="{Binding CurrentVersion}" FontSize="20" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Available version" Style="{StaticResource MutedText}"/>
                        <TextBlock Text="{Binding AvailableVersion}" FontSize="20" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Margin="0,18,0,0">
                <TextBlock Text="{Binding CompatibilityText}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                <TextBlock Text="{Binding ReleaseNotes}" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,20,0,0">
                <Button Content="{Binding CheckLabel}" Command="{Binding CheckCommand}" Padding="14,8" Margin="0,0,8,0"/>
                <Button Content="{Binding DownloadLabel}" Command="{Binding DownloadCommand}" Padding="14,8" Margin="0,0,8,0"/>
                <Button Content="{Binding InstallLabel}" Command="{Binding InstallCommand}" Padding="14,8"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
